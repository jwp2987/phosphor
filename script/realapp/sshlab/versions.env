# sshlab pins. EVERY value must be a real pin before `labctl.py build` runs; the word PLACEHOLDER in any value makes the build refuse.
# Look the values up once (owner/coordinator, with network) and commit them; never use a floating tag.
# Image: `podman pull docker.io/library/debian:trixie-slim && podman image inspect --format '{{.Digest}}' ...` -> the manifest-list digest.
DEBIAN_IMAGE=docker.io/library/debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
# snapshot.debian.org timestamp that every apt install resolves against (reproducible package set). Verified: Release returns 200.
DEBIAN_SNAPSHOT=20261020T000000Z
# nushell: the release tarball (x86_64-unknown-linux-musl) and its sha256 from the release's SHA256SUMS.
NU_VERSION=0.116.1
NU_URL=https://github.com/nushell/nushell/releases/download/0.116.1/nu-0.116.1-x86_64-unknown-linux-musl.tar.gz
NU_SHA256=13ef75df08df30f8d7b031df538e82a52c6e74ce839b1a9091c3a3f1969c3742
# PowerShell: the linux-x64 tar.gz from the GitHub release and its sha256.
PWSH_VERSION=7.6.8
PWSH_URL=https://github.com/PowerShell/PowerShell/releases/download/v7.6.8/powershell-7.6.8-linux-x64.tar.gz
PWSH_SHA256=59112e38ad83350e4f6dc0195953c66b5926792f300ca2e7691b8242e7a16e7f
