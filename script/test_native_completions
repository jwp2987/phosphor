#!/usr/bin/env python3
"""Drive the self-identifying in-band native-completions exchange in the REAL bash and zsh
bootstraps, in a pty (#1801).

WHY THIS EXISTS
---------------
A Phosphorized remote session without the remote helper asks the remote shell itself for its
completions on Tab (`app/src/terminal/input/native_completions.rs`). The exchange shares the tty
with every other write, and the shell and the app each have their own clock, so it is
self-identifying (design in `app/src/terminal/writeable_pty/pty_controller.rs`, "The in-band
native-completions exchange"):

  app ^Y -> shell OSC 9280;P;<token> -> app ONE frame, RS <token> : <%HH text> US
  (RS = 0x1e, US = 0x1f), or the cancel frame RS - : US -> shell OSC 9280;A, one
  OSC 9280;C;<candidate> each, OSC 9280;B.

The hook consumes nothing outside a frame (the first byte must be RS, every later byte must be in
the frame alphabet up to US; any other byte goes back to the line editor). A frame for another
token, or the cancel, ends the exchange with nothing. At the prompt, RS is bound to a widget that
drops the rest of a frame by the same rules, and US to a no-op. The app sends ^Y only to a shell
whose Bootstrapped hook advertised `!phosphor_nc_frames_v1` in its shell options.

This runs the REAL assembled bootstraps (the way `app/src/terminal/bootstrap.rs` builds them, as
`test_bash_bootstrap_nounset` and `test_zsh_bootstrap_strict_options` do), so their own bind lines
are what is exercised. Needs only python3 and the shells (no cargo); a missing shell is SKIPPED.
fish (#2196) has its own, smaller set of checks (`run_fish`): its hook reads the frame with one
external `sh` (fish's own `read` runs the line editor), so the cases that depend on a hook reading
raw bytes one by one (a frame cut in pieces, ESC classification) are bash and zsh only; every
case that matters to the app (candidates, descriptions, the cancel and the stale frame, a command
behind the frame, the give-up, a late frame, no hooks sent) runs on fish too.

WHAT IT CHECKS, per shell (PHOSPHOR_NC_DEADLINE=5 keeps the hook's own deadline short)
  * the Bootstrapped hook advertises the protocol;
  * candidates: `cd pro` offers `projects/` and `proto/`; `cat dir/fi` the WHOLE token
    `dir/file1`; `echo a;ec` keeps the `a;` lead (bash: its own `complete -F`/`-W` specs, with
    COMP_WORDS/COMP_CWORD as bash sets them and the `--opt=` part of a token kept);
  * a command behind the frame (same write, and 5 ms later) runs;
  * the first byte after ^Y is not a frame: the app's real command bytes (^P + bracketed paste
    + Enter), and a bracketed paste alone (ESC first): the command runs whole;
  * the cancel frame and a frame for another token: no candidates, the next command runs;
  * a frame landing after the hook gave up is dropped at the prompt and nothing of it runs;
  * a frame's start alone at the prompt, then the app's command bytes: the command runs whole
    (the discard widget stops at the first byte outside the frame alphabet);
  * a frame cut short, with its tail (and US) arriving after the read deadline, followed by the
    app's real command bytes: the command runs whole (the tail is never run);
  * NO inter-byte timing (the frame is judged by content): a frame split into pieces with a 0.5 s
    and a 3 s pause between them is consumed whole and answered, leaving no junk in the line;
    a bare RS then `ls` + Enter, and RS + letters + Ctrl-C, hand back by content; a stale-token
    frame is consumed silently;
  * ^Y + cancel + command in one batch, before the hook starts: the command runs;
  * a DA-reply-shaped sequence after ^Y is dropped whole: a raw command after it runs clean;
  * a bare RS (Ctrl-6) then a word and Enter at the prompt: the word runs (the discard widget
    hands everything back, the Enter included);
  * a SIGWINCH during the hook: the command after it runs;
  * US (^_) is still the line editor's undo;
  * vi mode (bash `set -o vi`, zsh `bindkey -v`): the exchange still answers;
  * zsh without zsh/datetime (no $EPOCHREALTIME): the cancel, the late frame and the cut-short
    frame still behave.

BASH BELOW 4.0 (#1969)
  bash 3.2 (macOS /bin/bash, the usual remote shell on a Mac) has no READLINE_LINE, so its hook
  cannot edit the line: bytes that are not a frame are handed back as KEYS through a readline
  macro (`__warp_nc_finish`, replay mode). Every check above runs there too, plus: an arrow key
  after RS goes back whole (the macro can carry an escape), a multi-line bracketed
  paste read by the hook is inserted, not run line by line, and text with a quote and a
  backslash goes back unchanged. Readline before 7.0 (bash < 4.4) has no bracketed paste, so the
  app's command bytes are written there as the app writes them without it: ^P, the text, Enter.

USAGE
    script/test_native_completions [--bash PATH] [--bash-image IMAGE ...] [--only-bash]
  --bash PATH        the bash to run (default: the first `bash` on PATH). On macOS,
                     `--bash /bin/bash` runs the system 3.2.
  --bash-image IMAGE run bash from a container image as well (docker or podman; the official
                     `bash:3.2` ... `bash:5.x` images), e.g. on a Linux machine with no bash 3.2:
                     `--bash-image bash:3.2 --bash-image bash:4.0`. Repeatable. A missing
                     runtime or image is SKIPPED, never pulled.
  --only-bash        skip zsh (with the options above, to check one bash quickly).
  PHOSPHOR_NC_BASH_IMAGES="bash:3.2 bash:4.0" names the images when no --bash-image is given (for
  script/precheck, which runs this with no arguments). On macOS the system /bin/bash (3.2) is
  run as well when the bash on PATH is another one.
Temporary files go under $TMPDIR. Exit 0 when every check passes (or a shell is SKIPPED), 1
otherwise.
"""

import json
import os
import pty
import re
import select
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
ASSETS = os.path.join(ROOT, "app", "assets")
BOOTSTRAP = os.path.join(ASSETS, "bundled", "bootstrap")
HOOK_RE = re.compile(rb"\x1bP\$d([0-9a-f]*)\x9c")
CANDIDATE_RE = re.compile(rb"\x1b\]9280;C;([^\x07]*)\x07")
PROMPT_RE = re.compile(rb"\x1b\]9280;P;([0-9A-Za-z]+)\x07")  # the token is <digits>x<digits>x<digits>
RS, US = b"\x1e", b"\x1f"
ADVERTISED = "!phosphor_nc_frames_v1"
failures = []
skipped = []
counter = [40]


def assemble(text):
    """Mirror bootstrap.rs: inline #include, trim, drop blank and comment lines."""
    out = []
    for line in text.split("\n"):
        if line.startswith("#include "):
            with open(os.path.join(ASSETS, line[len("#include "):])) as f:
                inc = f.read().replace("@@USING_CON_PTY_BOOLEAN@@", "false")
            out.extend(assemble(inc).split("\n"))
            continue
        stripped = line.lstrip()
        if len(stripped) < len(line):
            line = " " + stripped
        line = line.rstrip()
        if not line.strip() or line.strip().startswith("#"):
            continue
        out.append(line)
    return "\n".join(out)


def frame(token, text):
    return RS + token + b":" + "".join("%%%02X" % b for b in text.encode()).encode() + US


CANCEL = RS + b"-:" + US


# Whether the shell under test has bracketed paste (readline 7.0+, bash 4.4+; zsh). The app writes a
# command as a bracketed paste only to a shell that turned the mode on.
BRACKETED = [True]


def app_command(text):
    """The bytes the app writes for a command: its line-clear key, the text (a bracketed paste
    where the shell has it), Enter."""
    if not BRACKETED[0]:
        return b"\x10" + text.encode() + b"\r"
    return b"\x10\x1b[200~" + text.encode() + b"\x1b[201~\r"


class Pty:
    def __init__(self, argv, env, cwd, on_close=None):
        self.buf = b""
        self.on_close = on_close
        self.pid, self.fd = pty.fork()
        if self.pid == 0:
            os.chdir(cwd)
            os.execve(argv[0], argv, env)

    def read_until(self, pattern, timeout=10):
        got = b""
        end = time.time() + timeout
        while time.time() < end:
            ready, _, _ = select.select([self.fd], [], [], 0.05)
            if ready:
                try:
                    data = os.read(self.fd, 65536)
                except OSError:
                    break
                got += data
                self.buf += data
                if re.search(pattern, got):
                    return got
        return got

    def drain(self, seconds):
        return self.read_until(rb"(?!x)x", seconds)

    def write(self, data):
        os.write(self.fd, data)

    def hooks(self, name):
        out = []
        for m in HOOK_RE.finditer(self.buf):
            try:
                j = json.loads(bytes.fromhex(m.group(1).decode()))
            except ValueError:
                continue
            if j.get("hook") == name:
                out.append(j.get("value") or {})
        return out

    def close(self):
        if self.on_close:
            self.on_close()
        try:
            os.kill(self.pid, signal.SIGKILL)
            os.waitpid(self.pid, 0)
        except OSError:
            pass


def check(shell, name, ok, detail=""):
    if not ok:
        failures.append(f"{shell}: {name} {detail}")
        print(f"FAIL {shell}: {name} {detail}")
    else:
        print(f"ok   {shell}: {name}")


def ask(sh, shell, what):
    """^Y, then the hook's prompt; returns its token or None."""
    sh.write(b"\x19")
    got = sh.read_until(PROMPT_RE)
    m = PROMPT_RE.search(got)
    if not m:
        check(shell, f"answers ^Y with a named prompt ({what})", False, f"(got {got[-200:]!r})")
        return None
    return m.group(1)


def complete(sh, shell, line, after=b"", gap=None):
    token = ask(sh, shell, repr(line))
    if token is None:
        return None
    if after and gap is None:
        sh.write(frame(token, line) + after)
    else:
        sh.write(frame(token, line))
        if after:
            time.sleep(gap)
            sh.write(after)
    got = sh.read_until(rb"\x1b\]9280;B\x07")
    if b"\x1b]9280;B\x07" not in got or b"\x1b]9280;A;incrementally_typed\x07" not in got:
        check(shell, f"ends the reply for {line!r}", False, f"(got {got[-200:]!r})")
        return None
    return [c.decode("utf-8", "replace") for c in CANDIDATE_RE.findall(got)]


def command():
    """A command whose OUTPUT (not its echo) proves it ran: (text, output to expect)."""
    counter[0] += 1
    n = counter[0]
    return ("echo ran-$((%d+1))" % (n - 1), b"ran-%d" % n)


def expect_runs(sh, shell, what, want, timeout=10):
    out = sh.read_until(re.escape(want) + rb"|not found", timeout)
    if want in out and b"not found" not in out:
        out += sh.read_until(rb"not found", 0.3)
    check(shell, what, want in out and b"not found" not in out, f"(got {out[-240:]!r})")


def make_lab(base):
    lab = os.path.join(base, "lab")
    for d in ("projects", "proto", "dir", "other"):
        os.makedirs(os.path.join(lab, d))
    os.makedirs(os.path.join(lab, "sp ace"))
    for f in ("dir/file1", "dir/fig", "sp ace/a b"):
        open(os.path.join(lab, f), "w").close()
    return lab


def protocol_checks(sh, shell, full=True):
    if full:
        got = complete(sh, shell, "cd pro")
        if got is not None:
            check(shell, "cd pro offers projects/ and proto/", {"projects/", "proto/"} <= set(got), f"(got {got})")
            check(shell, "cd pro offers no file", "other/" not in got, f"(got {got})")
        got = complete(sh, shell, "cat dir/fi")
        if got is not None:
            check(shell, "cat dir/fi offers the whole token dir/file1", "dir/file1" in got, f"(got {got})")
        got = complete(sh, shell, "echo a;ec")
        if got is not None:
            check(shell, "echo a;ec keeps the token's a; lead",
                  bool(got) and all(c.startswith("a;") for c in got) and "a;echo" in got, f"(got {got[:10]})")

        for gap, label in ((None, "same write"), (0.005, "5 ms later")):
            text, want = command()
            got = complete(sh, shell, "cd pro", after=app_command(text), gap=gap)
            check(shell, f"answers with a command behind the frame ({label})", got is not None and "projects/" in got, f"(got {got})")
            expect_runs(sh, shell, f"a command behind the frame ({label}) runs", want)

        text, want = command()
        sh.write(b"\x19" + app_command(text))
        expect_runs(sh, shell, "the app's command bytes (^P first) right after ^Y run whole", want)

        text, want = command()
        sh.write(b"\x19" + b"\x1b[200~" + text.encode() + b"\x1b[201~\r")
        expect_runs(sh, shell, "a bracketed paste (ESC first) right after ^Y runs whole", want)

    # ^Y, the cancel frame and a command in ONE batch, before the hook has even started.
    text, want = command()
    sh.write(b"\x19" + CANCEL + app_command(text))
    out = sh.read_until(re.escape(want))
    check(shell, "^Y + cancel + command in one batch: no candidates, the command runs", want in out and CANDIDATE_RE.search(out) is None, f"(got {out[-200:]!r})")

    # A terminal reply (a DA report) where the frame was expected: dropped whole, the line stays
    # clean (the next command is typed raw, without the app's ^P).
    if ask(sh, shell, "DA reply") is not None:
        text, want = command()
        sh.write(b"\x1b[?62;22c")
        time.sleep(0.3)
        sh.write(text.encode() + b"\r")
        expect_runs(sh, shell, "a DA reply after ^Y leaves the line clean; the raw command after it runs", want)

    # A bare RS typed at the prompt (Ctrl-6), then a word and Enter: the discard widget hands it
    # all back, the Enter included, so the command runs.
    sh.write(app_command("ranls() { echo ran-$((40+2))ls; }"))
    sh.drain(0.5)
    sh.write(b"\x1e" + b"ranls\r")
    expect_runs(sh, shell, "a bare RS then `ranls` + Enter runs ranls (nothing eaten, the Enter kept)", b"ran-42ls")

    # A resize (SIGWINCH) while the hook waits: a lost answer is fine, a lost key is not.
    if ask(sh, shell, "resize") is not None:
        os.kill(sh.pid, signal.SIGWINCH)
        time.sleep(0.2)
        text, want = command()
        sh.write(CANCEL + app_command(text))
        expect_runs(sh, shell, "a SIGWINCH during the hook loses no key: the command after it runs", want)

    if ask(sh, shell, "cancel") is not None:
        text, want = command()
        sh.write(CANCEL + app_command(text))
        out = sh.read_until(re.escape(want))
        check(shell, "the cancel frame ends the exchange with no candidates", CANDIDATE_RE.search(out) is None, f"(got {out[-200:]!r})")
        check(shell, "the command after the cancel frame runs", want in out, f"(got {out[-200:]!r})")

    if full:
        token = ask(sh, shell, "stale token")
        if token is not None:
            text, want = command()
            sh.write(frame(b"999" + token, "cd pro") + app_command(text))
            out = sh.read_until(re.escape(want))
            check(shell, "a frame with another token is ignored (no candidates)", CANDIDATE_RE.search(out) is None, f"(got {out[-200:]!r})")
            check(shell, "the command after a stale frame runs", want in out, f"(got {out[-200:]!r})")

    token = ask(sh, shell, "late frame")
    if token is not None:
        sh.drain(5.6)
        text, want = command()
        sh.write(frame(token, "cd pro") + app_command(text))
        expect_runs(sh, shell, "a frame landing at the prompt is dropped; the command behind it runs", want)

    # A frame's start alone at the prompt (its rest lost), then the app's real command bytes: the
    # discard widget stops at the first byte outside the frame alphabet and hands it back.
    token = ask(sh, shell, "frame start alone")
    if token is not None:
        sh.drain(5.6)
        text, want = command()
        sh.write(RS + token + b":%63" + app_command(text))
        expect_runs(sh, shell, "a frame's start alone at the prompt stops at the next real key; the command runs whole", want)

    # No inter-byte timing: pauses of 0.5 s and 3 s inside one frame change nothing.
    token = ask(sh, shell, "slow frame")
    if token is not None:
        data = frame(token, "cd pro")
        a, b, c = len(token) // 2 + 1, len(token) + 3, len(data)
        sh.write(data[:a])
        time.sleep(0.5)
        sh.write(data[a:b])
        time.sleep(3)
        sh.write(data[b:c])
        got = sh.read_until(rb"\x1b\]9280;B\x07")
        cands = [x.decode() for x in CANDIDATE_RE.findall(got)]
        check(shell, "a frame split with 0.5 s and 3 s pauses is consumed whole and answered", "projects/" in cands, f"(got {got[-200:]!r})")
        text, want = command()
        sh.write(text.encode() + b"\r")
        expect_runs(sh, shell, "a slow frame leaves no junk in the line: the raw command after it runs", want)

    # RS + letters + Ctrl-C: the first letter is not frame alphabet, so it all goes back by content.
    sh.write(b"\x1e" + b"ab" + b"\x03")
    sh.drain(0.5)
    text, want = command()
    sh.write(text.encode() + b"\r")
    expect_runs(sh, shell, "RS + letters + Ctrl-C hands back by content: the next raw command runs", want)

    # ESC after RS is classified by content (the NEXT byte decides): terminal replies of every kind
    # are dropped whole, keys and a lone ESC + Enter are handed back, nothing is eaten or hung.
    for what, data in (
        ("a DA reply", b"\x1b[?62;22c"),
        ("an OSC reply", b"\x1b]11;rgb:0000/0000/0000\x07"),
        ("a DCS XTVERSION reply", b"\x1bP>|phosphor 1\x1b\\"),
    ):
        sh.write(RS + data)
        sh.drain(0.3)
        text, want = command()
        sh.write(text.encode() + b"\r")
        expect_runs(sh, shell, f"RS + {what} is dropped whole: the raw command after it runs clean", want)
    # Handed back intact, so zsh acts on them as typed (Alt-x opens its minibuffer, ESC + Enter is
    # a key too); a Ctrl-C then resets the editor and a raw command proves nothing hung or was eaten.
    for what, data in (
        ("ESC [ A (an arrow)", b"\x1b[A"),
        ("ESC + a letter (Alt-x)", b"\x1bx"),
        ("a lone ESC then Enter", b"\x1b\r"),
    ):
        sh.write(RS + data)
        sh.drain(0.4)
        sh.write(b"\x03")
        sh.drain(0.4)
        text, want = command()
        sh.write(text.encode() + b"\r")
        expect_runs(sh, shell, f"RS + {what} is handed back: nothing hangs, the next command runs", want)

    token = ask(sh, shell, "cut-short frame")
    if token is not None:
        sh.write(RS + token + b":%63%64")
        sh.drain(5.8)
        text, want = command()
        sh.write(b"%20%70" + US + app_command(text))
        expect_runs(sh, shell, "a frame's tail after the read deadline is never run; the real command after it runs whole", want)

    # US (^_) is not taken over: it is still the line editor's undo.
    text, want = command()
    undo = "bind -q undo" if shell.startswith("bash") else "bindkey '^_'"
    sh.write(app_command(f"{undo}; {text}"))
    out = sh.read_until(re.escape(want))
    check(shell, "US (^_) is still the line editor's undo", (b'\\C-_' in out or b'"^_" undo' in out) and want in out, f"(got {out[-240:]!r})")

    text, want = command()
    sh.write(app_command(text))
    expect_runs(sh, shell, "the shell runs a command at the end", want)


def container_runtime():
    return shutil.which("docker") or shutil.which("podman")


def bash_version(bash=None, image=None):
    """(major, minor) of the bash under test, or None when it cannot be run."""
    probe = "echo ${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}"
    argv = [container_runtime(), "run", "--rm", image, "bash", "-c", probe] if image else [bash, "-c", probe]
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL).stdout.strip()
        major, minor = out.split(".")
        return int(major), int(minor)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def start_bash(base, lab, bash=None, image=None):
    bash = bash or shutil.which("bash")
    with open(os.path.join(BOOTSTRAP, "bash_init_shell.sh")) as f:
        init = f.read().replace("@@WARP_SESSION_ID@@", "4242").replace("@@USING_CON_PTY_BOOLEAN@@", "false")
    with open(os.path.join(BOOTSTRAP, "bash.sh")) as f:
        body = assemble(f.read())
    rc = os.path.join(base, ".phosphor-rc")
    with open(rc, "w") as f:
        f.write(init + "\n" + body + "\n")
    env = {
        "HOME": base, "USER": os.environ.get("USER", "user"), "PATH": "/usr/local/bin:/usr/bin:/bin",
        "TERM": "xterm-256color", "LANG": "C.UTF-8", "WARP_IS_LOCAL_SHELL_SESSION": "1",
        "INPUTRC": "/dev/null", "PHOSPHOR_NC_DEADLINE": "5",
    }
    if image:
        # The image's own bash, in a pty the container runtime relays. The temporary tree is
        # mounted at the same path (the rc file and the lab), and the shell runs as this user so
        # nothing root-owned is left in it.
        runtime = container_runtime()
        name = "phx-nc-%d-%d" % (os.getpid(), int(time.time() * 1000) % 1000000)
        root = os.path.dirname(lab)
        argv = [runtime, "run", "--rm", "-i", "-t", "--name", name, "--network", "none", "--user", "%d:%d" % (os.getuid(), os.getgid()),
                "-v", "%s:%s" % (root, root), "-w", lab]
        for k, v in env.items():
            if k != "PATH":
                argv += ["-e", "%s=%s" % (k, v)]
        argv += [image, "bash", "--noprofile", "--rcfile", rc, "-i"]
        kill = lambda: subprocess.run([runtime, "kill", name], capture_output=True, timeout=30, stdin=subprocess.DEVNULL)  # noqa: E731
        return Pty(argv, dict(os.environ), lab, on_close=kill)
    return Pty([bash, "--noprofile", "--rcfile", rc, "-i"], env, lab)


def start_zsh(base, lab, compinit=True):
    zsh = shutil.which("zsh")
    zd = os.path.join(base, "zdot")
    os.makedirs(zd, exist_ok=True)
    # The user's own completion system, as a zsh user has it (the bootstrap does not run compinit).
    zshrc = f"autoload -Uz compinit && compinit -u -d {shlex.quote(os.path.join(zd, '.zcompdump'))}" if compinit else ""
    with open(os.path.join(zd, ".zshrc"), "w") as f:
        f.write(zshrc + "\n")
    with open(os.path.join(zd, ".zshenv"), "w") as f:
        f.write("\n")
    with open(os.path.join(BOOTSTRAP, "zsh_body.sh")) as f:
        body = assemble(f.read()).replace("@@USING_CON_PTY_BOOLEAN@@", "false") + "\n"
    body_path = os.path.join(base, "body.sh")
    with open(body_path, "w") as f:
        f.write(body)
    env = {
        "HOME": base, "ZDOTDIR": zd, "USER": os.environ.get("USER", "user"), "PATH": "/usr/local/bin:/usr/bin:/bin",
        "TERM": "xterm-256color", "LANG": "C.UTF-8", "WARP_IS_LOCAL_SHELL_SESSION": "1", "PS1": "%# ",
        "PHOSPHOR_NC_DEADLINE": "5",
    }
    sh = Pty([zsh, "-g", "--no-rcs", "-i"], env, lab)
    sh.drain(1.5)
    sh.write((f"unsetopt ZLE; WARP_SESSION_ID=4242; WARP_USING_WINDOWS_CON_PTY=false; source {shlex.quote(body_path)}; "
              "builtin echo boot$((20+22))done\r").encode())
    return sh


def wait_bootstrapped(sh, shell):
    end = time.time() + 30
    while time.time() < end and not (sh.hooks("Bootstrapped") and sh.hooks("Precmd")):
        sh.drain(0.2)
    boot = sh.hooks("Bootstrapped")
    if not boot:
        check(shell, "bootstraps", False, f"(tail {sh.buf[-300:]!r})")
        return False
    sh.drain(1.0)
    opts = boot[0].get("shell_options", "")
    check(shell, "the Bootstrapped hook advertises the framed protocol", ADVERTISED in opts.split(), f"(shell_options tail {opts[-120:]!r})")
    return True


def replay_checks(sh, shell):
    """Below bash 4.0: what only the replay macro can do, and what it must not get wrong."""
    # An arrow key after RS goes back whole: Up recalls the last command, Enter runs it again.
    sh.write(app_command("echo ran-$((90+9))up"))
    expect_runs(sh, shell, "(setup) the command to recall runs", b"ran-99up")
    sh.drain(0.5)
    sh.write(RS + b"\x1b[A")
    sh.drain(0.5)
    sh.write(b"\r")
    expect_runs(sh, shell, "RS + Up arrow is handed back as the key: Enter runs the recalled command", b"ran-99up")
    # Text with a quote, a backslash and a space after a bare RS: the first byte is not frame
    # alphabet, so the widget hands back only that byte and the rest is read by readline; a
    # frame-alphabet lead (digits) is read by the widget and goes back through the macro.
    sh.drain(0.3)
    sh.write(RS + b"12x" + b"\x10" + b"echo \"ran-$((40+3))\\\\q\" 'p q'\r")
    expect_runs(sh, shell, "RS + frame-alphabet text + ^P + a quoted command: the text is cleared, the command runs unchanged", b"ran-43\\q p q")
    # A multi-line bracketed paste read by the hook (where the frame was expected) is inserted
    # as one text, never run line by line: the line is then cleared and a marker command runs.
    if ask(sh, shell, "multi-line paste") is not None:
        sh.write(b"\x1b[200~echo ran-$((60+6))first\necho ran-$((60+7))second\x1b[201~")
        sh.drain(0.8)
        got = sh.drain(0.5)
        sh.write(b"\x03")
        sh.drain(0.5)
        text, want = command()
        sh.write(app_command(text))
        out = sh.read_until(re.escape(want))
        seen = sh.buf[-4000:]
        check(shell, "a multi-line paste read by the hook is inserted, not run line by line",
              b"ran-66first\r\n" not in seen and b"ran-67second\r\n" not in seen and want in out, f"(got {seen[-300:]!r} {got[-80:]!r})")


def run_bash(base, lab, bash=None, image=None):
    bash = bash or shutil.which("bash")
    label = "bash"
    if image:
        if not container_runtime():
            skipped.append(f"bash image {image} (no docker or podman)")
            return
        have = subprocess.run([container_runtime(), "image", "inspect", image], capture_output=True, stdin=subprocess.DEVNULL).returncode == 0
        if not have:
            skipped.append(f"bash image {image} (not present locally; it is never pulled here)")
            return
    elif not bash:
        skipped.append("bash: not installed")
        return
    ver = bash_version(bash, image)
    if ver is None:
        check(f"bash ({image or bash})", "reports its version", False)
        return
    label = "bash %d.%d%s" % (ver[0], ver[1], " (%s)" % image if image else "")
    if ver < (3, 2):
        print("NOTE %s: below 3.2; the bootstrap binds no ^Y there and the app sends none" % label)
        skipped.append("%s (below 3.2, by design)" % label)
        return
    BRACKETED[0] = ver >= (4, 4)
    print("NOTE %s: %s; command bytes %s bracketed paste" % (
        label, "hands bytes back through the replay macro (no READLINE_LINE)" if ver < (4, 0) else "hands bytes back through READLINE_LINE",
        "with" if BRACKETED[0] else "without"))
    sh = start_bash(base, lab, bash, image)
    try:
        if not wait_bootstrapped(sh, label):
            return
        protocol_checks(sh, label)
        if ver < (4, 0):
            replay_checks(sh, label)
        # The exchange is not a command: no Preexec, CommandFinished or Precmd hook may come of a
        # ^Y or an RS key (before bash 4.0 the DEBUG trap cannot see a readline binding by
        # READLINE_LINE, #1969), and the next real command still announces itself exactly once.
        sh.drain(0.5)
        before = {h: len(sh.hooks(h)) for h in ("Preexec", "CommandFinished", "Precmd")}
        got = complete(sh, label, "cd pro")
        sh.write(RS + b"-:" + US)
        sh.drain(1.0)
        after = {h: len(sh.hooks(h)) for h in before}
        check(label, "the exchange and a frame at the prompt send no Preexec / CommandFinished / Precmd hook",
              got is not None and after == before, f"(before {before}, after {after})")
        # #2002: the prompt-mode switch keys (ESC p, ESC w) are `bind -x` commands too.
        sh.write(b"\x1bw")
        sh.drain(1.0)
        after = {h: len(sh.hooks(h)) for h in before}
        check(label, "the prompt-mode switch key (ESC w) sends no Preexec / CommandFinished / Precmd hook (#2002)", after == before, f"(before {before}, after {after})")
        text, want = command()
        sh.write(app_command(text))
        expect_runs(sh, label, "(hooks) the command after the exchange runs", want)
        sh.drain(1.0)
        after = {h: len(sh.hooks(h)) for h in before}
        check(label, "the next real command sends exactly one Preexec, CommandFinished and Precmd",
              all(after[h] == before[h] + 1 for h in before), f"(before {before}, after {after})")
        for line in (
            "_phx() { COMPREPLY=($(compgen -W 'alpha beta' -- \"$2\")); }; complete -F _phx phx",
            "_phz() { COMPREPLY=(\"w${COMP_CWORD}-${COMP_WORDS[1]}\"); }; complete -F _phz phz",
            "_phq() { COMPREPLY=($(compgen -W 'red green' -- \"$2\")); }; complete -F _phq phq",
            "complete -W '--force --file' phy",
        ):
            text, want = command()
            sh.write(app_command(line + "; " + text))
            sh.read_until(re.escape(want))
        for line, want, name in (
            ("phx al", ["alpha"], "a complete -F function answers"),
            ("phz one tw", ["w2-one"], "COMP_WORDS and COMP_CWORD are set as bash sets them"),
            ("phq --color=re", ["--color=red"], "the token's --opt= part is kept"),
            ("phy --fo", ["--force"], "a complete -W spec answers"),
        ):
            got = complete(sh, label, line)
            if got is not None:
                check(label, name, got == want, f"(got {got})")
        # vi mode: the precmd re-binds the keys in vi-insert and vi-command.
        text, want = command()
        sh.write(app_command("set -o vi; " + text))
        sh.read_until(re.escape(want))
        sh.drain(0.5)
        got = complete(sh, label, "cd pro")
        check(label, "vi mode: the exchange still answers", got is not None and "projects/" in got, f"(got {got})")
    finally:
        sh.close()
        BRACKETED[0] = True


def run_zsh(base, lab):
    if not shutil.which("zsh"):
        skipped.append("zsh: not installed")
        return
    sh = start_zsh(base, lab)
    try:
        if not wait_bootstrapped(sh, "zsh"):
            return
        protocol_checks(sh, "zsh")
        text, want = command()
        sh.write(app_command("bindkey -v; " + text))
        sh.read_until(re.escape(want))
        sh.drain(0.5)
        got = complete(sh, "zsh", "cd pro")
        check("zsh", "vi mode: the exchange still answers", got is not None and "projects/" in got, f"(got {got})")
    finally:
        sh.close()

    # No zsh/datetime: the per-byte fallback.
    sub = os.path.join(base, "nodatetime")
    os.makedirs(sub)
    sh = start_zsh(sub, lab)
    try:
        if not wait_bootstrapped(sh, "zsh (no zsh/datetime)"):
            return
        text, want = command()
        sh.write(app_command("zmodload -u zsh/datetime; (( ${+EPOCHREALTIME} )) || " + text))
        out = sh.read_until(re.escape(want))
        check("zsh (no zsh/datetime)", "$EPOCHREALTIME is gone", want in out, f"(got {out[-200:]!r})")
        protocol_checks(sh, "zsh (no zsh/datetime)", full=False)
    finally:
        sh.close()


def run_zsh_no_compsys(base, lab):
    """#2174: zsh without compinit. Tab's exchange ends at once with an empty, well-formed answer
    (start and end marks, no candidate) and NOTHING is printed to the terminal."""
    if not shutil.which("zsh"):
        return
    sh = start_zsh(base, lab, compinit=False)
    try:
        if not wait_bootstrapped(sh, "zsh (no compinit)"):
            return
        sh.write(app_command("(( $+functions[_generic] )) && echo compsys-present-$((1+1))"))
        out = sh.read_until(rb"compsys-present-2", 1.0)
        check("zsh (no compinit)", "compsys really is not loaded", b"compsys-present-2" not in out.replace(b"$((1+1))", b""), f"(got {out[-200:]!r})")
        start = len(sh.buf)
        t0 = time.time()
        got = complete(sh, "zsh (no compinit)", "cd pro")
        took = time.time() - t0
        check("zsh (no compinit)", "empty answer, no candidates", got == [], f"(got {got})")
        check("zsh (no compinit)", "answers at once (well inside the 5 s deadline)", took < 2.0, f"(took {took:.2f}s)")
        sh.drain(0.5)
        seen = sh.buf[start:]
        check("zsh (no compinit)", "nothing printed to the terminal", b"not found" not in seen and b"_generic" not in seen, f"(got {seen[-200:]!r})")
        text, want = command()
        sh.write(app_command(text))
        expect_runs(sh, "zsh (no compinit)", "the next command runs, the line is clean", want)
    finally:
        sh.close()


DESCRIPTION_RE = re.compile(rb"\x1b\]9280;D\?description;([^\x07]*)\x07")


def start_fish(base, lab):
    """The REAL assembled fish bootstrap (fish_init_shell.sh + fish.sh, as test_fish_bootstrap) in an interactive fish in `lab`."""
    fish = shutil.which("fish")
    with open(os.path.join(BOOTSTRAP, "fish_init_shell.sh")) as f:
        init = assemble(f.read())
    with open(os.path.join(BOOTSTRAP, "fish.sh")) as f:
        body = assemble(f.read())
    script = os.path.join(base, "boot.fish")
    with open(script, "w") as f:
        f.write((init + "\n" + body + "\n").replace("@@WARP_SESSION_ID@@", "4242").replace("@@USING_CON_PTY_BOOLEAN@@", "false"))
    home = os.path.join(base, "home")
    os.makedirs(home, exist_ok=True)
    env = {
        "HOME": home, "XDG_CONFIG_HOME": os.path.join(base, "cfg"), "XDG_DATA_HOME": os.path.join(base, "data"),
        "USER": os.environ.get("USER", "user"), "PATH": os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin"),
        "TERM": "xterm-256color", "LANG": "C.UTF-8", "WARP_IS_LOCAL_SHELL_SESSION": "1", "PHOSPHOR_NC_DEADLINE": "5",
    }
    sh = Pty([fish, "--no-config", "-i"], env, lab)
    sh.drain(1.5)
    sh.write((f"source {shlex.quote(script)}; builtin echo boot(math 20+22)done\r").encode())
    return sh


def fish_command():
    """A fish command whose OUTPUT proves it ran: (text, output to expect)."""
    counter[0] += 1
    n = counter[0]
    return ("echo ran-(math %d+1)" % (n - 1), b"ran-%d" % n)


def run_fish(base, lab):
    """#2196: fish answers the in-band exchange with `complete -C`, so a Tab on a remote fish without the helper costs the exchange's own round trips
    instead of the completer's several."""
    if not shutil.which("fish"):
        skipped.append("fish: not installed")
        return
    shell = "fish"
    sh = start_fish(base, lab)
    try:
        if not wait_bootstrapped(sh, shell):
            return
        sh.drain(0.5)
        got = complete(sh, shell, "cd pro")
        if got is not None:
            check(shell, "cd pro offers projects/ and proto/", {"projects/", "proto/"} <= set(got), f"(got {got})")
            check(shell, "cd pro offers no file", "other/" not in got, f"(got {got})")
        got = complete(sh, shell, "cat dir/fi")
        if got is not None:
            check(shell, "cat dir/fi offers the whole token dir/file1", "dir/file1" in got and "dir/fig" in got, f"(got {got})")
        got = complete(sh, shell, "echo a;ec")
        if got is not None:
            check(shell, "echo a;ec keeps the token's a; lead", bool(got) and all(c.startswith("a;") for c in got) and "a;echo" in got, f"(got {got[:10]})")
        got = complete(sh, shell, "cat sp")
        if got is not None:
            check(shell, "a name with a space is offered escaped, as fish inserts it", got == ["sp\\ ace/"], f"(got {got})")
        token = ask(sh, shell, "descriptions")
        if token is not None:
            sh.write(frame(token, "ls --color=al"))
            out = sh.read_until(rb"\x1b\]9280;B\x07")
            check(shell, "an option comes with its description (OSC 9280;D?description)",
                  b"--color=always" in out and DESCRIPTION_RE.search(out) is not None and b"Use colors" in out, f"(got {out[-200:]!r})")

        # A command behind the frame (same write, and 5 ms later) runs.
        for gap, label in ((None, "same write"), (0.005, "5 ms later")):
            text, want = fish_command()
            got = complete(sh, shell, "cd pro", after=app_command(text), gap=gap)
            check(shell, f"answers with a command behind the frame ({label})", got is not None and "projects/" in got, f"(got {got})")
            expect_runs(sh, shell, f"a command behind the frame ({label}) runs", want)

        # ^Y, the cancel frame and a command in ONE batch, before the hook has even started.
        text, want = fish_command()
        sh.write(b"\x19" + CANCEL + app_command(text))
        out = sh.read_until(re.escape(want))
        check(shell, "^Y + cancel + command in one batch: no candidates, the command runs", want in out and CANDIDATE_RE.search(out) is None, f"(got {out[-200:]!r})")

        if ask(sh, shell, "cancel") is not None:
            text, want = fish_command()
            sh.write(CANCEL + app_command(text))
            out = sh.read_until(re.escape(want))
            check(shell, "the cancel frame ends the exchange with no candidates", CANDIDATE_RE.search(out) is None, f"(got {out[-200:]!r})")
            check(shell, "the command after the cancel frame runs", want in out, f"(got {out[-200:]!r})")

        token = ask(sh, shell, "stale token")
        if token is not None:
            text, want = fish_command()
            sh.write(frame(b"999" + token, "cd pro") + app_command(text))
            out = sh.read_until(re.escape(want))
            check(shell, "a frame with another token is ignored (no candidates)", CANDIDATE_RE.search(out) is None, f"(got {out[-200:]!r})")
            check(shell, "the command after a stale frame runs", want in out, f"(got {out[-200:]!r})")

        # A terminal reply (a DA report) between ^Y and the frame is dropped; the frame is answered.
        token = ask(sh, shell, "DA reply")
        if token is not None:
            sh.write(b"\x1b[?62;22c" + frame(token, "cd pro"))
            got = sh.read_until(rb"\x1b\]9280;B\x07")
            check(shell, "a DA reply before the frame is dropped; the frame is answered", b"projects/" in got, f"(got {got[-200:]!r})")
            text, want = fish_command()
            sh.write(app_command(text))
            expect_runs(sh, shell, "a DA reply leaves the line clean: the next command runs", want)

        # A SIGWINCH while the hook waits: a lost answer is fine, a lost key is not.
        if ask(sh, shell, "resize") is not None:
            os.kill(sh.pid, signal.SIGWINCH)
            time.sleep(0.2)
            text, want = fish_command()
            sh.write(CANCEL + app_command(text))
            expect_runs(sh, shell, "a SIGWINCH during the hook loses no key: the command after it runs", want)

        # The give-up: nothing arrives, the hook ends by itself (PHOSPHOR_NC_DEADLINE=5), writes nothing, the next raw command runs.
        if ask(sh, shell, "give-up") is not None:
            sh.drain(5.6)
            text, want = fish_command()
            sh.write(text.encode() + b"\r")
            expect_runs(sh, shell, "after the hook's own deadline the next raw command runs", want)

        # A frame landing at the prompt after the give-up is dropped; the command behind it runs.
        token = ask(sh, shell, "late frame")
        if token is not None:
            sh.drain(5.6)
            text, want = fish_command()
            sh.write(frame(token, "cd pro") + app_command(text))
            expect_runs(sh, shell, "a frame landing at the prompt is dropped; the command behind it runs", want)

        # The exchange is not a command: no Preexec, CommandFinished or Precmd hook, and the next real command announces itself exactly once.
        sh.drain(0.5)
        before = {h: len(sh.hooks(h)) for h in ("Preexec", "CommandFinished", "Precmd")}
        got = complete(sh, shell, "cd pro")
        sh.write(RS + b"-:" + US)
        sh.drain(1.0)
        after = {h: len(sh.hooks(h)) for h in before}
        check(shell, "the exchange and a frame at the prompt send no Preexec / CommandFinished / Precmd hook", got is not None and after == before, f"(before {before}, after {after})")
        text, want = fish_command()
        sh.write(app_command(text))
        expect_runs(sh, shell, "(hooks) the command after the exchange runs", want)
        sh.drain(1.0)
        after = {h: len(sh.hooks(h)) for h in before}
        check(shell, "the next real command sends exactly one Preexec, CommandFinished and Precmd", all(after[h] == before[h] + 1 for h in before), f"(before {before}, after {after})")

        # The exchange is quick: no slow path in the shell.
        t0 = time.time()
        got = complete(sh, shell, "cd pro")
        took = time.time() - t0
        check(shell, "answers well inside a second", got is not None and took < 1.0, f"(took {took:.2f}s, got {got})")
        text, want = fish_command()
        sh.write(app_command(text))
        expect_runs(sh, shell, "the shell runs a command at the end", want)
    finally:
        sh.close()


def main():
    import argparse
    ap = argparse.ArgumentParser(description="the in-band native-completions exchange in the real bash and zsh bootstraps")
    ap.add_argument("--bash", help="the bash to run (default: the first on PATH)")
    ap.add_argument("--bash-image", action="append", default=[], help="also run bash from this container image (repeatable)")
    ap.add_argument("--only-bash", action="store_true", help="skip zsh and fish")
    ap.add_argument("--only-fish", action="store_true", help="run only fish (#2196)")
    a = ap.parse_args()
    with tempfile.TemporaryDirectory(prefix="phx-native-") as base:
        lab = make_lab(base)
        runners = [] if a.only_fish else [(lambda b, l: run_bash(b, l, bash=a.bash), "bash")]
        # macOS: the system /bin/bash is 3.2 and is what a remote Mac usually runs; check it as
        # well when the bash on PATH is another one (Homebrew's).
        first = shutil.which("bash")
        if sys.platform == "darwin" and not a.bash and not a.only_fish and os.path.exists("/bin/bash") and first and os.path.realpath(first) != "/bin/bash":
            runners.append((lambda b, l: run_bash(b, l, bash="/bin/bash"), "bash-system"))
        images = a.bash_image or os.environ.get("PHOSPHOR_NC_BASH_IMAGES", "").split()
        for n, image in enumerate(images):
            runners.append((lambda b, l, image=image: run_bash(b, l, image=image), "bash-image-%d" % n))
        if not a.only_bash and not a.only_fish:
            runners.append((run_zsh, "zsh"))
            runners.append((run_zsh_no_compsys, "zsh-no-compinit"))
        if not a.only_bash:
            runners.append((run_fish, "fish"))
        for runner, name in runners:
            sub = os.path.join(base, name)
            os.makedirs(sub)
            runner(sub, lab)
    for shell in skipped:
        print(f"SKIPPED {shell}")
    if failures:
        print(f"test_native_completions: {len(failures)} check(s) failed")
        return 1
    print("test_native_completions: all checks passed" + (" (some shells SKIPPED)" if skipped else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
