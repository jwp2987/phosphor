#!/usr/bin/env python3
"""Drive the self-identifying in-band native-completions exchange of bash and zsh in a pty (#1801).

WHY THIS EXISTS
---------------
A Phosphorized remote session without the remote helper asks the remote shell itself for
its completions on Tab (`app/src/terminal/input/native_completions.rs`). The exchange shares
the tty with every other write, and the shell and the app each have their own clock, so it is
self-identifying (design in `app/src/terminal/writeable_pty/pty_controller.rs`, "The in-band
native-completions exchange"):

  app ^Y -> shell OSC 9280;P;<token> -> app ONE frame, RS <token> : <%HH text> RS (RS = 0x1e),
  or the cancel frame RS - : RS -> shell OSC 9280;A, one OSC 9280;C;<candidate> each, OSC 9280;B.

The hook consumes nothing that is not a frame (a first byte that is not RS goes back to the line
editor), a frame for another token or the cancel ends the exchange with nothing, and a frame that
lands at the prompt is dropped whole by the widget bound to RS. This pins all of that against the
REAL bundled bootstrap text in real shells. Needs only python3 and the shells (no cargo); a
missing shell is SKIPPED. fish is not exercised: the app never sends fish ^Y (see
`ShellType::supports_native_shell_completions`), and its bootstrap has no handler.

WHAT IT DOES
------------
Cuts the hook and widget functions out of `app/assets/bundled/bootstrap/{bash_body,zsh_body}.sh`,
starts each shell interactively in a pty in a scratch directory (PHOSPHOR_NC_DEADLINE=2, so the
hook's own deadline is short) and checks, per shell:

  * candidates: `cd pro` offers `projects/` and `proto/`; `cat dir/fi` offers the WHOLE token
    `dir/file1`; `echo a;ec` keeps the token's `a;` lead; bash's own `complete -F` / `-W`
    specs answer, with COMP_WORDS and COMP_CWORD as bash sets them and the `--opt=` part of a
    token kept;
  * no key is lost: a command written behind the frame (same write, and 5 ms later) runs
    after the exchange;
  * a command that arrives before the hook's prompt (no frame at all) runs normally, whole;
  * the cancel frame ends the exchange with no candidates and the next command runs;
  * a frame for another token is ignored and the next command runs;
  * a frame that arrives after the hook gave up (its deadline passed) is dropped at the prompt,
    nothing of it runs, and the command behind it runs;
  * a frame cut short (no closing RS) is bounded by the hook's deadline, and the shell then
    runs the next command;
  * the shell is alive at the end.

USAGE
    script/test_native_completions
Exit 0 when every check passes (or a shell is SKIPPED), 1 otherwise.
"""

import os
import pty
import re
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import time

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
BOOTSTRAP = os.path.join(ROOT, "app", "assets", "bundled", "bootstrap")
CANDIDATE_RE = re.compile(rb"\x1b\]9280;C;([^\x07]*)\x07")
PROMPT_RE = re.compile(rb"\x1b\]9280;P;([0-9A-Za-z]+)\x07")
RS = b"\x1e"
failures = []
skipped = []
counter = [40]


def read_file(name):
    with open(os.path.join(BOOTSTRAP, name)) as f:
        return f.read()


def cut(text, start_re, end_re, what):
    """The lines from the first matching `start_re` through the next matching `end_re`."""
    lines = text.split("\n")
    for i, line in enumerate(lines):
        if re.match(start_re, line):
            for j in range(i, len(lines)):
                if re.match(end_re, lines[j]):
                    return "\n".join(lines[i : j + 1]) + "\n"
    raise SystemExit(f"test_native_completions: could not cut {what} out of the bootstrap")


def frame(token, text):
    return RS + token + b":" + "".join("%%%02X" % b for b in text.encode()).encode() + RS


CANCEL = RS + b"-:" + RS


class Pty:
    def __init__(self, argv, env):
        self.pid, self.fd = pty.fork()
        if self.pid == 0:
            os.execvpe(argv[0], argv, env)

    def read_until(self, pattern, timeout=10):
        buf = b""
        end = time.time() + timeout
        while time.time() < end:
            ready, _, _ = select.select([self.fd], [], [], 0.05)
            if ready:
                try:
                    data = os.read(self.fd, 65536)
                except OSError:
                    break
                buf += data
                if re.search(pattern, buf):
                    return buf
        return buf

    def drain(self, seconds):
        return self.read_until(rb"(?!x)x", seconds)

    def write(self, data):
        os.write(self.fd, data)

    def close(self):
        try:
            os.kill(self.pid, signal.SIGKILL)
            os.waitpid(self.pid, 0)
        except OSError:
            pass


def check(shell, name, ok, detail=""):
    if not ok:
        failures.append(f"{shell}: {name} {detail}")
        print(f"FAIL {shell}: {name} {detail}")
    else:
        print(f"ok   {shell}: {name}")


def ask(sh, shell, what):
    """^Y, then the hook's prompt; returns its token or None."""
    sh.write(b"\x19")
    got = sh.read_until(PROMPT_RE)
    m = PROMPT_RE.search(got)
    if not m:
        check(shell, f"answers ^Y with a named prompt ({what})", False, f"(got {got[-200:]!r})")
        return None
    return m.group(1)


def complete(sh, shell, line, after=b"", gap=None):
    """One full exchange for `line`; `after` is written behind the frame (same write, or `gap`
    seconds later). Returns the candidates, or None."""
    token = ask(sh, shell, repr(line))
    if token is None:
        return None
    if after and gap is None:
        sh.write(frame(token, line) + after)
    else:
        sh.write(frame(token, line))
        if after:
            time.sleep(gap)
            sh.write(after)
    got = sh.read_until(rb"\x1b\]9280;B\x07")
    if b"\x1b]9280;B\x07" not in got or b"\x1b]9280;A;incrementally_typed\x07" not in got:
        check(shell, f"ends the reply for {line!r}", False, f"(got {got[-200:]!r})")
        return None
    return [c.decode("utf-8", "replace") for c in CANDIDATE_RE.findall(got)]


def command():
    """A command whose OUTPUT (not its echo) proves it ran: (bytes to write, output to expect)."""
    counter[0] += 1
    n = counter[0]
    return (b"echo ran-$((%d+1))\n" % (n - 1), b"ran-%d" % n)


def expect_runs(sh, shell, what, want):
    out = sh.read_until(re.escape(want))
    check(shell, what, want in out, f"(got {out[-200:]!r})")
    stray = re.search(rb"not found|%[0-9A-F]{2}", out)
    check(shell, what + ": nothing else ran", stray is None, f"(stray {out[-200:]!r})")


def make_lab(base):
    lab = os.path.join(base, "lab")
    for d in ("projects", "proto", "dir", "other"):
        os.makedirs(os.path.join(lab, d))
    for f in ("dir/file1", "dir/fig"):
        open(os.path.join(lab, f), "w").close()
    return lab


def protocol_checks(sh, shell):
    got = complete(sh, shell, "cd pro")
    if got is not None:
        check(shell, "cd pro offers projects/ and proto/", {"projects/", "proto/"} <= set(got), f"(got {got})")
        check(shell, "cd pro offers no file", "other/" not in got, f"(got {got})")
    got = complete(sh, shell, "cat dir/fi")
    if got is not None:
        check(shell, "cat dir/fi offers the whole token dir/file1", "dir/file1" in got, f"(got {got})")
    got = complete(sh, shell, "echo a;ec")
    if got is not None:
        check(shell, "echo a;ec keeps the token's a; lead",
              bool(got) and all(c.startswith("a;") for c in got) and "a;echo" in got, f"(got {got[:10]})")

    # No key lost behind the frame.
    for gap, label in ((None, "same write"), (0.005, "5 ms later")):
        cmd, want = command()
        got = complete(sh, shell, "cd pro", after=cmd, gap=gap)
        check(shell, f"answers with a command behind the frame ({label})", got is not None and "projects/" in got, f"(got {got})")
        expect_runs(sh, shell, f"a command behind the frame ({label}) runs", want)

    # A command that arrives before the prompt: the hook takes nothing of it.
    cmd, want = command()
    sh.write(b"\x19" + cmd)
    expect_runs(sh, shell, "a command arriving with the ^Y (before any frame) runs whole", want)

    # The cancel frame.
    if ask(sh, shell, "cancel") is not None:
        cmd, want = command()
        sh.write(CANCEL + cmd)
        out = sh.read_until(re.escape(want))
        check(shell, "the cancel frame ends the exchange with no candidates", CANDIDATE_RE.search(out) is None, f"(got {out[-200:]!r})")
        check(shell, "the command after the cancel frame runs", want in out, f"(got {out[-200:]!r})")

    # A frame for another exchange.
    token = ask(sh, shell, "stale token")
    if token is not None:
        cmd, want = command()
        sh.write(frame(b"999" + token, "cd pro") + cmd)
        out = sh.read_until(re.escape(want))
        check(shell, "a frame with another token is ignored (no candidates)", CANDIDATE_RE.search(out) is None, f"(got {out[-200:]!r})")
        check(shell, "the command after a stale frame runs", want in out, f"(got {out[-200:]!r})")

    # A frame that arrives after the hook gave up (PHOSPHOR_NC_DEADLINE=2): dropped at the prompt.
    token = ask(sh, shell, "late frame")
    if token is not None:
        sh.drain(2.6)
        cmd, want = command()
        sh.write(frame(token, "cd pro") + cmd)
        expect_runs(sh, shell, "a frame landing at the prompt is dropped; the command behind it runs", want)

    # A frame cut short: bounded by the hook's own deadline.
    token = ask(sh, shell, "cut-short frame")
    if token is not None:
        sh.write(RS + token + b":%63%64")
        t0 = time.time()
        sh.drain(5.8)
        cmd, want = command()
        sh.write(cmd)
        out = sh.read_until(re.escape(want), 10)
        check(shell, "a frame cut short is bounded by the deadline; the next command then runs", want in out,
              f"(after {time.time() - t0:.1f}s, got {out[-200:]!r})")

    cmd, want = command()
    sh.write(cmd)
    out = sh.read_until(re.escape(want))
    check(shell, "the shell runs a command at the end", want in out)


def run_bash(base, lab):
    bash = shutil.which("bash")
    if not bash:
        skipped.append("bash")
        return
    ver = subprocess.run([bash, "-c", "echo ${BASH_VERSINFO[0]}"], capture_output=True, text=True).stdout.strip()
    if ver and int(ver) < 4:
        print("NOTE bash: bash %s is below 4.0; the bootstrap binds no ^Y there and the app sends none" % ver)
        skipped.append("bash (below 4.0, by design)")
        return
    print("NOTE bash: bash %s; bash 3.2 (macOS /bin/bash) is not exercised here: no ^Y below 4.0, by design" % ver)
    body = read_file("bash_body.sh")
    text = (
        cut(body, r"^    __warp_relax_opts \(\) \{", r"^    \}$", "__warp_relax_opts")
        + cut(body, r"^    __warp_set_status \(\)", r"^    __warp_set_status", "__warp_set_status")
        + cut(body, r"^    __warp_run_relaxed \(\) \{", r"^    \}$", "__warp_run_relaxed")
        + cut(body, r"^    __warp_native_complete_impl \(\) \{", r"^    function warp_native_complete ", "warp_native_complete")
        + cut(body, r"^    __warp_native_discard_impl \(\) \{", r"^    function warp_native_discard ", "warp_native_discard")
        + cut(body, r"^    __warp_native_candidates \(\) \{", r"^    \}$", "__warp_native_candidates")
    )
    rc = os.path.join(base, "bashrc")
    with open(rc, "w") as f:
        f.write(text)
        f.write(
            "bind -x '\"\\C-y\":\"warp_native_complete\"'\n"
            "bind -x '\"\\C-^\":\"warp_native_discard\"'\n"
            "_phx() { COMPREPLY=($(compgen -W 'alpha beta' -- \"$2\")); }\n"
            "complete -F _phx phx\n"
            "_phz() { COMPREPLY=(\"w${COMP_CWORD}-${COMP_WORDS[1]}\"); }\n"
            "complete -F _phz phz\n"
            "_phq() { COMPREPLY=($(compgen -W 'red green' -- \"$2\")); }\n"
            "complete -F _phq phq\n"
            "complete -W '--force --file' phy\n"
            f"cd '{lab}'\nPS1='PROMPT> '\nset -u\n"
        )
    env = dict(os.environ, HOME=base, TERM="xterm", INPUTRC="/dev/null", PHOSPHOR_NC_DEADLINE="2")
    sh = Pty([bash, "--noprofile", "--rcfile", rc, "-i"], env)
    try:
        if b"PROMPT> " not in sh.read_until(rb"PROMPT> "):
            check("bash", "starts", False)
            return
        protocol_checks(sh, "bash")
        for line, want, name in (
            ("phx al", ["alpha"], "a complete -F function answers"),
            ("phz one tw", ["w2-one"], "COMP_WORDS and COMP_CWORD are set as bash sets them"),
            ("phq --color=re", ["--color=red"], "the token's --opt= part is kept"),
            ("phy --fo", ["--force"], "a complete -W spec answers"),
        ):
            got = complete(sh, "bash", line)
            if got is not None:
                check("bash", name, got == want, f"(got {got})")
    finally:
        sh.close()


def run_zsh(base, lab):
    zsh = shutil.which("zsh")
    if not zsh:
        skipped.append("zsh")
        return
    body = read_file("zsh_body.sh")
    text = cut(body, r"^  function compadd \(\) \{", r".*list-separator ''", "the zsh completion widgets")
    zdot = os.path.join(base, "zdot")
    os.makedirs(zdot)
    with open(os.path.join(zdot, ".zshrc"), "w") as f:
        f.write(
            "DCS_START=\"$(builtin printf '\\eP$')\"\nDCS_END=\"$(builtin printf '\\x9c')\"\n"
            "OSC_PARAM_SEPARATOR=';'\nOSC_END=\"$(builtin printf '\\a')\"\n"
            "zmodload -F zsh/datetime +p:EPOCHREALTIME\n"
            f"autoload -Uz compinit && compinit -u -d '{zdot}/.zcompdump'\n"
        )
        f.write(text)
        f.write(f"cd '{lab}'\nPS1='PROMPT> '\n")
    env = dict(os.environ, ZDOTDIR=zdot, HOME=base, TERM="xterm", PHOSPHOR_NC_DEADLINE="2")
    sh = Pty([zsh, "-i"], env)
    try:
        if b"PROMPT> " not in sh.read_until(rb"PROMPT> "):
            check("zsh", "starts", False)
            return
        protocol_checks(sh, "zsh")
    finally:
        sh.close()


def main():
    with tempfile.TemporaryDirectory(prefix="phx-native-") as base:
        lab = make_lab(base)
        for runner, name in ((run_bash, "bash"), (run_zsh, "zsh")):
            sub = os.path.join(base, name)
            os.makedirs(sub)
            runner(sub, lab)
    print("NOTE fish: not exercised; the app never sends fish ^Y (ShellType::supports_native_shell_completions)")
    for shell in skipped:
        print(f"SKIPPED {shell}: not installed")
    if failures:
        print(f"test_native_completions: {len(failures)} check(s) failed")
        return 1
    print("test_native_completions: all checks passed" + (" (some shells SKIPPED)" if skipped else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
