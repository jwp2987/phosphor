#!/usr/bin/env bash
# agent-cargo — build-concurrency governor for parallel agents on this host.
#
# Why this exists: the workspace is large enough that unbounded concurrent
# compiles exhaust RAM and take the whole session down. This hands out a small,
# fixed number of slots so concurrency stays inside what the host can take.
#
# Usage:
#   script/agent-cargo <agent-name> <cargo-args...>
#
# Example:
#   script/agent-cargo pinned-tabs check -p warp --features gui
#
# Behavior:
#   - Blocks until one of PHOSPHOR_BUILD_SLOTS slots is free AND the host has
#     PHOSPHOR_MIN_FREE_MB available, then runs cargo.
#   - Pins the invocation to its own CARGO_TARGET_DIR keyed by <agent-name>,
#     so concurrent agents on different branches cannot contaminate each
#     other's build artifacts (the shared-target contamination that produced
#     phantom "missing symbol" errors on a previous host).
#   - Records the low-water mark of available memory per run to
#     $LOG_DIR/mem-<agent>.log, so slot sizing can be driven by measurement
#     rather than guesswork.
#
# SIZING — read before changing:
#   Slot count must be sized against the HEAVIEST cargo invocation agents
#   actually run, which is `nextest run` / `--all-targets`, NOT `cargo check`.
#   A check peaks around 1-2 GB over baseline; building and LINKING the test
#   binaries is several GB *per parallel job*, and mold deliberately trades
#   memory for link speed. Sizing slots from a `check` measurement is how this
#   host got OOM-reaped once already. When in doubt, lower the numbers: a
#   queued build costs minutes, an OOM costs every running agent at once.
set -euo pipefail

SLOTS="${PHOSPHOR_BUILD_SLOTS:-3}"
JOBS="${PHOSPHOR_BUILD_JOBS:-5}"
MIN_FREE_MB="${PHOSPHOR_MIN_FREE_MB:-8000}"
# Ceiling enforced in code, not prose. The SIZING note above was the only thing
# standing between this host and an OOM reap, and prose does not execute: the
# slots override file was set to 6 and the whole fleet was killed, losing three
# agents' unpushed work. 3 is the measured-safe value on a 24-core/45 GB host;
# 4 has OOM-reaped this box before. Raising this requires re-measuring the
# low-water marks in logs/mem-*.log, not editing the override file.
MAX_SLOTS="${PHOSPHOR_MAX_SLOTS:-4}"
# Minimum seconds between two builds STARTING. MIN_FREE_MB is a start-time
# admission check only: N invocations can each observe plenty of free memory in
# the same poll pass, all be admitted, and then reach their peak LINK phase
# simultaneously -- at which point nothing re-checks anything. That, not the raw
# slot number, is the mechanism that reaps this host. Staggering the starts
# de-synchronises the peaks.
RAMP_STAGGER_SECS="${PHOSPHOR_RAMP_STAGGER_SECS:-45}"
LOCK_DIR="${PHOSPHOR_LOCK_DIR:-/cache/git/.phosphor-build/locks}"
TARGET_ROOT="${PHOSPHOR_TARGET_ROOT:-/cache/git/.phosphor-build/targets}"
LOG_DIR="${PHOSPHOR_LOG_DIR:-/cache/git/.phosphor-build/logs}"

if [[ $# -lt 2 ]]; then
  echo "usage: $0 <agent-name> <cargo-args...>" >&2
  exit 2
fi

agent="$1"
shift

# Refuse to build a checkout nobody authored.
#
# script/check_workspace_clean exists for exactly this (see its header: an agent
# once spent an hour compiling a tree holding three authors' uncommitted work),
# but until 2026-08-21 NOTHING invoked it -- not precheck, not any workflow --
# while TODO.md asserted it was "in daily use". Builds are where it belongs, and
# this governor is the single door every agent build goes through.
#
# Skipped when the script is absent (older checkouts) and overridable with
# ALLOW_DIRTY=1, which the guard itself documents for the case where you have
# deliberately accepted a dirty tree.
if [[ -x ./script/check_workspace_clean ]]; then
  if ! ./script/check_workspace_clean; then
    echo "[agent-cargo] refusing to build: see script/check_workspace_clean above." >&2
    echo "[agent-cargo] set ALLOW_DIRTY=1 if you accept building this tree anyway." >&2
    exit 1
  fi
fi

# The governor exists to stop PARALLEL agents from exhausting RAM on one shared build
# host. Its scratch dirs default to `/cache/git/...`, which is that host's fast disk and
# exists nowhere else -- not on a GitHub runner, not on the maintainer's laptop.
#
# `mkdir -p` on a missing `/cache` fails, and because this ran before any cargo
# invocation, the caller died having run NOTHING. In CI that turned every
# `check_test_failures` job into "THE TEST RUN ITSELF FAILED -- no tests were judged":
# jobs that looked like a test gate and never executed a single test. Locally it made
# `script/precheck`'s whole suite section unusable for the same reason.
#
# So: when the scratch base cannot be created, run cargo anyway with slot arbitration
# DISABLED but every other protection intact. Losing arbitration is correct exactly where
# this fails -- a CI runner or a laptop running one build -- because there are no
# competing agents to arbitrate between. It also leaves `CARGO_TARGET_DIR` at the default
# `./target`, which CI's build cache is keyed on; redirecting it to an unshared path
# would make every run compile cold.
GOVERNOR=1
if ! mkdir -p "$LOCK_DIR" "$TARGET_ROOT/$agent" "$LOG_DIR" 2>/dev/null; then
  GOVERNOR=0
  echo "[agent-cargo] scratch base unavailable (tried $TARGET_ROOT); slot limiting OFF" >&2
  echo "[agent-cargo] set PHOSPHOR_TARGET_ROOT/PHOSPHOR_LOCK_DIR/PHOSPHOR_LOG_DIR to restore it." >&2
fi

# Only the ISOLATION is skipped when the scratch base is missing -- the job/thread
# caps, the fd limit and the toolchain pin below still apply.
#
# An earlier version of this fallback did `exec cargo "$@"` right here, which also
# dropped CARGO_BUILD_JOBS / NEXTEST_TEST_THREADS and the pin check. On a GitHub
# runner that let the `warp` + `warp_tui` test build run at full parallelism and the
# runner was killed mid-compile ("The runner has received a shutdown signal", exit
# 143) after ~12 minutes -- nowhere near its 120-minute timeout. The caps are the
# entire point of this script; only the shared-host arbitration is situational.
if [[ "$GOVERNOR" == 1 ]]; then
  export CARGO_TARGET_DIR="$TARGET_ROOT/$agent"
fi
export CARGO_BUILD_JOBS="$JOBS"
# CARGO_BUILD_JOBS bounds COMPILATION only. nextest defaults its test-execution
# parallelism to the CPU count, so a test run spawns up to `nproc` concurrent
# test processes regardless of the jobs cap — and in this workspace each one
# stands up an App. Measured: a single `nextest -p warp_tui -p warp_editor` drove
# host available memory down to 4.4 GB and load above 49 on 24 cores. Bound test
# threads to the same budget as compile jobs.
export NEXTEST_TEST_THREADS="$JOBS"
export RUST_TEST_THREADS="$JOBS"
ulimit -n 8192

# ---------------------------------------------------------------- toolchain
# Every build on this host goes through this script, so this is the one place
# that can guarantee the compiler is the pinned one. Shell config cannot:
# ~/.bashrc returns early for non-interactive shells, and agents, hooks and CI
# helpers all run non-interactively -- which is precisely how this host ran
# rustc 1.93.1 against a 1.92.0 pin for weeks without anyone noticing.
#
# The skew runs the dangerous direction. CI has rustup and honours the pin, so
# anything stabilised in a newer local compiler builds clean here and fails
# there. A green measured on the wrong compiler is worse than no green: it is
# a confident answer to a question nobody asked.
if [[ -x "$HOME/.cargo/bin/rustup" ]]; then
  case ":$PATH:" in
    *:"$HOME/.cargo/bin":*) ;;
    *) export PATH="$HOME/.cargo/bin:$PATH" ;;
  esac
fi

# Walk up from the invocation directory for the pin, the same way rustup does.
find_pin() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    if [[ -f "$d/rust-toolchain.toml" ]]; then
      sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$d/rust-toolchain.toml" | head -1
      return
    fi
    d="$(dirname "$d")"
  done
}
pinned="$(find_pin)"
actual="$(rustc --version 2>/dev/null | awk '{print $2}')"
if [[ "$pinned" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ && "$actual" != "$pinned" ]]; then
  echo "[agent-cargo] REFUSING: rustc ${actual:-none} does not match the pin $pinned" >&2
  echo "[agent-cargo]   rustc:  $(command -v rustc)" >&2
  echo "[agent-cargo]   fix:    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \\" >&2
  echo "[agent-cargo]             | sh -s -- -y --no-modify-path --default-toolchain $pinned \\" >&2
  echo "[agent-cargo]                 --profile minimal -c rustfmt -c clippy" >&2
  echo "[agent-cargo] RESULT agent=$agent exit=3 FAILED" >&2
  exit 3
fi

available_mb() { awk '/^MemAvailable:/ {print int($2/1024)}' /proc/meminfo; }

# Samples available memory while the build runs and reports the low-water mark.
# A run that dips near zero means the slot count is too high for this host,
# even if it happened to survive.
watch_memory() {
  local low
  low="$(available_mb)"
  while :; do
    local now
    now="$(available_mb)"
    ((now < low)) && low="$now"
    echo "$low" >"$1"
    sleep 5
  done
}

# Re-read the slot count on every poll pass rather than trusting the value bash
# captured at start-up. A queued invocation can wait a long time, and raising
# the cap mid-flight would otherwise never reach it: bash has already read the
# script, so an edit cannot change a running process's loop bound, and the new
# slot sits idle until every waiting invocation happens to exit. Reading the
# override file each pass makes tuning take effect on the queue that is
# actually waiting.
slot_count() {
  local n
  n="$(cat "$LOCK_DIR/../slots" 2>/dev/null)"
  if [[ "$n" =~ ^[0-9]+$ ]] && ((n > 0)); then
    # Clamp. An override file is a convenience for tuning DOWN under load; it
    # must not be able to exceed what the host was measured to survive.
    if ((n > MAX_SLOTS)); then
      echo "[agent-cargo] slots override $n exceeds MAX_SLOTS=$MAX_SLOTS; clamping" >&2
      echo "$MAX_SLOTS"
    else
      echo "$n"
    fi
    return
  fi
  echo "$SLOTS"
}

# No lock directory means no slots to hand out. Run under the caps set above rather
# than spinning forever on a `flock` target that cannot be created.
if [[ "$GOVERNOR" == 0 ]]; then
  set +e
  cargo "$@"
  status=$?
  set -e
  if [[ $status -eq 0 ]]; then
    echo "[agent-cargo] RESULT agent=$agent exit=0 OK (ungoverned)" >&2
  else
    echo "[agent-cargo] RESULT agent=$agent exit=$status FAILED (ungoverned)" >&2
  fi
  exit $status
fi

while :; do
  live_slots="$(slot_count)"
  for ((i = 1; i <= live_slots; i++)); do
    exec {fd}>"$LOCK_DIR/slot$i"
    if flock -n "$fd"; then
      # Hold the slot but wait for headroom: a free slot does not imply a safe
      # moment to start, since the other slots' builds may be at peak.
      while (($(available_mb) < MIN_FREE_MB)); do
        echo "[agent-cargo] agent=$agent waiting for memory ($(available_mb)MB < ${MIN_FREE_MB}MB)" >&2
        sleep 15
      done

      # Stagger the start against every other slot. Held only across the sleep,
      # so this delays the START of each build without serialising the builds
      # themselves: no two can enter their memory-hungry link phase in lockstep.
      exec {rampfd}>"$LOCK_DIR/ramp"
      flock "$rampfd"
      sleep "$RAMP_STAGGER_SECS"
      exec {rampfd}>&-

      echo "[agent-cargo] agent=$agent slot=$i jobs=$JOBS avail=$(available_mb)MB target=$CARGO_TARGET_DIR" >&2

      low_file="$(mktemp)"
      watch_memory "$low_file" &
      watcher=$!
      set +e
      cargo "$@"
      status=$?
      set -e
      kill "$watcher" 2>/dev/null || true
      echo "$(date -Is) agent=$agent low_avail_mb=$(cat "$low_file" 2>/dev/null) exit=$status args=$*" \
        >>"$LOG_DIR/mem-$agent.log"
      rm -f "$low_file"
      # Emit the outcome on stderr as well as exiting with it. Piping this
      # script through `| head` / `| tail` / `| grep` replaces the pipeline's
      # exit status with the filter's, silently turning a failed build into an
      # apparent success — a mistake made twice on this repo in one day, once
      # via `| head` and once via `|| true`. stderr is not consumed by those
      # filters, so this line survives them and is the value to trust.
      if [[ $status -eq 0 ]]; then
        echo "[agent-cargo] RESULT agent=$agent exit=0 OK" >&2
      else
        echo "[agent-cargo] RESULT agent=$agent exit=$status FAILED" >&2
      fi
      exit $status
    fi
    exec {fd}>&-
  done
  sleep 5
done
