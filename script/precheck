#!/usr/bin/env bash
# Run the real gates locally, before you push. "ok" means verified, not hopeful.
#
# WHY THIS EXISTS
# ---------------
# CI is the FINAL check, not the one that discovers a problem. Anything CI
# reports first is a 15-40 minute round trip you could have had in minutes --
# and it trains people to push speculatively and let the runner think for them.
#
# THIS SCRIPT USED TO BE PART OF THE PROBLEM
# ------------------------------------------
# Its previous version ran only the cheap gates -- toolchain, rustfmt, boundary
# guards, and a filtered run of the known-failure list -- and its own header
# argued that "full-suite regressions are still CI's job."
#
# That was wrong, and it cost a day. It never compiled anything and never ran
# the suite, so `precheck: ok -- safe to push` was printed by ~30 agents across
# 158 merges while asserting essentially nothing. Two regression clusters and
# three separate compile breaks reached main underneath that green.
#
# Compounding it: branch protection has `strict: false`, so GitHub CI validates
# each PR against its own stale base and NEVER the merge result. Deferring the
# real checks to CI meant deferring them to something that structurally could
# not catch an integration break.
#
# So: the compile and the suite run HERE now, by default. Locally is the only
# place the integrated state actually gets tested.
#
# WHAT STAYS IN CI
# ----------------
# Only what cannot run on this host: the macOS and Windows jobs. Everything
# Linux is verified here first.
#
# USAGE
#     script/precheck            # everything: gates + compile + full suite
#     script/precheck --fast     # gates only -- does NOT authorise a push
#
# Exit non-zero if any gate fails, so it can be wired to a pre-push hook.

set -uo pipefail
cd "$(dirname "$0")/.."

FAST=0
[[ "${1:-}" == "--fast" ]] && FAST=1
# --with-tests used to be how you opted IN to testing. Tests are now the
# default; accept the old flag silently so existing muscle memory and any
# scripted callers do not break.
[[ "${1:-}" == "--with-tests" ]] && FAST=0

status=0
step() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
fail() { printf '  \033[31mFAIL\033[0m %s\n' "$1"; status=1; }
ok()   { printf '  \033[32mok\033[0m   %s\n' "$1"; }
warn() { printf '  \033[33mwarn\033[0m %s\n' "$1"; }

# Route cargo through the build governor when it exists: slot limits, job caps
# and a per-agent CARGO_TARGET_DIR. Raw parallel cargo is what OOMed this host.
CARGO_RUN=(cargo)
if [[ -x ./script/agent-cargo ]]; then
    # A STABLE label on purpose. This used to be "precheck-$$", so every run got
    # a brand-new CARGO_TARGET_DIR and rebuilt the world from cold -- ~6.7G and
    # a full build each time, which is also how the 2026-08-08 tmpfs exhaustion
    # got its volume. One label means one warm cache that later runs reuse.
    export PHOSPHOR_CARGO_LABEL=precheck
    CARGO_RUN=(./script/agent-cargo "$PHOSPHOR_CARGO_LABEL")
fi
# Keep rustc temporaries off /tmp: a worktree under /tmp is on a RAM-backed
# tmpfs, and filling it takes the whole host down, not just the build.
if [[ -z "${TMPDIR:-}" || "$TMPDIR" == /tmp* ]]; then
    _tmp_root="${PHOSPHOR_TARGET_ROOT:-/cache/git/.phosphor-build}/tmp"
    mkdir -p "$_tmp_root" 2>/dev/null && export TMPDIR="$_tmp_root"
fi

# ------------------------------------------------------------- scratch space
# Before step 0, because a run that dies here dies WITHOUT a verdict.
#
# /tmp is a 23G RAM-backed tmpfs on this host, so anything living there consumes
# real memory. On 2026-08-08 a stale 15G `target/` sat in a /tmp worktree --
# created by a cargo run that bypassed script/agent-cargo and so never had its
# CARGO_TARGET_DIR redirected to disk -- and precheck was killed mid-suite by the
# resulting pressure. No OOM line in the kernel log, no exit code, the wrapper
# never echoed its own status. The harness then reported the killed run as
# "exit code 0". A truncated log looked green.
#
# Fail loudly up front instead: a refusal to start is diagnosable, a silent kill
# halfway through is not. Checks the filesystem TMPDIR actually resolves to, so
# it still does something useful when TMPDIR points at real disk.
step "scratch space"
_tmp_check="${TMPDIR:-/tmp}"
_tmp_avail_mb=$(df -Pm "$_tmp_check" 2>/dev/null | awk 'NR==2 {print $4}')
_tmp_pct=$(df -P "$_tmp_check" 2>/dev/null | awk 'NR==2 {gsub(/%/,"",$5); print $5}')
if [[ -z "${_tmp_avail_mb:-}" ]]; then
    ok "could not stat $_tmp_check -- skipping"
elif ((_tmp_avail_mb < 4096)); then
    fail "only ${_tmp_avail_mb}MB free on $_tmp_check (${_tmp_pct}% used) -- a build needs headroom here"
    printf '       Largest consumers:\n'
    du -sh "$_tmp_check"/* 2>/dev/null | sort -rh | head -5 | sed 's/^/         /'
    printf '       A stray target/ under a /tmp worktree is the usual cause; it is\n'
    printf '       regenerable, so deleting it is safe. Use script/agent-cargo, which\n'
    printf '       redirects CARGO_TARGET_DIR to disk, rather than bare cargo.\n'
else
    ok "${_tmp_avail_mb}MB free on $_tmp_check"
fi

# ------------------------------------------------------------------ toolchain
# Step 0 deliberately: every gate below reports on whatever compiler is first in
# PATH, so a mismatch silently invalidates every result -- including the greens.
step "toolchain matches the pin"
if [[ -x "$HOME/.cargo/bin/rustup" ]]; then
    case ":$PATH:" in
        *:"$HOME/.cargo/bin":*) ;;
        *) export PATH="$HOME/.cargo/bin:$PATH" ;;
    esac
fi
PINNED="$(sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' rust-toolchain.toml 2>/dev/null | head -1)"
ACTUAL="$(rustc --version 2>/dev/null | awk '{print $2}')"
if [[ -z "$PINNED" ]]; then
    fail "rust-toolchain.toml has no channel pin -- cannot verify the compiler"
elif [[ -z "$ACTUAL" ]]; then
    fail "no rustc on PATH"
elif [[ ! "$PINNED" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
    ok "channel '$PINNED' is floating -- running rustc $ACTUAL (not asserted)"
elif [[ "$ACTUAL" == "$PINNED" ]]; then
    ok "rustc $ACTUAL matches pin"
else
    fail "rustc $ACTUAL does NOT match the pin $PINNED ($(command -v rustc))"
    printf '      Every result below is measured on the wrong compiler.\n' >&2
fi

# ------------------------------------------------------------------ staleness
step "base freshness"
git fetch -q origin main 2>/dev/null || true
BEHIND="$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
STALE_FAIL="${PHOSPHOR_STALE_FAIL:-25}"
if ((BEHIND == 0)); then
    ok "up to date with origin/main"
elif ((BEHIND < STALE_FAIL)); then
    warn "$BEHIND commit(s) behind origin/main -- merge before final verification"
else
    fail "$BEHIND commits behind origin/main -- MERGE BEFORE TRUSTING ANY TEST RESULT"
    printf '      Fix:  git fetch origin && git merge origin/main\n' >&2
fi

# ---------------------------------------------------------------- formatting
# .rustfmt.toml now pins edition 2024, matching every crate in the workspace
# (#191 -- it used to say 2018, so rustfmt could not parse edition-2024 syntax
# and this check reported bogus parse errors). ALWAYS use --config-path, never
# --edition, so the pin stays the single source of truth.
#
# This is a PARSE check, not a formatting check, and only over changed files.
# The repo has never been rustfmt-clean (~1.6k files drift at either edition),
# so a repo-wide format gate would report drift you did not cause -- and noise
# in a gate gets ignored.
step "rustfmt (changed .rs files only)"
# Committed changes AND the working tree. This used to ask only for
# origin/main...HEAD, so running precheck BEFORE committing -- which is the
# entire point of the script -- reported "no changed .rs files" and asserted
# nothing at all. Staged, unstaged and untracked files all count.
mapfile -t changed < <(
    {
        git diff --name-only --diff-filter=ACM origin/main...HEAD -- '*.rs' 2>/dev/null
        git diff --name-only --diff-filter=ACM HEAD -- '*.rs' 2>/dev/null
        git ls-files --others --exclude-standard -- '*.rs' 2>/dev/null
    } | sort -u
)
if ((${#changed[@]} == 0)); then
    ok "no changed .rs files"
else
    fmt_bad=0
    for f in "${changed[@]}"; do
        [[ -f "$f" ]] || continue
        if rustfmt --check --config-path .rustfmt.toml "$f" 2>&1 | grep -qE '^error: (expected|unexpected)'; then
            fail "$f does not parse"; fmt_bad=1
        fi
    done
    ((fmt_bad == 0)) && ok "${#changed[@]} file(s) parse cleanly"
fi

# ------------------------------------------------------------------- guards
step "fork boundary guards"
./script/check_cloud_boundary >/dev/null 2>&1 && ok "cloud boundary" \
    || fail "cloud boundary -- run ./script/check_cloud_boundary for detail"
./script/check_stub_coverage  >/dev/null 2>&1 && ok "stub coverage" \
    || fail "stub coverage -- run ./script/check_stub_coverage for detail"
if [[ -x ./script/check_settings_registry ]]; then
    ./script/check_settings_registry >/dev/null 2>&1 && ok "settings registry" \
        || fail "settings registry -- run ./script/check_settings_registry for detail"
fi

if ((FAST == 1)); then
    printf '\n\033[33mprecheck --fast: gates only.\033[0m Nothing was compiled and no test ran.\n'
    printf 'This does NOT authorise a push. Run script/precheck with no flags first.\n'
    exit $status
fi

# ------------------------------------------------------------------- compile
# The required CI check. Note --lib --tests: test code must compile too, and a
# missing trait import in a test file is invisible without it.
step "cargo check -p warp --features gui --lib --tests"
if "${CARGO_RUN[@]}" check -p warp --features gui --lib --tests >/tmp/precheck-check.$$ 2>&1; then
    ok "compiles"
else
    fail "does NOT compile"
    grep -E '^error' /tmp/precheck-check.$$ | head -10 >&2
fi

# ------------------------------------------- compile, feature-unified
# `warp` alone does NOT enable `integration_tests`; that only activates through
# Cargo feature unification when `warp` and `crates/integration` are checked in
# the SAME invocation. Three separate compile breaks reached main in one day
# through this blind spot -- the required single-package check cannot see them.
step "cargo check (feature-unified, multi-package)"
if "${CARGO_RUN[@]}" check -p warp -p warp_completer -p integration \
        -p app-installation-detection -p warp_ripgrep --features gui \
        >/tmp/precheck-unified.$$ 2>&1; then
    ok "compiles under feature unification"
else
    fail "does NOT compile under feature unification"
    grep -E '^error' /tmp/precheck-unified.$$ | head -10 >&2
fi

# ---------------------------------------------------------------- full suite
# The expensive gate, and the only one that catches a regression. Delegated to
# check_test_failures, which fails on CHANGE against known_test_failures.txt
# rather than on redness -- so a listed failure that now PASSES is also an error
# (its line must be deleted in the same change).
#
# BOTH crates in ONE invocation: check_test_failures treats a listed failure
# that did not run as "fixed" and exits 1, so splitting them fails the gate on
# the other crate's known failures.
step "full test suite (warp + warp_tui)"
if ./script/check_test_failures -p warp -p warp_tui --lib --features warp/gui; then
    ok "no change against known_test_failures.txt"
else
    fail "test suite changed against known_test_failures.txt (see above)"
fi

# warpui_core runs SEPARATELY, and `--features tui` is not optional (#573).
#
# It cannot join the invocation above because its tests are not all lib tests
# and it needs a different feature set. Two ways this package went dark:
#
#   1. It was simply absent from the gate, so ~565 tests had never run at all.
#   2. `tui` is OFF by default (Cargo.toml), and `elements/tui/` is
#      `#[cfg(feature = "tui")]`. Without the flag that whole module is not
#      compiled, so its tests do not fail -- they do not EXIST. A run reports
#      306 passing and looks green while saying nothing about 259 others.
#
# The tell for (2) was a test count that did not move when a test was added.
# If you ever change this line, check the count, not just the colour.
step "warpui_core suite (--features tui)"
if ./script/check_test_failures -p warpui_core --features tui; then
    ok "no change against known_test_failures.txt"
else
    fail "warpui_core suite changed against known_test_failures.txt (see above)"
fi

rm -f /tmp/precheck-check.$$ /tmp/precheck-unified.$$

printf '\n'
if ((status == 0)); then
    printf '\033[32mprecheck: ok\033[0m -- compiled and tested locally; safe to push\n'
    printf 'Remaining CI coverage: macOS and Windows only.\n'
else
    printf '\033[31mprecheck: FAILED\033[0m -- fix before pushing\n'
fi
exit $status
