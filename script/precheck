#!/usr/bin/env bash
# Run every gate CI runs, locally, before you push.
#
# WHY THIS EXISTS
# ---------------
# CI is the FINAL check, not the check that finds a problem for the first time.
# Every failure CI reports first is a slow round trip that a local run would
# have caught in seconds -- and it trains people to push speculatively and let
# the runner think for them.
#
# This bit for real: PR #417 was correct, but it fixed three tests whose entries
# were still in script/known_test_failures.txt. Nothing local checked that, so
# CI reported it ~15 minutes later as a red job that read like a broken PR.
#
# WHAT IT COSTS
# -------------
# The expensive part -- the full suite -- is NOT run here. Instead this runs
# only the tests currently listed in known_test_failures.txt (8 of them), which
# is what catches the stale-entry case. That is seconds once the crate is built,
# against ~15 minutes of CI round trip.
#
# Full-suite regressions are still CI's job. That is the correct division: cheap
# and certain locally, expensive and comprehensive in CI.
#
# USAGE
#     script/precheck                 # gates only (fast, no build)
#     script/precheck --with-tests    # also run the known-failure subset
#
# Exit non-zero if any gate fails, so it can be wired to a pre-push hook.

set -uo pipefail
cd "$(dirname "$0")/.."

WITH_TESTS=0
[[ "${1:-}" == "--with-tests" ]] && WITH_TESTS=1

status=0
step() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
fail() { printf '  \033[31mFAIL\033[0m %s\n' "$1"; status=1; }
ok()   { printf '  \033[32mok\033[0m   %s\n' "$1"; }

# ------------------------------------------------------------------ toolchain
# This is step 0 deliberately: every gate below reports on whatever compiler
# happens to be first in PATH, so a toolchain mismatch silently invalidates
# every result this script prints -- including its greens.
#
# This bit for real. `script/install_rust` guards on `command -v cargo`, so a
# host with a distro cargo at /usr/bin/cargo short-circuits it and rustup is
# never installed. rust-toolchain.toml's channel pin is then ignored with no
# diagnostic at all: this host ran 1.93.1 against a 1.92.0 pin for weeks while
# CI (which has rustup, and so honours the pin) ran 1.92.0. The skew runs the
# dangerous direction -- anything stabilised in the newer compiler builds clean
# locally and fails in CI -- which is precisely the "let CI find it" failure
# this script exists to prevent.
#
# Fix on such a host, without disturbing the distro toolchain:
#   curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- \
#       -y --no-modify-path --default-toolchain <channel> --profile minimal \
#       -c rustfmt -c clippy
# then run cargo through it: RUSTUP_TOOLCHAIN=<channel> PATH="$HOME/.cargo/bin:$PATH"
step "toolchain matches the pin"
# Self-correct where possible: if rustup is installed but its shims are not
# first in PATH, use them rather than failing. A gate that rejects a host which
# HAS the right compiler, merely not first in PATH, is noise -- and noise in a
# gate trains people to ignore it. Fail only when the pin is genuinely absent.
if [[ -x "$HOME/.cargo/bin/rustup" ]]; then
    case ":$PATH:" in
        *:"$HOME/.cargo/bin":*) ;;
        *) export PATH="$HOME/.cargo/bin:$PATH" ;;
    esac
fi
PINNED="$(sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' rust-toolchain.toml 2>/dev/null | head -1)"
ACTUAL="$(rustc --version 2>/dev/null | awk '{print $2}')"
if [[ -z "$PINNED" ]]; then
    fail "rust-toolchain.toml has no channel pin -- cannot verify the compiler"
elif [[ -z "$ACTUAL" ]]; then
    fail "no rustc on PATH"
elif [[ ! "$PINNED" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
    # A floating channel (stable/nightly/dated) cannot be checked by equality.
    ok "channel '$PINNED' is floating -- running rustc $ACTUAL (not asserted)"
elif [[ "$ACTUAL" == "$PINNED" ]]; then
    ok "rustc $ACTUAL matches pin"
else
    fail "rustc $ACTUAL does NOT match the pin $PINNED ($(command -v rustc))"
    printf '      Every result below is measured on the wrong compiler.\n' >&2
    printf '      CI honours the pin via rustup; this host does not. A green here\n' >&2
    printf '      does not predict CI. See the header of this step for the fix.\n' >&2
fi

# ------------------------------------------------------------------ staleness
# An agent working on a base tens of commits old will hit failures that are real,
# reproducible, and entirely about the wrong tree. This bit for real: an agent
# branched 105 commits behind, missed the merged secret-detection fix, and
# reported the resulting failure as an "unrelated pre-existing" defect.
#
# main moves constantly, so being a few commits behind is normal and fine. Being
# far behind is not.
step "base freshness"
git fetch -q origin main 2>/dev/null || true
BEHIND="$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
STALE_FAIL="${PHOSPHOR_STALE_FAIL:-25}"
if ((BEHIND == 0)); then
    ok "up to date with origin/main"
elif ((BEHIND < STALE_FAIL)); then
    printf '  \033[33mwarn\033[0m %s commit(s) behind origin/main -- fine, but merge before final verification\n' "$BEHIND"
else
    fail "$BEHIND commits behind origin/main -- REBASE BEFORE TRUSTING ANY TEST RESULT"
    printf '      A stale base produces failures that are real and about the wrong tree.\n' >&2
    printf '      Fix:  git fetch origin && git merge origin/main\n' >&2
fi

# ---------------------------------------------------------------- formatting
# The repo pins edition 2018 in .rustfmt.toml while the crates are edition 2024
# (issue #191), so ALWAYS use --config-path and never --edition. Only changed
# files are checked: a repo-wide run reports pre-existing drift you did not
# cause, which is noise that gets ignored.
step "rustfmt (changed .rs files only)"
mapfile -t changed < <(git diff --name-only --diff-filter=ACM origin/main...HEAD -- '*.rs' 2>/dev/null)
if ((${#changed[@]} == 0)); then
    ok "no changed .rs files"
else
    fmt_bad=0
    for f in "${changed[@]}"; do
        [[ -f "$f" ]] || continue
        # Only parse errors matter here. Formatting diffs are frequently
        # pre-existing; a parse error never is.
        if rustfmt --check --config-path .rustfmt.toml "$f" 2>&1 | grep -qE '^error: (expected|unexpected)'; then
            fail "$f does not parse"
            fmt_bad=1
        fi
    done
    ((fmt_bad == 0)) && ok "${#changed[@]} file(s) parse cleanly"
fi

# ------------------------------------------------------------------- guards
step "fork boundary guards"
if ./script/check_cloud_boundary >/dev/null 2>&1; then ok "cloud boundary"; else
    fail "cloud boundary -- run ./script/check_cloud_boundary for detail"; fi
if ./script/check_stub_coverage >/dev/null 2>&1; then ok "stub coverage"; else
    fail "stub coverage -- run ./script/check_stub_coverage for detail"; fi
if ./script/check_settings_registry >/dev/null 2>&1; then ok "settings registry"; else
    fail "settings registry -- run ./script/check_settings_registry for detail"; fi

# ------------------------------------------------- known-failure bookkeeping
# The cheap half of the CI test gate: run ONLY the listed failures. If one now
# passes, its line must be deleted in this same PR -- which is exactly the case
# that surprised #417.
step "known-failure bookkeeping"
KNOWN=script/known_test_failures.txt
mapfile -t listed < <(grep -vE '^\s*(#|$)' "$KNOWN" | tr -d ' \r')
if ((${#listed[@]} == 0)); then
    ok "list is empty"
elif ((WITH_TESTS == 0)); then
    printf '  \033[33mskipped\033[0m %s listed test(s) -- re-run with --with-tests\n' "${#listed[@]}"
else
    filter=""
    for t in "${listed[@]}"; do
        [[ -n "$filter" ]] && filter+=" or "
        filter+="test(=${t})"
    done
    out="$(mktemp)"
    cargo nextest run -p warp --lib --features gui --no-fail-fast -E "$filter" >"$out" 2>&1
    passed="$(sed -E 's/\x1b\[[0-9;]*m//g' "$out" | grep -cE '^\s+PASS ')"
    if ((passed > 0)); then
        fail "$passed listed test(s) now PASS -- delete their lines from $KNOWN in this PR:"
        sed -E 's/\x1b\[[0-9;]*m//g' "$out" | grep -E '^\s+PASS ' | awk '{print "         - "$NF}'
    else
        ok "all ${#listed[@]} listed test(s) still fail (list is accurate)"
    fi
    rm -f "$out"
fi

printf '\n'
if ((status == 0)); then
    printf '\033[32mprecheck: ok\033[0m -- safe to push\n'
else
    printf '\033[31mprecheck: FAILED\033[0m -- fix before pushing; CI will report the same thing 15 minutes later\n'
fi
exit $status
