#!/usr/bin/env python3
"""Drive the real bash bootstrap in a pty under `set -u` and assert the hooks fire.

WHY THIS EXISTS
---------------
#825: with `set -u` at a Phosphor bash prompt, the precmd hook expanded
`$_WARP_GENERATOR_COMMAND` (unset), bash aborted the hook with "unbound
variable", Precmd was never emitted, and the tab locked: Enter and ctrl-c did
nothing and `set +u` could not even be submitted. Nothing in the Rust test
suite runs the bootstrap scripts in a real bash, so this was invisible to it.

The integration test `test_bash_bootstraps_with_nounset_option` covers the same
ground through the app, but it needs a full build and a display. This script
needs only bash and python3 and runs in about ten seconds, so a bootstrap edit
can be checked without cargo.

WHAT IT DOES
------------
Assembles the bootstrap the way `app/src/terminal/bootstrap.rs` does (expand
`#include`, substitute the placeholders, drop comment and blank lines), runs it
as the rcfile of an interactive bash in a pty with an isolated $HOME, decodes
the DCS hook messages the shell writes, and checks, per scenario:

  * every command typed after `set -u` still produces Preexec, CommandFinished
    and Precmd (the lock-up in #825);
  * an in-band generator under `set -u` still ends with its Precmd;
  * the hooks hand the user's own options back: `set -u`/`set -o pipefail`
    stay on, whether set at the prompt or in an rcfile;
  * `$?` and `$_` still reach the next command line unchanged;
  * under `set -e` and under `set -o noclobber` generators and commands keep
    working and the shell stays alive.

A check that waits for a block stops the scenario's waiting once one block has
not finished: the remaining checks report FAIL at once instead of each running
out its timeout.

USAGE
    script/test_bash_bootstrap_nounset [path/to/bash]

Exit 0 when every scenario passes, 1 otherwise.
"""

import os
import pty
import re
import select
import shutil
import sys
import tempfile
import time

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
ASSETS = os.path.join(ROOT, "app", "assets")
BOOTSTRAP = os.path.join(ASSETS, "bundled", "bootstrap")
BASH = sys.argv[1] if len(sys.argv) > 1 else (shutil.which("bash") or "/bin/bash")
SESSION_ID = "4242"
HOOK_RE = re.compile(rb"\x1bP\$d([0-9a-f]*)\x9c")
OSC_RE = re.compile(rb"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
CSI_RE = re.compile(rb"\x1b\[[0-9;?]*[A-Za-z]")


def assemble(text):
    """Mirror bootstrap.rs: inline #include, trim, drop blank and comment lines."""
    out = []
    for line in text.split("\n"):
        if line.startswith("#include "):
            with open(os.path.join(ASSETS, line[len("#include "):])) as f:
                inc = f.read().replace("@@USING_CON_PTY_BOOLEAN@@", "false")
            out.extend(assemble(inc).split("\n"))
            continue
        stripped = line.lstrip()
        if len(stripped) < len(line):
            line = " " + stripped
        line = line.rstrip()
        if not line.strip() or line.strip().startswith("#"):
            continue
        out.append(line)
    return "\n".join(out)


def rcfile_contents():
    with open(os.path.join(BOOTSTRAP, "bash_init_shell.sh")) as f:
        init = f.read()
    init = init.replace("@@WARP_SESSION_ID@@", SESSION_ID).replace(
        "@@USING_CON_PTY_BOOLEAN@@", "false"
    )
    with open(os.path.join(BOOTSTRAP, "bash.sh")) as f:
        body = assemble(f.read())
    return init + "\n" + body + "\n"


class Shell:
    def __init__(self, profile=None, home_prefix="phosphor-825-", bashrc=None, extra=None):
        self.home = tempfile.mkdtemp(prefix=home_prefix)
        for name, body in (extra or {}).items():
            with open(os.path.join(self.home, name), "w") as f:
                f.write(body)
        if bashrc is not None:
            with open(os.path.join(self.home, ".bashrc"), "w") as f:
                f.write(bashrc + "\n")
        if profile is not None:
            with open(os.path.join(self.home, ".bash_profile"), "w") as f:
                f.write(profile + "\n")
        rc = os.path.join(self.home, ".phosphor-rc")
        with open(rc, "w") as f:
            f.write(rcfile_contents())
        env = {
            "HOME": self.home,
            "USER": os.environ.get("USER", "user"),
            "PATH": "/usr/local/bin:/usr/bin:/bin",
            "TERM": "xterm-256color",
            "LANG": "C.UTF-8",
            "WARP_IS_LOCAL_SHELL_SESSION": "1",
        }
        self.pid, self.fd = pty.fork()
        if self.pid == 0:
            os.chdir(self.home)
            os.execve(BASH, [BASH, "--noprofile", "--rcfile", rc, "-i"], env)
        self.buf = b""
        self.dead = False
        self.broken = False

    def pump(self, timeout, until=None):
        end = time.time() + timeout
        while time.time() < end:
            if until is not None and until():
                return True
            r, _, _ = select.select([self.fd], [], [], 0.05)
            if not r:
                continue
            try:
                data = os.read(self.fd, 65536)
            except OSError:
                data = b""
            if not data:
                self.dead = True
                return until() if until else False
            self.buf += data
        return until() if until else False

    def hooks(self):
        names = []
        for m in HOOK_RE.finditer(self.buf):
            payload = bytes.fromhex(m.group(1).decode()).decode(errors="replace")
            h = re.search(r'"hook":\s*"(\w+)"', payload)
            names.append(h.group(1) if h else "?")
        return names

    def hook_json(self, name):
        """The decoded JSON of the first hook called `name`, or None. Raises
        ValueError when the payload is not valid JSON (the app would reject it)."""
        import json
        for m in HOOK_RE.finditer(self.buf):
            payload = bytes.fromhex(m.group(1).decode()).decode(errors="replace")
            h = re.search(r'"hook":\s*"(\w+)"', payload)
            if h and h.group(1) == name:
                return json.loads(payload)
        return None

    def hook_jsons(self, name):
        import json
        out = []
        for m in HOOK_RE.finditer(self.buf):
            payload = bytes.fromhex(m.group(1).decode()).decode(errors="replace")
            h = re.search(r'"hook":\s*"(\w+)"', payload)
            if h and h.group(1) == name:
                out.append(json.loads(payload))
        return out

    def text(self):
        """Output with hook messages and other escape sequences removed."""
        raw = HOOK_RE.sub(b"", self.buf)
        raw = OSC_RE.sub(b"", raw)
        raw = CSI_RE.sub(b"", raw)
        return raw.decode(errors="replace")

    def wait_bootstrapped(self):
        ok = self.pump(20, lambda: "Bootstrapped" in self.hooks())
        self.broken = not ok
        return ok

    def _wait(self, cmd, until, timeout):
        # Fail fast: once one block has not finished, the shell is locked or
        # dead and every later wait would just run out its timeout.
        if getattr(self, "broken", False):
            return False
        os.write(self.fd, (cmd + "\r").encode())
        ok = self.pump(timeout, until)
        if not ok:
            self.broken = True
        return ok

    def run(self, cmd, expect=None, timeout=10):
        """Type a command; wait for the Precmd that ends its block (and for
        `expect`, a regex over the output, when given)."""
        before = self.hooks().count("Precmd")
        return self._wait(
            cmd,
            lambda: self.hooks().count("Precmd") > before
            and (expect is None or re.search(expect, self.text()) is not None),
            timeout,
        )

    def generator(self, n, timeout=10, cmd="echo gen{n}"):
        """Run an in-band generator the way the app does; wait for its output
        and the Precmd that ends it."""
        before = self.hooks().count("Precmd")
        outputs = self.buf.count(b"\x1b]9277;A")
        return self._wait(
            f"warp_run_generator_command {n} '" + cmd.format(n=n) + "'",
            lambda: self.hooks().count("Precmd") > before
            and self.buf.count(b"\x1b]9277;A") > outputs,
            timeout,
        )

    def close(self):
        try:
            os.kill(self.pid, 9)
            os.waitpid(self.pid, 0)
        except OSError:
            pass
        shutil.rmtree(self.home, ignore_errors=True)


failures = []


def check(cond, what, shell):
    if cond:
        print(f"  ok   {what}")
        return
    print(f"  FAIL {what}")
    failures.append(what)
    tail = shell.text()[-1200:]
    print("       hooks: " + " ".join(shell.hooks()[-12:]))
    print("       output tail:\n" + "\n".join("         | " + l for l in tail.splitlines()[-15:]))


def has(shell, pattern):
    return re.search(pattern, shell.text()) is not None


def scenario_set_u_at_prompt():
    print("set -u typed at the prompt")
    sh = Shell()
    try:
        check(sh.wait_bootstrapped(), "bootstraps", sh)
        check(sh.run("set -u"), "the `set -u` block finishes (Precmd)", sh)
        n = len(sh.hooks())
        check(sh.run("echo mark$((40+2))", r"mark42"), "the next command finishes (Precmd)", sh)
        tail = sh.hooks()[n:]
        check(
            tail[:3] == ["Preexec", "CommandFinished", "Precmd"],
            f"it emits Preexec, CommandFinished, Precmd (got {tail})",
            sh,
        )
        check(has(sh, r"mark42"), "its output arrives", sh)
        check(not has(sh, r"_WARP_\w+: unbound variable|WARP_\w+: unbound variable"),
              "no Warp variable is reported unbound", sh)
        check(sh.run('[[ $- == *u* ]] && echo nounset-$((1+1))-on || echo nounset-$((1+1))-off', r"nounset-2-o"), "option probe finishes", sh)
        check(has(sh, r"nounset-2-on"), "nounset is still on for the user afterwards", sh)

        check(sh.run("false"), "`false` finishes", sh)
        check(sh.run('echo "status=$?"', r"status=\d"), "status probe finishes", sh)
        check(has(sh, r"status=1"), "`$?` reaches the next command unchanged", sh)
        check(sh.run("echo lastarg$((6*7))"), "`$_` setup finishes", sh)
        check(sh.run('echo "underscore=$_"', r"underscore=[a-z0-9]"), "`$_` probe finishes", sh)
        check(has(sh, r"underscore=lastarg42"), "`$_` reaches the next command unchanged", sh)

        check(sh.generator(7), "an in-band generator under set -u emits its output and its Precmd", sh)
        check(sh.run("echo after$((1+2))gen", r"after3gen"), "a command after the generator finishes", sh)
        check(has(sh, r"after3gen"), "its output arrives", sh)
        check(sh.run('[[ $- == *u* ]] && echo still-$((2+2))-on || echo still-$((2+2))-off', r"still-4-o"), "option probe finishes", sh)
        check(has(sh, r"still-4-on"), "nounset survives the generator round trip", sh)
    finally:
        sh.close()


def scenario_set_u_in_rcfile():
    print("set -u and pipefail in ~/.bash_profile")
    sh = Shell(profile="set -u\nset -o pipefail")
    try:
        check(sh.wait_bootstrapped(), "bootstraps", sh)
        check(sh.run("echo rc$((3*3))", r"rc9"), "a command finishes (Precmd)", sh)
        check(has(sh, r"rc9"), "its output arrives", sh)
        check(sh.run('[[ $- == *u* ]] && echo rc-nounset-$((5+5))-on || echo rc-nounset-$((5+5))-off', r"rc-nounset-10-o"), "option probe finishes", sh)
        check(has(sh, r"rc-nounset-10-on"), "the rcfile's nounset is in force after bootstrap", sh)
        check(sh.run('[[ -o pipefail ]] && echo rc-pipefail-$((5+6))-on || echo rc-pipefail-$((5+6))-off', r"rc-pipefail-11-o"), "pipefail probe finishes", sh)
        check(has(sh, r"rc-pipefail-11-on"), "the rcfile's pipefail is in force after bootstrap", sh)
    finally:
        sh.close()


def scenario_set_e_trailing_failure_in_rcfile():
    print("set -e in ~/.bash_profile, whose last command returns non-zero")
    # #846: `[ -f ~/.fzf.bash ] && source ~/.fzf.bash` as the last line makes
    # the rcfile, and so the bootstrap's `source`, return 1. Natively that is
    # exempt from errexit; under the bootstrap it killed the shell.
    sh = Shell(profile="set -e\n[ -f /nonexistent-$$ ] && source /nonexistent-$$")
    try:
        check(sh.wait_bootstrapped(), "bootstraps", sh)
        check(not sh.dead, "the shell did not exit", sh)
        check(sh.run("echo rcfail$((3+4))", r"rcfail7"), "a command finishes (Precmd)", sh)
        check(sh.run('[[ $- == *e* ]] && echo rcfail-e-$((1+8))-on || echo rcfail-e-$((1+8))-off', r"rcfail-e-9-o"),
              "option probe finishes", sh)
        check(has(sh, r"rcfail-e-9-on"), "the rcfile's errexit is still in force", sh)
    finally:
        sh.close()


def scenario_set_e_failure_in_rcfile_still_exits():
    print("set -e in ~/.bash_profile: a failing command in the file still exits, as natively")
    sh = Shell(profile="set -e\nfalse\necho not-reached")
    try:
        sh.pump(15, lambda: sh.dead)
        check(sh.dead, "the shell exits", sh)
        check("Bootstrapped" not in sh.hooks(), "it never bootstraps", sh)
    finally:
        sh.close()


def scenario_set_e_nested_source_failure_in_rcfile_still_exits():
    print("set -e in ~/.bash_profile: a failing command inside a sourced file still exits, as natively")
    # (#913 made the nested file's *trailing status* non-fatal; a command that fails in the
    # middle of it must still exit.)
    sh = Shell(profile="set -e\nsource <(echo 'false; echo not-reached')\necho not-reached")
    try:
        sh.pump(15, lambda: sh.dead)
        check(sh.dead, "the shell exits", sh)
        check("Bootstrapped" not in sh.hooks(), "it never bootstraps", sh)
    finally:
        sh.close()


def scenario_nested_rc_trailing_failure():
    print("set -e and a trailing failure in a NESTED rcfile (.bash_profile -> .bashrc)")
    # #913: .bash_profile = `[ -f ~/.bashrc ] && . ~/.bashrc`; .bashrc ends with `set -e` and
    # `[ -f /nope ] && source /nope`. #846 only relaxed errexit for the outermost file, so
    # the nested file's status 1 killed the shell ("exited prematurely").
    fail = "[ -f /nonexistent-$$ ] && source /nonexistent-$$"
    cases = (
        ("profile -> bashrc", "set -e\n" + fail, {}),
        ("three levels", "set -e\n. ~/.bashrc.d-aliases", {".bashrc.d-aliases": "alias ll='ls -l'\n" + fail + "\n"}),
    )
    for label, rc, extra in cases:
        sh = Shell(profile="[ -f ~/.bashrc ] && . ~/.bashrc", bashrc=rc, extra=extra)
        try:
            check(sh.wait_bootstrapped(), f"{label}: bootstraps", sh)
            check(not sh.dead, f"{label}: the shell did not exit", sh)
            check(sh.run("echo nested$((3+4))", r"nested7"), f"{label}: a command finishes (Precmd)", sh)
            check(sh.run('[[ $- == *e* ]] && echo nested-e-$((1+8))-on || echo nested-e-$((1+8))-off', r"nested-e-9-o"),
                  f"{label}: option probe finishes", sh)
            check(has(sh, r"nested-e-9-on"), f"{label}: the rcfile's errexit is back in force", sh)
        finally:
            sh.close()


def scenario_set_e_own_return_trap_trailing_failure():
    print("set -e and its own RETURN trap in ~/.bash_profile, whose last command returns non-zero")
    # #896: the rcfile's `trap ... RETURN` replaced the bootstrap's errexit-relaxing
    # RETURN trap, so the trailing failure killed the shell at bootstrap.
    sh = Shell(profile="set -e\ntrap 'echo UTRET-$((3+4))' RETURN\n[ -f /nonexistent-$$ ] && true")
    try:
        check(sh.wait_bootstrapped(), "bootstraps", sh)
        check(not sh.dead, "the shell did not exit", sh)
        check(has(sh, r"UTRET-7"), "the rcfile's own RETURN trap still ran", sh)
        check(sh.run("echo ownret$((3+4))", r"ownret7"), "a command finishes (Precmd)", sh)
        check(sh.run('[[ $- == *e* ]] && echo ownret-e-$((1+8))-on || echo ownret-e-$((1+8))-off', r"ownret-e-9-o"),
              "option probe finishes", sh)
        check(has(sh, r"ownret-e-9-on"), "the rcfile's errexit is still in force", sh)
        check(sh.run("trap -p RETURN; echo trapdone$((1+1))", r"trapdone2"), "trap probe finishes", sh)
        check(not has(sh, r"UTRET-7[\s\S]*trap -- .*RETURN"), "no RETURN trap is left installed", sh)
    finally:
        sh.close()


def scenario_set_e_own_return_trap_failure_still_exits():
    print("set -e and its own RETURN trap in ~/.bash_profile: a failing command still exits, as natively")
    sh = Shell(profile="set -e\ntrap 'echo UTRET' RETURN\nfalse\necho not-reached")
    try:
        sh.pump(15, lambda: sh.dead)
        check(sh.dead, "the shell exits", sh)
        check("Bootstrapped" not in sh.hooks(), "it never bootstraps", sh)
        check(not has(sh, r"not-reached"), "the command after the failure did not run", sh)
    finally:
        sh.close()


def scenario_return_trap_in_rcfile_function():
    print("a function in ~/.bash_profile that sets its own RETURN trap runs it at its own return, not early")
    # The common cleanup idiom. The trap wrapper must not run the user's command
    # early (when the wrapper itself returns) or twice.
    sh = Shell(profile="f() { trap 'echo FNRET-$((6+1))' RETURN; echo in-f; }\nf\necho after-f\nset -e\n[ -f /nonexistent-$$ ] && true")
    try:
        check(sh.wait_bootstrapped(), "bootstraps", sh)
        check(not sh.dead, "the shell did not exit", sh)
        out = sh.text()
        # A RETURN trap is global and persists, so it fires once more when the
        # `source`d file itself returns: bash does exactly that for `source f`
        # (a native login shell reads the file without a RETURN, hence once).
        # What matters is that it fired at f's return, not early (inside the
        # trap wrapper) and not a third time.
        check(re.search(r"in-f\s+FNRET-7\s+after-f", out) is not None, "it ran at f's return, between in-f and after-f", sh)
        check(out.count("FNRET-7") == 2, f"FNRET ran at f's return and the source's return only (ran {out.count('FNRET-7')})", sh)
    finally:
        sh.close()


NOISE = r"unbound variable|cannot overwrite existing file|syntax error"


def scenario_set_e_at_prompt():
    print("set -e typed at the prompt")
    sh = Shell()
    try:
        check(sh.wait_bootstrapped(), "bootstraps", sh)
        check(sh.run("set -e"), "the `set -e` block finishes (Precmd)", sh)
        check(sh.run("echo e$((1+1))", r"e2"), "the next command finishes (Precmd)", sh)
        # #837: bash-preexec's dispatchers re-set `$?` with a bare `return N`,
        # which tripped errexit inside the hook after any command whose
        # non-zero status errexit itself exempts (`false && true`).
        check(sh.run("false && true"), "`false && true` finishes (Precmd)", sh)
        check(sh.run("echo f$((2+2))", r"f4"), "the next command finishes (Precmd)", sh)
        check(not sh.dead, "the shell survives a non-zero status that errexit exempts", sh)
        # Two generators: the second one's warp_preexec finds the first one's
        # PID already finished, and the kill's non-zero status used to escape
        # warp_preexec and exit the shell.
        check(sh.generator(11), "a generator under set -e emits its output and its Precmd", sh)
        check(sh.run("echo g$((2+3))", r"g5"), "a command after it finishes", sh)
        check(sh.generator(12), "a second generator finishes", sh)
        # Deterministic version of the race: a generator PID recorded as
        # started but already gone. The next user command's warp_preexec
        # tries to kill it, kill fails, and that status used to become
        # warp_preexec's -- exiting the shell under set -e. The generator's own
        # precmd does not reset the PID files, so the bogus PID survives to it.
        before = sh.hooks().count("Precmd")
        outputs = sh.buf.count(b"\x1b]9277;A")
        check(
            sh._wait(
                'echo 2147483646 >> "$_WARP_GENERATOR_PIDS_STARTED_TMP_FILE"; '
                "warp_run_generator_command 13 'echo gen13'",
                lambda: sh.hooks().count("Precmd") > before
                and sh.buf.count(b"\x1b]9277;A") > outputs,
                10,
            ),
            "a stale generator PID is planted",
            sh,
        )
        check(sh.run("echo alive$((9*9))", r"alive81"), "the shell is still alive afterwards", sh)
        check(not sh.dead, "the shell did not exit", sh)
        check(sh.run('[[ $- == *e* ]] && echo errexit-$((3+4))-on || echo errexit-$((3+4))-off',
                     r"errexit-7-o"), "option probe finishes", sh)
        check(has(sh, r"errexit-7-on"), "errexit is still on for the user afterwards", sh)
        check(not has(sh, NOISE), "no hook reports an error", sh)
    finally:
        sh.close()


def scenario_noclobber():
    print("set -o noclobber typed at the prompt")
    sh = Shell()
    try:
        check(sh.wait_bootstrapped(), "bootstraps", sh)
        check(sh.run("set -o noclobber"), "the `set -o noclobber` block finishes (Precmd)", sh)
        # warp_precmd truncates the generator PID files after every command;
        # with plain `>` that fails under noclobber once the files exist.
        check(sh.generator(21), "a generator under noclobber finishes", sh)
        check(sh.run("echo n$((4*4))", r"n16"), "a command after it finishes", sh)
        check(sh.generator(22), "a second generator finishes", sh)
        check(sh.run("echo m$((5*5))", r"m25"), "a command after that finishes", sh)
        check(not has(sh, NOISE), "no hook reports an error", sh)
    finally:
        sh.close()


def scenario_options_untouched_without_set_u():
    print("no strict options: the hooks turn nothing on")
    sh = Shell()
    try:
        check(sh.wait_bootstrapped(), "bootstraps", sh)
        check(sh.run("echo plain$((2*2))", r"plain4"), "a command finishes (Precmd)", sh)
        check(sh.run('echo "opts:$-:"; [[ -o pipefail ]] && echo pipefail-$((1+6))-on || echo pipefail-$((1+6))-off', r"pipefail-7-o"),
              "option probe finishes", sh)
        m = re.search(r"opts:([^:$]*):", sh.text())
        check(m is not None and "u" not in m.group(1) and "e" not in m.group(1),
              f"neither nounset nor errexit was switched on (got {m.group(1) if m else None!r})", sh)
        check(has(sh, r"pipefail-7-off"), "pipefail was not switched on", sh)
    finally:
        sh.close()


def scenario_hostile_home_in_hooks():
    print("a $HOME containing backslash-t reaches the hooks as a backslash, not a tab")
    # #879: home_dir was printed raw, so a valid-looking escape like \\t decoded as a tab.
    sh = Shell(home_prefix="phosphor-879-\\tx\\")
    try:
        check(sh.wait_bootstrapped(), "bootstraps", sh)
        try:
            boot = sh.hook_json("Bootstrapped")
            init = sh.hook_json("InitShell")
        except ValueError as e:
            boot, init = None, None
            print(f"       invalid JSON: {e}")
        check(boot is not None and init is not None, "InitShell and Bootstrapped are valid JSON", sh)
        if boot is not None:
            check(boot["value"]["home_dir"] == sh.home,
                  f"home_dir round-trips exactly (got {boot['value']['home_dir']!r})", sh)
    finally:
        sh.close()


REPLIES = [
    b"\x1b[?62c",  # DA1
    b"\x1b[>0;95;0c",  # DA2
    b"\x1b]10;rgb:ffff/ffff/ffff\x07",  # OSC 10 colour, BEL-terminated
    b"\x1b]11;rgb:0000/0000/0000\x1b\\",  # OSC 11 colour, ST-terminated
    b"\x1b]4;1;rgb:cc/00/00\x07",  # OSC 4 palette
    b"\x1b[24;80R",  # cursor position report
]


def colour_cases():
    """(label, reply) pairs: terminated replies of every width, and unterminated ones."""
    out = []
    for digits, comp in ((1, "f"), (2, "cc"), (3, "fff"), (4, "ffff")):
        body = b"\x1b]11;rgb:" + "/".join([comp] * 3).encode()
        out.append((f"{digits}-digit, BEL", body + b"\x07"))
        out.append((f"{digits}-digit, ESC \\", body + b"\x1b\\"))
    out.append(("2-digit, unterminated", b"\x1b]4;1;rgb:cc/00/00"))
    out.append(("4-digit, unterminated", b"\x1b]10;rgb:ffff/ffff/ffff"))
    # #914: window-op, DECRQM and XTVERSION replies leaked into the next command.
    for label, reply in (
        ("CSI 18t text-area size", b"\x1b[8;45;124t"),
        ("CSI 14t pixel size", b"\x1b[4;800;1000t"),
        ("CSI 19t screen size", b"\x1b[9;50;200t"),
        ("CSI 13t position", b"\x1b[3;0;0t"),
        ("DECRQM", b"\x1b[?2026;2$y"),
        ("XTVERSION", b"\x1bP>|Phosphor(0.1.12)\x1b\\"),
        ("XTVERSION other terminal", b"\x1bP>|xterm(367)\x1b\\"),
    ):
        out.append((label, reply))
    return out


def scenario_terminal_replies_in_typeahead():
    print("replies to terminal queries are not reported as typeahead")
    # #829: replies written while nothing reads them are later read by the line
    # editor as typed text; ESC i reports that text back as the input buffer.
    sh = Shell()
    try:
        check(sh.wait_bootstrapped(), "bootstraps", sh)
        for r in REPLIES:
            sh.pump(0.2)
            os.write(sh.fd, r)
        sh.pump(0.5)
        os.write(sh.fd, b"echo kept")
        sh.pump(0.3)
        os.write(sh.fd, b"\x1bi")
        ok = sh.pump(5, lambda: len(sh.hook_jsons("InputBuffer")) >= 1)
        check(ok, "the input buffer is reported", sh)
        if ok:
            got = sh.hook_jsons("InputBuffer")[-1]["value"]["buffer"]
            check(got is not None and got.endswith("echo kept"), f"the typed text is reported intact (got {got!r})", sh)
        # Typed text that merely looks similar is left alone.
        sh.pump(0.3)
        os.write(sh.fd, b"echo 62c")
        sh.pump(0.3)
        os.write(sh.fd, b"\x1bi")
        ok = sh.pump(5, lambda: len(sh.hook_jsons("InputBuffer")) >= 2)
        if ok:
            got = sh.hook_jsons("InputBuffer")[-1]["value"]["buffer"]
            check(got == "echo 62c", f"ordinary typed text is untouched (got {got!r})", sh)
        else:
            check(False, "the second input buffer is reported", sh)
        # #927: typed text that looks like a reply's residue is never stripped; the app's
        # reply ledger (which knows what it wrote) removes residue, the shell does not guess.
        for typed in ("62c", "1R", "0c", ";1R", "R", "24;80R", "8;45;124t", "1;2$y", ">|x(1)"):
            sh.pump(0.3)
            n = len(sh.hook_jsons("InputBuffer"))
            os.write(sh.fd, typed.encode())
            sh.pump(0.3)
            os.write(sh.fd, b"\x1bi")
            ok = sh.pump(5, lambda: len(sh.hook_jsons("InputBuffer")) > n)
            got = sh.hook_jsons("InputBuffer")[-1]["value"]["buffer"] if ok else None
            check(got == typed, f"typed {typed!r} is reported unchanged (got {got!r})", sh)
        # Text that starts with hex letters right after a reply must survive, whatever the
        # reply's colour width or terminator (an over-greedy strip ate `ec` of `echo`).
        for label, reply in colour_cases():
            sh.pump(0.3)
            n = len(sh.hook_jsons("InputBuffer"))
            os.write(sh.fd, reply)
            sh.pump(0.3)
            os.write(sh.fd, b"echo x")
            sh.pump(0.3)
            os.write(sh.fd, b"\x1bi")
            ok = sh.pump(5, lambda: len(sh.hook_jsons("InputBuffer")) > n)
            got = sh.hook_jsons("InputBuffer")[-1]["value"]["buffer"] if ok else None
            check(got is not None and got.endswith("echo x"), f"colour reply ({label}): the typed text is kept (got {got!r})", sh)
    finally:
        sh.close()


def main():
    print(f"bash: {BASH}")
    scenario_terminal_replies_in_typeahead()
    scenario_hostile_home_in_hooks()
    scenario_set_u_at_prompt()
    scenario_set_u_in_rcfile()
    scenario_set_e_at_prompt()
    scenario_set_e_trailing_failure_in_rcfile()
    scenario_set_e_failure_in_rcfile_still_exits()
    scenario_set_e_nested_source_failure_in_rcfile_still_exits()
    scenario_nested_rc_trailing_failure()
    scenario_set_e_own_return_trap_trailing_failure()
    scenario_set_e_own_return_trap_failure_still_exits()
    scenario_return_trap_in_rcfile_function()
    scenario_noclobber()
    scenario_options_untouched_without_set_u()
    if failures:
        print(f"\ntest_bash_bootstrap_nounset: {len(failures)} check(s) FAILED")
        return 1
    print("\ntest_bash_bootstrap_nounset: ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
