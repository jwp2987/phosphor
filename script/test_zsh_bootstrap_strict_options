#!/usr/bin/env python3
"""Drive the real zsh bootstrap in a pty under err_return/err_exit/nounset.

WHY THIS EXISTS
---------------
#836: with `setopt err_return` / `nounset` in the user's rc the Warp hooks
(warp_preexec, warp_precmd, the title and prompt-var hooks) tripped over their
own expected-failure probes (no git repo, unset variables) and returned early
or died, so Precmd never came and the block never finished.
#844: a user precmd that hits a fatal error (`: ${X:?}`) makes zsh abandon the
rest of the precmd stage, warp_precmd included; the Precmd was lost.
Nothing in the Rust suite runs the bootstrap in a real zsh; the Rust test only
greps for the guard lines. This script is the behavioural check, and needs only
zsh and python3 (no cargo).

WHAT IT DOES
------------
Assembles zsh_body.sh the way `app/src/terminal/bootstrap.rs` does (expand
`#include`, substitute @@USING_CON_PTY_BOOLEAN@@ with false, drop comment and
blank lines), starts an interactive zsh in a pty with an isolated ZDOTDIR whose
.zshrc/.zshenv carry the scenario's options, sources the assembled body, then
types `false`, `sh -c "exit 7"`, `true` and asserts each yields Preexec,
CommandFinished (exit 1 / 7 / 0) and Precmd. Under `setopt err_exit` it asserts
the bootstrap completes and `echo hi` gets a full cycle.

USAGE
    script/test_zsh_bootstrap_strict_options [--body path/to/zsh_body.sh] [path/to/zsh]

--body substitutes another zsh_body.sh (e.g. `git show main:...` output) to
prove the script fails against the unfixed bootstrap.

Exit 0 when every scenario passes, 1 otherwise.
"""

import json
import os
import pty
import re
import select
import shlex
import shutil
import sys
import tempfile
import time

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
ASSETS = os.path.join(ROOT, "app", "assets")
BODY = os.path.join(ASSETS, "bundled", "bootstrap", "zsh_body.sh")
args = sys.argv[1:]
if len(args) >= 2 and args[0] == "--body":
    BODY = os.path.abspath(args[1])
    args = args[2:]
ZSH = args[0] if args else (shutil.which("zsh") or "/bin/zsh")
HOOK_RE = re.compile(rb"\x1bP\$d([0-9a-f]*)\x9c")
OSC_RE = re.compile(rb"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
CSI_RE = re.compile(rb"\x1b\[[0-9;?]*[A-Za-z]")


def assemble(text):
    """Mirror bootstrap.rs: inline #include, trim, drop blank and comment lines."""
    out = []
    for line in text.split("\n"):
        if line.startswith("#include "):
            with open(os.path.join(ASSETS, line[len("#include "):])) as f:
                out.extend(assemble(f.read()).split("\n"))
            continue
        stripped = line.lstrip()
        if len(stripped) < len(line):
            line = " " + stripped
        line = line.rstrip()
        if not line.strip() or line.strip().startswith("#"):
            continue
        out.append(line)
    return "\n".join(out)


def body_contents():
    with open(BODY) as f:
        text = assemble(f.read())
    return text.replace("@@USING_CON_PTY_BOOLEAN@@", "false") + "\n"


class Shell:
    def __init__(self, zshrc, zshenv="", home_prefix="phosphor-836-"):
        self.home = tempfile.mkdtemp(prefix=home_prefix)
        self.zd = os.path.join(self.home, "zdot")
        self.cwd = os.path.join(self.home, "nogit")  # deliberately not a git repo
        os.makedirs(self.zd)
        os.makedirs(self.cwd)
        with open(os.path.join(self.zd, ".zshrc"), "w") as f:
            f.write(zshrc + "\n")
        with open(os.path.join(self.zd, ".zshenv"), "w") as f:
            f.write(zshenv + "\n")
        self.body = os.path.join(self.home, "body.sh")
        with open(self.body, "w") as f:
            f.write(body_contents())
        env = {
            "HOME": self.home,
            "ZDOTDIR": self.zd,
            "USER": os.environ.get("USER", "user"),
            "PATH": "/usr/local/bin:/usr/bin:/bin",
            "TERM": "xterm-256color",
            "LANG": "C.UTF-8",
            "WARP_IS_LOCAL_SHELL_SESSION": "1",
            "PS1": "%# ",
        }
        self.pid, self.fd = pty.fork()
        if self.pid == 0:
            os.chdir(self.cwd)
            # Same startup as shell.rs: minimal rcs; the bootstrap sources the user's
            # own .zshenv/.zshrc from $ZDOTDIR itself.
            os.execve(ZSH, [ZSH, "-g", "--no-rcs", "-i"], env)
        self.buf = b""
        self.dead = False
        self.broken = False

    def pump(self, timeout, until=None):
        end = time.time() + timeout
        while time.time() < end:
            if until is not None and until():
                return True
            r, _, _ = select.select([self.fd], [], [], 0.05)
            if not r:
                continue
            try:
                data = os.read(self.fd, 65536)
            except OSError:
                data = b""
            if not data:
                self.dead = True
                return until() if until else False
            self.buf += data
        return until() if until else False

    def hooks(self):
        """List of (name, value-dict) for every DCS hook message so far."""
        out = []
        for m in HOOK_RE.finditer(self.buf):
            try:
                j = json.loads(bytes.fromhex(m.group(1).decode()))
            except ValueError:
                continue
            out.append((j.get("hook", "?"), j.get("value") or {}))
        return out

    def invalid_hooks(self):
        """Count of DCS hook messages whose payload is not valid JSON (the app rejects them)."""
        bad = 0
        for m in HOOK_RE.finditer(self.buf):
            try:
                json.loads(bytes.fromhex(m.group(1).decode()))
            except ValueError:
                bad += 1
        return bad

    def names(self):
        return [n for n, _ in self.hooks()]

    def text(self):
        raw = HOOK_RE.sub(b"", self.buf)
        raw = OSC_RE.sub(b"", raw)
        raw = CSI_RE.sub(b"", raw)
        return raw.decode(errors="replace")

    def bootstrap(self):
        """Source the assembled body the way the init script does, wait for it."""
        self.pump(1.5)  # let the rc files and the first prompt settle
        os.write(
            self.fd,
            (f"unsetopt ZLE; WARP_SESSION_ID=4242; WARP_USING_WINDOWS_CON_PTY=false; source {shlex.quote(self.body)}; echo boot$((20+22))done\r").encode(),
        )
        ok = self.pump(20, lambda: "boot42done" in self.text() and "Bootstrapped" in self.names())
        self.broken = not ok
        self.pump(1.5)  # the bootstrap command's own Precmd and prompt
        return ok

    def cycle(self, cmd, timeout=5):
        """Type a command; return the (name, value) hooks it produced, waiting
        for its Precmd. Returns None if the shell stops responding."""
        if self.broken:
            return None
        n = len(self.hooks())
        before = self.names().count("Precmd")
        os.write(self.fd, (cmd + "\r").encode())
        ok = self.pump(timeout, lambda: self.names().count("Precmd") > before)
        if not ok:
            self.broken = True
            return self.hooks()[n:]
        self.pump(0.2)
        return self.hooks()[n:]

    def close(self):
        try:
            os.kill(self.pid, 9)
            os.waitpid(self.pid, 0)
        except OSError:
            pass
        shutil.rmtree(self.home, ignore_errors=True)


failures = []
NOISE_RE = re.compile(r"parameter not set|unbound variable|no such variable")


def check(cond, what, shell):
    if cond:
        print(f"  ok   {what}")
        return
    print(f"  FAIL {what}")
    failures.append(what)
    print("       hooks: " + " ".join(shell.names()[-12:]))
    tail = shell.text()[-1000:]
    print("       output tail:\n" + "\n".join("         | " + l for l in tail.splitlines()[-12:]))


def check_cycle(sh, cmd, want_exit):
    got = sh.cycle(cmd)
    names = [n for n, _ in got] if got is not None else []
    check(
        names[:3] == ["Preexec", "CommandFinished", "Precmd"],
        f"`{cmd}` emits Preexec, CommandFinished, Precmd (got {names})",
        sh,
    )
    if want_exit is not None:
        codes = [v.get("exit_code") for n, v in (got or []) if n == "CommandFinished"]
        check(codes[:1] == [want_exit], f"`{cmd}` exit code is {want_exit} (got {codes})", sh)


def scenario(title, zshrc, zshenv=""):
    print(title)
    sh = Shell(zshrc, zshenv)
    try:
        check(sh.bootstrap(), "bootstraps", sh)
        check_cycle(sh, "false", 1)
        check_cycle(sh, 'sh -c "exit 7"', 7)
        check_cycle(sh, "true", 0)
        # Under nounset the bootstrap itself must not print "parameter not set"
        # for HISTFILE, EDITOR or WARP_USING_WINDOWS_CON_PTY (zsh reports it and
        # carries on, so the hooks still arrive; it is just noise on every start).
        check(NOISE_RE.search(sh.text()) is None,
              "no 'parameter not set' / unbound noise is printed", sh)
    finally:
        sh.close()


def scenario_hostile_home():
    print("a $HOME containing backslash-t reaches the hooks as a backslash, not a tab")
    # #879: home_dir was printed raw, so a valid-looking escape like \\t decoded as a tab.
    sh = Shell("", home_prefix="phosphor-879-\\tx\\")
    try:
        check(sh.bootstrap(), "bootstraps", sh)
        check(sh.invalid_hooks() == 0, "every hook payload is valid JSON", sh)
        boot = [v for n, v in sh.hooks() if n == "Bootstrapped"]
        check(bool(boot) and boot[0].get("home_dir") == sh.home,
              f"home_dir round-trips exactly (got {boot[0].get('home_dir') if boot else None!r})", sh)
    finally:
        sh.close()


def scenario_err_exit():
    print("setopt err_exit in .zshrc")
    sh = Shell("setopt err_exit")
    try:
        check(sh.bootstrap(), "bootstraps", sh)
        check_cycle(sh, "echo hi", 0)
        check(not sh.dead, "the shell did not exit", sh)
    finally:
        sh.close()


def scenario_errexit_repair_agent_rc():
    """#855: errexit plus a prompt cycle that skipped warp_precmd forces the repair path
    (#844/#828), which passes the wrapper tail's $? (0) as $1; the agent command's real
    status (7) lives in __phosphor_ap_rc and must win."""
    print("setopt err_exit + skipped precmd (repair path) + wrapped agent command exiting 7")
    sh = Shell("setopt err_exit")
    try:
        check(sh.bootstrap(), "bootstraps", sh)
        # The command empties precmd_functions, so its own precmd stage runs nothing and
        # the Precmd is owed; the repair (zshaddhistory of the next line) emits it.
        wrapped = (
            'precmd_functions=(); { sh -c "exit 7"; } && __phosphor_ap_rc=0 || __phosphor_ap_rc=$?; '
            'if case $- in *e*) true;; *) [[ -o errreturn ]];; esac; then :; '
            'else eval "unset __phosphor_ap_rc; (exit $__phosphor_ap_rc)"; fi'
        )
        n = len(sh.hooks())
        os.write(sh.fd, (wrapped + "\r").encode())
        sh.pump(1.0)
        got = sh.cycle("true")
        codes = [v.get("exit_code") for name, v in sh.hooks()[n:] if name == "CommandFinished"]
        check(codes[:1] == [7], f"the agent command's CommandFinished reports 7 (got {codes})", sh)
        check(not sh.dead, "the shell did not exit", sh)
    finally:
        sh.close()


REPLIES = [
    b"\x1b[?62c",  # DA1
    b"\x1b[>0;95;0c",  # DA2
    b"\x1b]10;rgb:ffff/ffff/ffff\x07",  # OSC 10 colour, BEL-terminated
    b"\x1b]11;rgb:0000/0000/0000\x1b\\",  # OSC 11 colour, ST-terminated
    b"\x1b]4;1;rgb:cc/00/00\x07",  # OSC 4 palette
    b"\x1b[24;80R",  # cursor position report
]


def colour_cases():
    """(label, reply) pairs: terminated replies of every width, and unterminated ones."""
    out = []
    for digits, comp in ((1, "f"), (2, "cc"), (3, "fff"), (4, "ffff")):
        body = b"\x1b]11;rgb:" + "/".join([comp] * 3).encode()
        out.append((f"{digits}-digit, BEL", body + b"\x07"))
        out.append((f"{digits}-digit, ESC \\", body + b"\x1b\\"))
    out.append(("2-digit, unterminated", b"\x1b]4;1;rgb:cc/00/00"))
    out.append(("4-digit, unterminated", b"\x1b]10;rgb:ffff/ffff/ffff"))
    return out


def scenario_terminal_replies_in_typeahead():
    print("replies to terminal queries are not reported as typeahead")
    # #829: replies written while nothing reads them are later read by zle as
    # typed text; ESC i reports that text back as the input buffer.
    sh = Shell("")
    try:
        check(sh.bootstrap(), "bootstraps", sh)
        for r in REPLIES:
            sh.pump(0.2)
            os.write(sh.fd, r)
        sh.pump(0.5)
        os.write(sh.fd, b"echo kept")
        sh.pump(0.3)
        n = len([1 for h, _ in sh.hooks() if h == "InputBuffer"])
        os.write(sh.fd, b"\x1bi")
        ok = sh.pump(5, lambda: len([1 for h, _ in sh.hooks() if h == "InputBuffer"]) > n)
        check(ok, "the input buffer is reported", sh)
        if ok:
            got = [v for h, v in sh.hooks() if h == "InputBuffer"][-1]["buffer"]
            check(got == "echo kept", f"only the typed text is reported (got {got!r})", sh)
        n = len([1 for h, _ in sh.hooks() if h == "InputBuffer"])
        sh.pump(0.3)
        os.write(sh.fd, b"echo 62c")
        sh.pump(0.3)
        os.write(sh.fd, b"\x1bi")
        ok = sh.pump(5, lambda: len([1 for h, _ in sh.hooks() if h == "InputBuffer"]) > n)
        if ok:
            got = [v for h, v in sh.hooks() if h == "InputBuffer"][-1]["buffer"]
            check(got == "echo 62c", f"ordinary typed text is untouched (got {got!r})", sh)
        else:
            check(False, "the second input buffer is reported", sh)
        # Text that starts with hex letters right after a reply must survive, whatever the
        # reply's colour width or terminator (an over-greedy strip ate `ec` of `echo`).
        for label, reply in colour_cases():
            sh.pump(0.3)
            n = len([1 for h, _ in sh.hooks() if h == "InputBuffer"])
            os.write(sh.fd, reply)
            sh.pump(0.3)
            os.write(sh.fd, b"echo x")
            sh.pump(0.3)
            os.write(sh.fd, b"\x1bi")
            ok = sh.pump(5, lambda: len([1 for h, _ in sh.hooks() if h == "InputBuffer"]) > n)
            got = [v for h, v in sh.hooks() if h == "InputBuffer"][-1]["buffer"] if ok else None
            check(got == "echo x", f"colour reply ({label}) is stripped, text kept (got {got!r})", sh)
    finally:
        sh.close()


def main():
    print(f"zsh: {ZSH}\nbody: {BODY}")
    scenario_terminal_replies_in_typeahead()
    scenario("setopt err_return", "setopt err_return")
    scenario("setopt nounset", "setopt nounset")
    scenario("setopt err_return nounset", "setopt err_return nounset")
    scenario(".zshenv with setopt err_return nounset", "", "setopt err_return nounset")
    scenario(
        "a user precmd that dies with ${NOPE:?boom}",
        "_user_precmd() { : ${NOPE:?boom}; }\nprecmd_functions+=(_user_precmd)",
    )
    scenario_err_exit()
    scenario_errexit_repair_agent_rc()
    scenario_hostile_home()
    if failures:
        print(f"\ntest_zsh_bootstrap_strict_options: {len(failures)} check(s) FAILED")
        return 1
    print("\ntest_zsh_bootstrap_strict_options: ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
