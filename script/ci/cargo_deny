#!/usr/bin/env bash
# script/ci/cargo_deny <licenses|advisories>: the CI `licenses` / `advisories` gates (#1518).
#
# 1. cargo-deny is PINNED (CARGO_DENY_VERSION) and installed into the job's CARGO_HOME (the runner's own
#    ~/.cargo-ci on the box) only when that exact version is not already there. It used to be
#    `cargo binstall --force -y cargo-deny` on every run: a GitHub/crates.io hiccup turned the pipeline red,
#    and an unpinned new release could change verdicts without a commit. If the install fails but SOME
#    cargo-deny is present, that one is used with a warning (a fetch outage is not a code failure).
# 2. advisories: the RustSec DB is fetched first (`cargo deny fetch db`). When the fetch fails and the cached
#    DB in $CARGO_HOME/advisory-dbs was last refreshed by this script less than MAX_STALE_DAYS ago, the check
#    runs against the cache (root `--offline`; `check --disable-fetch` is gone since 0.20) and says so loudly; a real finding still fails the job. With no
#    cache, or a cache older than that, the job fails (script/ci/ci_seq.py classifies the trace as NETWORK-FAIL).
# Bump CARGO_DENY_VERSION by hand, in its own commit, after reading the cargo-deny changelog.
set -euo pipefail
cd "$(dirname "$0")/../.."

CARGO_DENY_VERSION="0.20.2"
MAX_STALE_DAYS=7
what="${1:?usage: script/ci/cargo_deny licenses|advisories}"

cargo_home="${CARGO_HOME:-$HOME/.cargo}"
stamp="$cargo_home/.phosphor-advisory-db-fetched"

have="$(cargo deny --version 2>/dev/null || true)"
if [[ "$have" != "cargo-deny $CARGO_DENY_VERSION" ]]; then
    echo "cargo_deny: installing cargo-deny $CARGO_DENY_VERSION (have: ${have:-none})"
    if ! { ./script/install_cargo_binstall && cargo binstall --force -y "cargo-deny@$CARGO_DENY_VERSION"; }; then
        if [[ -n "$have" ]]; then
            echo "cargo_deny: WARNING could not install cargo-deny $CARGO_DENY_VERSION (network?); using the installed $have" >&2
        else
            echo "cargo_deny: ERROR could not install cargo-deny $CARGO_DENY_VERSION and none is installed (failed to download)" >&2
            exit 1
        fi
    fi
fi
echo "cargo_deny: $(cargo deny --version)"

case "$what" in
licenses)
    cargo deny -L error check licenses sources
    ;;
advisories)
    if cargo deny fetch db; then
        touch "$stamp"
        # just fetched. cargo-deny 0.20 removed `check --disable-fetch` (PR#881); its replacement, the root `--offline`,
        # also forbids cargo's own crate downloads, so the online check (one more DB fetch) is the safe call here.
        cargo deny -L error check advisories
    elif [[ -f "$stamp" ]] && [[ -n "$(find "$stamp" -mtime "-$MAX_STALE_DAYS" 2>/dev/null)" ]]; then
        echo "cargo_deny: WARNING the advisory DB fetch failed; checking against the CACHED DB (last fetched $(date -r "$stamp" -u +%FT%TZ), < $MAX_STALE_DAYS days). New advisories since then are NOT seen." >&2
        cargo deny -L error --offline check advisories   # 0.20: root --offline replaces check --disable-fetch (PR#881)
    else
        echo "cargo_deny: ERROR the advisory DB fetch failed and there is no cached DB fetched in the last $MAX_STALE_DAYS days (failed to fetch)" >&2
        exit 1
    fi
    ;;
*)
    echo "cargo_deny: unknown gate '$what' (licenses|advisories)" >&2
    exit 2
    ;;
esac
