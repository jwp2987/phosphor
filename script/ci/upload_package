#!/usr/bin/env bash
#
# Upload files to this project's GENERIC PACKAGE REGISTRY (CI only).
#
#   script/ci/upload_package <version> <file>...
#
# Files land at
#   $CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/phosphor/<version>/<file name>
# which is what the release links point at. Installers go here instead of being
# passed between jobs as artifacts: they are 100-180 MB each and job artifacts are
# size-limited, while a package file may be several GB.
#
# Auth is the job's own token (CI_JOB_TOKEN), so nothing secret is stored anywhere.
#
# REAL RELEASES ONLY. The package registry of a public project is publicly readable, so a
# dry run (a manual run on main, version dev-<n>) must not publish unreleased builds there.
# Outside a tag pipeline this logs and does nothing; the jobs also keep their files as
# job artifacts, which are visible to project members only.
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "usage: $0 <version> <file>..." >&2
  exit 2
fi
if [[ -z "${CI_COMMIT_TAG:-}" ]]; then
  echo "not a tag pipeline: skipping the package-registry upload of $(($# - 1)) file(s) (dry run)"
  exit 0
fi
: "${CI_JOB_TOKEN:?must run inside a GitLab CI job}"
: "${CI_API_V4_URL:?must run inside a GitLab CI job}"
: "${CI_PROJECT_ID:?must run inside a GitLab CI job}"

version="$1"
shift
# Package versions allow letters, digits and . _ - + only; a tag like v0.1.15-beta.1 is fine.
[[ "$version" =~ ^[A-Za-z0-9._+-]+$ ]] || { echo "ERROR bad package version: $version" >&2; exit 2; }

for file in "$@"; do
  [[ -f "$file" ]] || { echo "ERROR no such file: $file" >&2; exit 1; }
  name="$(basename "$file")"
  url="${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/packages/generic/phosphor/${version}/${name}"
  echo "uploading ${name} ($(wc -c < "$file") bytes)"
  curl --fail --silent --show-error --retry 3 --retry-delay 5 \
    --header "JOB-TOKEN: ${CI_JOB_TOKEN}" --upload-file "$file" "$url" >/dev/null
  echo "  -> ${url}"
done
