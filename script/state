#!/usr/bin/env bash
# Generate docs/STATE.md -- the single answer to "where are we".
#
# WHY THIS IS GENERATED AND NOT WRITTEN
# -------------------------------------
# Four documents used to partly answer this question (TODO.md, HANDOFF.md,
# SWEEP-SUMMARY.md, SCOPE-*.md) and they contradicted each other constantly.
# On 2026-08-10 alone: twelve in-tree documents were found contradicting the
# code, four ledger entries stated the opposite of the tree, the SCOPE-*.md
# summary tables did not sum to their own per-file sections, and a section
# headed "highlights" was read as a complete set.
#
# A hand-written status file drifts, and a drifted summary is worse than none
# because people trust it. So every number here is derived at run time from a
# primary source -- the verdict ledger, git, the checkbox counts, the guards --
# and nothing is typed in by hand. If a number here is wrong, its SOURCE is
# wrong, which is the property we want.
#
# What must NOT be added to this file: decisions (they belong in DECLINED.md,
# where a guard can check them), lessons (HANDOFF.md), evidence (docs/sweep/).
# The moment this file carries prose, it stops being regenerable and becomes
# the thirteenth contradicting document.
#
# USAGE
#     script/state              # write docs/STATE.md
#     script/state --check      # exit 1 if docs/STATE.md is out of date
#
# The --check form is wired into script/precheck and pr-check.yml.

set -uo pipefail
cd "$(dirname "$0")/.."

CHECK=0
[[ "${1:-}" == "--check" ]] && CHECK=1

OUT="docs/STATE.md"
TMP="$(mktemp)"
trap 'rm -rf "$TMP" "$TMP".*' EXIT

# Read the pin from ORACLE.md's "Commit (full)" row, the same way
# .github/workflows/pr-check.yml does. This used to be a sed that matched the
# literal `02b53fcd8` and fell back to it, so it kept reporting against the old
# pin after a re-pin moved ORACLE.md -- silently, and STATE.md is the document
# the other docs are supposed to defer to. Fail loudly instead of guessing.
PIN="$(grep -oE '\*\*Commit \(full\)\*\* \| `[0-9a-f]{40}`' ORACLE.md | grep -oE '[0-9a-f]{40}' | head -1)"
if [[ -z "$PIN" ]]; then
    echo "state: ORACLE.md has no 40-char '**Commit (full)**' row; cannot measure parity" >&2
    exit 1
fi
if ! git cat-file -e "$PIN^{commit}" 2>/dev/null; then
    echo "state: pin $PIN is not a fetched object; run 'git fetch warp' first" >&2
    exit 1
fi
LEDGER=docs/sweep-verdict-ledger.tsv

# ---------------------------------------------------------------- parity
# Test-name diff against the pin. This is a NAME comparison: a shared name is
# not proof of a shared assertion, which is why the number is reported as an
# approximation and why the ledger, not this, is the authority on any single
# test.
# Keep the defining file alongside each pin test name. The names alone answer
# "is it absent"; the file answers "is it absent because we deleted the whole
# subsystem", which is a different question and the one that matters -- see the
# split below.
#
# NOT EVERY TEST IS SPELLED `#[test] fn <name>`
# ---------------------------------------------
# This used to be a single `git grep` for `#[test]`, and it under-counted BOTH
# sides in two independent ways (measured 2026-08-18). Every parity percentage
# this project has ever published was computed over the short count.
#
#   1. `crates/integration` was entirely invisible -- 319 tests at the pin, and
#      more here, counted as ZERO. The crate declares its tests by name in
#      `integration_tests! { ... }` and implements them behind
#      `register_test!(<name>)` in `src/bin/integration.rs`. The `#[test]` item
#      nextest actually runs is generated inside the macro body, so no `#[test]`
#      is ever written next to a test's real name.
#
#   2. Three more `macro_rules!` emit `#[test] fn $name()`. The literal
#      `#[test]` again sits in the macro BODY, so the only name the grep could
#      see was whatever the body happened to spell -- and ~57 real tests
#      collapsed to ONE placeholder (`test_name`, from the `concat_idents!`
#      inside `define_axis_agnostic_tests!`). `ref_tests!` (39 names),
#      `input_mode_prefix_tests!` and `define_axis_agnostic_tests!` (2 per
#      invocation) contributed nothing but that placeholder.
#
# So the extraction is now three steps: grep `#[test]` as before, SUBTRACT the
# names that were read out of a macro body rather than off a real item, and ADD
# the names those macros actually generate, expanded from their invocation
# lists. All of it runs identically against the pin and against HEAD, so a
# macro that exists on both sides cancels out of the diff instead of showing up
# as fake debt.
#
# `register_test!` -- not the `integration_tests!` lists -- is the source for
# the integration crate because it is the superset of the two:
# `script/check_integration_test_registry` FAILS if a listed name is not
# registered, while `register_tests()` deliberately carries entries no automatic
# suite runs (`test_video_recording`, the `usage_*` scenarios). Counting the
# registry therefore counts every integration test that exists.
#
# HOW A FOURTH SUCH MACRO GETS NOTICED
# Hard-coding three macro names is exactly the shape of mistake that hid this
# for months, so the scan does not trust its own list: it reports EVERY
# `macro_rules!` whose body contains a `#[test]`, and warns about any that this
# script does not know how to expand. If that warning fires, teach the expander
# about the new macro. Do not silence it, and do not add it to the allowlist
# without an expander -- the allowlist means "handled", not "seen".

# Macros whose generated tests are expanded below. `integration_tests` is here
# because its names are covered via `register_test!`, see above.
MACRO_TEST_ALLOWLIST=" ref_tests input_mode_prefix_tests define_axis_agnostic_tests integration_tests "

# Walks a Rust file and reports, for every `macro_rules!` whose body contains a
# `#[test]` attribute:  DEF <file> <macro>, plus  INNER <file> <fn> for each
# `fn <name>` written inside that body. The INNER names are the placeholders the
# old grep mistook for tests; they are subtracted, per (name, file) pair, so a
# real test elsewhere that happens to share the name survives.
#
# Brace counting, not a parser: braces inside string literals would throw it
# off. No macro in this tree does that, and the cost of being wrong is a
# spurious warning, not a wrong number.
MACRO_SCAN_AWK='
function flush(  i) {
    if (hit) {
        print "DEF\t" FILE "\t" mname
        for (i = 1; i <= nfn; i++) print "INNER\t" FILE "\t" fns[i]
    }
    inmac = 0; hit = 0; nfn = 0; opened = 0; mname = ""
}
{
    line = $0
    sub(/\/\/.*/, "", line)
    if (!inmac) {
        if (line !~ /macro_rules![ \t]*[A-Za-z_]/) next
        inmac = 1; depth = 0; hit = 0; nfn = 0; opened = 0
        mname = line
        sub(/^.*macro_rules![ \t]*/, "", mname)
        sub(/[^A-Za-z0-9_].*$/, "", mname)
    }
    depth += gsub(/\{/, "{", line)
    depth -= gsub(/\}/, "}", line)
    if (line ~ /\{/) opened = 1
    if (line ~ /#\[(tokio::)?(async_std::)?test/) hit = 1
    rest = line
    while (match(rest, /(^|[^A-Za-z0-9_])fn [a-z0-9_]+/)) {
        frag = substr(rest, RSTART, RLENGTH)
        sub(/^.*fn /, "", frag)
        fns[++nfn] = frag
        rest = substr(rest, RSTART + RLENGTH)
    }
    if (opened && depth <= 0) flush()
}
END { if (inmac) flush() }
'

# `ref_tests! { name name ... }` -- a bare whitespace-separated ident list.
REF_TESTS_AWK='
/^[ \t]*ref_tests![ \t]*\{/ { d = 1; next }
d && /^[ \t]*\}/ { d = 0; next }
d {
    l = $0; sub(/\/\/.*/, "", l)
    n = split(l, a, /[ \t,]+/)
    for (i = 1; i <= n; i++) if (a[i] ~ /^[A-Za-z_][A-Za-z0-9_]*$/) print a[i] "\t" FILE
}
'

# `input_mode_prefix_tests! { name: (args), ... }` -- ident before the colon.
INPUT_MODE_TESTS_AWK='
/^[ \t]*input_mode_prefix_tests![ \t]*\{/ { d = 1; next }
d && /^[ \t]*\}/ { d = 0; next }
d {
    l = $0; sub(/\/\/.*/, "", l); gsub(/[ \t]/, "", l)
    if (match(l, /^[A-Za-z_][A-Za-z0-9_]*:/)) print substr(l, 1, RLENGTH - 1) "\t" FILE
}
'

# `define_axis_agnostic_tests!(f);` -- generates `f_vertical` and `f_horizontal`
# via `concat_idents!`. The `macro_rules!` line itself has no `(` after the `!`,
# so the definition cannot match this.
AXIS_TESTS_AWK='
{
    rest = $0
    while (match(rest, /define_axis_agnostic_tests!\([A-Za-z_][A-Za-z0-9_]*\)/)) {
        n = substr(rest, RSTART, RLENGTH)
        sub(/^define_axis_agnostic_tests!\(/, "", n); sub(/\)$/, "", n)
        print n "_vertical\t" FILE
        print n "_horizontal\t" FILE
        rest = substr(rest, RSTART + RLENGTH)
    }
}
'

# Paths at rev $1 whose contents match ERE $2, with the `<rev>:` prefix stripped.
rev_files() { git grep -lE "$2" "$1" -- "*.rs" 2>/dev/null | sed "s|^$1:||" | LC_ALL=C sort -u; }

# Run awk program $3 over every file at rev $1 matching ERE $2, with FILE set.
expand_macro() {
    local rev="$1" pat="$2" prog="$3" f
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        git show "$rev:$f" 2>/dev/null | awk -v FILE="$f" "$prog"
    done < <(rev_files "$rev" "$pat")
}

# extract_test_map <rev> <out>
# Writes `<name>\t<defining file>` to <out>, and the two generated subsets to
# <out>.reg (integration registry) and <out>.mac (test-emitting macros) so the
# document can show its work. Unexpanded test-emitting macros go to <out>.warn.
extract_test_map() {
    local rev="$1" out="$2" d f
    d="$(mktemp -d "${TMP}.dir.XXXXXX")"

    git grep -n -A 3 -E '^\s*#\[(tokio::)?(async_std::)?test' "$rev" -- "*.rs" 2>/dev/null \
        | sed -nE "s/^${rev}:([^:]+)[:-][0-9]+[:-].*\bfn ([a-z0-9_]+).*/\2\t\1/p" \
        | LC_ALL=C sort -u > "$d/plain"

    # Only files that define a macro AND contain a `#[test]` can be affected.
    LC_ALL=C comm -12 <(rev_files "$rev" 'macro_rules!') \
                      <(rev_files "$rev" '^\s*#\[(tokio::)?(async_std::)?test') > "$d/cands"
    : > "$d/scan"
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        git show "$rev:$f" 2>/dev/null | awk -v FILE="$f" "$MACRO_SCAN_AWK" >> "$d/scan"
    done < "$d/cands"

    awk -F'\t' '$1 == "INNER" { print $3 "\t" $2 }' "$d/scan" | LC_ALL=C sort -u > "$d/inner"
    LC_ALL=C comm -23 "$d/plain" "$d/inner" > "$d/base"

    awk -F'\t' -v ok="$MACRO_TEST_ALLOWLIST" \
        '$1 == "DEF" && index(ok, " " $3 " ") == 0 { print $2 "\t" $3 }' \
        "$d/scan" | LC_ALL=C sort -u > "$out".warn

    git grep -oE 'register_test!\([A-Za-z_][A-Za-z0-9_]*\)' "$rev" -- "*.rs" 2>/dev/null \
        | sed -nE "s/^${rev}:([^:]+):register_test!\(([A-Za-z0-9_]+)\)/\2\t\1/p" \
        | LC_ALL=C sort -u > "$out".reg

    {
        expand_macro "$rev" 'ref_tests!' "$REF_TESTS_AWK"
        expand_macro "$rev" 'input_mode_prefix_tests!' "$INPUT_MODE_TESTS_AWK"
        expand_macro "$rev" 'define_axis_agnostic_tests!' "$AXIS_TESTS_AWK"
    } | LC_ALL=C sort -u > "$out".mac

    LC_ALL=C sort -u "$d/base" "$out".reg "$out".mac > "$out"
    rm -rf "$d"
}

extract_test_map "$PIN" "$TMP".pinmap
cut -f1 "$TMP".pinmap | LC_ALL=C sort -u > "$TMP".pin
extract_test_map HEAD "$TMP".forkmap
cut -f1 "$TMP".forkmap | LC_ALL=C sort -u > "$TMP".fork

# A `macro_rules!` that emits `#[test]` and has no expander here is silently
# uncounted -- the exact bug this section exists to fix. Say so, loudly, on both
# stderr and in the document, and never fail closed into a smaller number.
LC_ALL=C sort -u "$TMP".pinmap.warn "$TMP".forkmap.warn > "$TMP".macrowarn
MACRO_WARN=""
if [[ -s "$TMP".macrowarn ]]; then
    MACRO_WARN=$(sed 's/\t/` — `/; s/^/> - `/; s/$/`/' "$TMP".macrowarn)
    {
        echo "state: WARNING -- macro_rules! that emit #[test] but are not expanded by this script:"
        sed 's/^/  /' "$TMP".macrowarn
        echo "  Their tests are being under-counted. Add an expander to script/state."
    } >&2
fi
PIN_REG=$(cut -f1 "$TMP".pinmap.reg | LC_ALL=C sort -u | wc -l)
FORK_REG=$(cut -f1 "$TMP".forkmap.reg | LC_ALL=C sort -u | wc -l)
PIN_MAC=$(cut -f1 "$TMP".pinmap.mac | LC_ALL=C sort -u | wc -l)
FORK_MAC=$(cut -f1 "$TMP".forkmap.mac | LC_ALL=C sort -u | wc -l)

PIN_N=$(wc -l < "$TMP".pin)
FORK_N=$(wc -l < "$TMP".fork)
SHARED=$(LC_ALL=C comm -12 "$TMP".pin "$TMP".fork | wc -l)
LC_ALL=C comm -23 "$TMP".pin "$TMP".fork > "$TMP".absent
ABSENT=$(wc -l < "$TMP".absent)

# ---------------------------------------------------------------- ledger
if [[ -f "$LEDGER" ]]; then
    LED_ROWS=$(($(wc -l < "$LEDGER") - 1))
    CLOUD=$(awk -F'\t' 'NR>1 && $4=="CLOUD"' "$LEDGER" | wc -l)
    DECLINED=$(awk -F'\t' 'NR>1 && $4=="DECLINED"' "$LEDGER" | wc -l)
    DIVERGENT=$(awk -F'\t' 'NR>1 && $4=="DIVERGENT"' "$LEDGER" | wc -l)
    COVERED=$(awk -F'\t' 'NR>1 && $4=="COVERED-ELSEWHERE"' "$LEDGER" | wc -l)
    MISSING=$(awk -F'\t' 'NR>1 && $4=="MISSING-SUBSYSTEM"' "$LEDGER" | wc -l)
    UNPARSED=$(awk -F'\t' 'NR>1 && $4=="UNPARSED"' "$LEDGER" | wc -l)
else
    LED_ROWS=0; CLOUD=0; DECLINED=0; DIVERGENT=0; COVERED=0; MISSING=0; UNPARSED=0
fi

# How much of the absent set the ledger actually covers.
#
# This used to be `UNADJ=$(( ABSENT - LED_ROWS ))` -- a subtraction of two
# TOTALS, not a difference of two SETS (#603). `ABSENT` is a set of test names;
# `LED_ROWS` is `wc -l` of the ledger. Nothing checked that a ledger row names a
# test that is in the absent set, so every row about a test the fork ALREADY HAS
# silently cancelled a genuinely unadjudicated one. At `42effe840` that hid 280
# of them -- 273 rows naming tests the fork now has (legitimate `PORTED` /
# `COVERED-ELSEWHERE` rows) plus 4 naming tests not at the pin at all -- and
# published 435 where the set difference is 715. The error GROWS as the fork
# makes progress, because every newly ported test turns another row into a
# canceller.
#
# Intersect instead. Hash lookups, not `comm`: no collation to get wrong.
if [[ -f "$LEDGER" ]]; then
    ADJ_ABSENT=$(awk -F'\t' 'NR==FNR{absent[$0]=1; next} FNR>1 && ($1 in absent){seen[$1]=1} END{print length(seen)}' \
        "$TMP".absent "$LEDGER")
    CLOUD_ABSENT=$(awk -F'\t' 'NR==FNR{absent[$0]=1; next} FNR>1 && $4=="CLOUD" && ($1 in absent){seen[$1]=1} END{print length(seen)}' \
        "$TMP".absent "$LEDGER")
    # Rows that adjudicate a test which is NOT absent -- the fork has it, or it
    # is not at this pin. Not an error (a `PORTED` row is exactly this), but it
    # is what the old arithmetic silently spent, so it is reported.
    LED_NONABSENT=$(awk -F'\t' 'NR==FNR{absent[$0]=1; next} FNR>1 && !($1 in absent){seen[$1]=1} END{print length(seen)}' \
        "$TMP".absent "$LEDGER")
else
    ADJ_ABSENT=0; CLOUD_ABSENT=0; LED_NONABSENT=0
fi
UNADJ=$(( ABSENT - ADJ_ABSENT ))
(( UNADJ < 0 )) && UNADJ=0

# Split the unadjudicated remainder by whether the file that DEFINES the test at
# the pin still exists here.
#
# #603 fixed the arithmetic but left the number saying the wrong thing. A test in
# a file this fork deleted wholesale -- the dropped cloud layer -- is not pending
# a judgement; the judgement was made once, at subsystem level, and written in
# `DECLINED.md`. What is missing is a per-test ledger row restating it. Reporting
# those together with genuinely open tests makes the remainder read as a work
# queue when most of it is bookkeeping: measured 2026-08-17, 581 of 715 sat in
# 66 files that do not exist here (`server/cloud_objects`, `computer_use`,
# `warp_server_client`, ...), leaving ~135 where "should we port this?" is still
# a live question. Report both, and never quote the total as a queue.
if [[ -s "$TMP".absent && -s "$TMP".pinmap ]]; then
    awk -F'\t' 'NR==FNR{a[$0]=1; next} ($1 in a) && !seen[$1]++ {print $2}' \
        "$TMP".absent "$TMP".pinmap | LC_ALL=C sort > "$TMP".unadj_files
    # `DECLINED.md`'s `test:` markers are adjudication too. A test named there has
    # a written verdict; that it lacks a ledger ROW is a bookkeeping gap, not an
    # open question. Counting those as unadjudicated inflated the live remainder
    # by 16 of 135 when this was added (2026-08-17) -- the whole
    # `install_platform_plugin` family, declined wholesale on 2026-08-15 with
    # per-test markers, still showed up as work to triage.
    grep -o 'test:[A-Za-z0-9_]*' DECLINED.md 2>/dev/null | sed 's/^test://' \
        | LC_ALL=C sort -u > "$TMP".declined_tests || : > "$TMP".declined_tests
    awk -F'\t' 'NR==FNR{led[$1]=1; next} !($0 in led)' \
        "$LEDGER" "$TMP".absent > "$TMP".unadj_pre 2>/dev/null || : > "$TMP".unadj_pre
    LC_ALL=C comm -23 "$TMP".unadj_pre "$TMP".declined_tests > "$TMP".unadj 2>/dev/null \
        || cp "$TMP".unadj_pre "$TMP".unadj
    DECLINED_MARKED=$(LC_ALL=C comm -12 "$TMP".unadj_pre "$TMP".declined_tests | wc -l)
    UNADJ_DELETED=0; UNADJ_LIVE=0
    while IFS=$'\t' read -r name file; do
        [[ -z "$name" ]] && continue
        if [[ -f "$file" ]]; then UNADJ_LIVE=$(( UNADJ_LIVE + 1 ))
        else UNADJ_DELETED=$(( UNADJ_DELETED + 1 )); fi
    done < <(awk -F'\t' 'NR==FNR{u[$0]=1; next} ($1 in u) && !seen[$1]++' \
        "$TMP".unadj "$TMP".pinmap)
else
    UNADJ_DELETED=0; UNADJ_LIVE=$UNADJ
fi
if (( ADJ_ABSENT > 0 )); then
    NONCLOUD_ADJ=$(( ADJ_ABSENT - CLOUD_ABSENT ))
    PROJ_NONCLOUD=$(( UNADJ * NONCLOUD_ADJ / ADJ_ABSENT ))
else
    NONCLOUD_ADJ=0; PROJ_NONCLOUD=$UNADJ
fi
NONCLOUD_ABSENT=$(( NONCLOUD_ADJ + PROJ_NONCLOUD ))
NONCLOUD_UNIVERSE=$(( SHARED + NONCLOUD_ABSENT ))
RESOLVED_ABSENT=$(( DECLINED + DIVERGENT + COVERED ))
pct() { (( $2 == 0 )) && { echo "n/a"; return; }; echo "scale=1; 100*$1/$2" | bc; }
HAVE_PCT=$(pct "$SHARED" "$NONCLOUD_UNIVERSE")
RESOLVED_PCT=$(pct "$(( SHARED + RESOLVED_ABSENT ))" "$NONCLOUD_UNIVERSE")

# ------------------------------------------------------- verification state
# script/precheck writes .phosphor-last-verified on a fully green run. Without
# it we say "never", because "unknown" invites optimism.
MARK=.phosphor-last-verified
if [[ -f "$MARK" ]]; then
    VSHA=$(head -1 "$MARK")
    VWHEN=$(sed -n 2p "$MARK")
    if git merge-base --is-ancestor "$VSHA" HEAD 2>/dev/null; then
        UNVERIFIED=$(git rev-list --count "$VSHA"..HEAD)
        VERIFIED_LINE="\`$VSHA\` ($VWHEN) — **$UNVERIFIED commit(s) since**"
    else
        VERIFIED_LINE="\`$VSHA\` is not an ancestor of HEAD — **branch diverged, treat as unverified**"
    fi
else
    VERIFIED_LINE="**never** — no green \`script/precheck\` has been recorded"
    UNVERIFIED=$(git rev-list --count HEAD 2>/dev/null | head -1)
fi

# ------------------------------------------------------------------ guards
guard() { if [[ -x "$1" ]]; then "$1" >/dev/null 2>&1 && echo "ok" || echo "**FAIL**"; else echo "absent"; fi; }
G_CLOUD=$(guard script/check_cloud_boundary)
G_STUB=$(guard script/check_stub_coverage)
G_DECL=$(guard script/check_declined_collisions)
G_LEDG=$(guard script/check_sweep_ledger)

# grep -c exits 1 on zero matches, so `|| echo 0` would append a SECOND zero.
# Pipe through head instead of using a fallback.
OPEN_TODO=$(grep -c '^\s*- \[ \]' TODO.md 2>/dev/null | head -1)
INFLIGHT=$(grep -c '^\s*- \[>\]' TODO.md 2>/dev/null | head -1)
: "${OPEN_TODO:=0}" "${INFLIGHT:=0}"

# ------------------------------------------------------------------- emit
{
cat <<EOF
# STATE — where Phosphor is right now

**Generated by \`script/state\`. Do not edit by hand.** Every number here is
derived from a primary source at run time; if one is wrong, its source is wrong.
Decisions live in \`DECLINED.md\`, lessons in \`HANDOFF.md\`, evidence in
\`docs/sweep/\`. See that script's header for why this is generated.

Pin: \`$PIN\` (see \`ORACLE.md\` — never measure against \`warp/master\`).

## Is it verified?

Last fully green \`script/precheck\`: $VERIFIED_LINE

| guard | |
|---|---|
| \`check_cloud_boundary\` | $G_CLOUD |
| \`check_stub_coverage\` | $G_STUB |
| \`check_declined_collisions\` | $G_DECL |
| \`check_sweep_ledger\` | $G_LEDG |

## Parity with the pin

Test-name comparison. A shared *name* is not proof of a shared *assertion*, so
treat these as approximate; \`docs/sweep-verdict-ledger.tsv\` is the authority on
any individual test.

| | count |
|---|---:|
| Pin tests | $PIN_N |
| Fork tests | $FORK_N |
| Shared | $SHARED |
| Absent from fork | $ABSENT |

Counted the same way on both sides: \`#[test]\` items, **plus** the
\`crates/integration\` tests wired up by \`register_test!\` ($PIN_REG at the pin,
$FORK_REG here), **plus** the tests generated by the \`macro_rules!\` that emit
\`#[test] fn \$name()\` ($PIN_MAC / $FORK_MAC). Before 2026-08-18 the extractor saw
only literal \`#[test]\`, which counted the whole integration crate as zero and
collapsed the macro-generated tests to a single placeholder name — so every
percentage published before that date was computed over a short count on both
sides.$( if [[ -n "$MACRO_WARN" ]]; then
     printf '\n\n'
     echo "> **A \`macro_rules!\` that emits \`#[test]\` is NOT being expanded, so its"
     echo "> tests are missing from the counts above:**"
     echo ">"
     echo "$MACRO_WARN"
     echo ">"
     echo "> Add an expander for it in \`script/state\`. Listing it as handled without"
     echo "> one just hides the undercount again."
   fi )

Of the absent, **$ADJ_ABSENT are adjudicated** in the ledger and $UNADJ are not.

> **Do not quote that $UNADJ as a work queue.** Of them, **$UNADJ_DELETED are
> defined in files this fork deleted wholesale** — the dropped cloud layer, whose
> verdict was decided once at subsystem level in \`DECLINED.md\`. They are missing a
> per-test ledger row, not a decision. A further **$DECLINED_MARKED** carry an
> explicit \`test:\` marker in \`DECLINED.md\` — also decided, also row-less — and are
> excluded here. The remainder where "should we port this?" is still genuinely
> open is **$UNADJ_LIVE**.

Cloud accounts for $CLOUD_ABSENT of those; the unadjudicated remainder is
*projected* at the same ratio (~$PROJ_NONCLOUD non-cloud), so the figures below
carry that estimate.

The ledger has $LED_ROWS rows in total; the $((LED_ROWS - ADJ_ABSENT)) beyond the
$ADJ_ABSENT above adjudicate tests that are **not** absent — the fork already has
them (a \`PORTED\` or \`COVERED-ELSEWHERE\` row is exactly that), or they are not at
this pin. Those rows are counted here as what they are rather than subtracted
from the absent set, which is what #603 fixed.

- **~${HAVE_PCT}% of the pin's non-cloud tests exist here** ($SHARED of ~$NONCLOUD_UNIVERSE)
- **~${RESOLVED_PCT}% are present or deliberately resolved** (adding $DECLINED declined, $DIVERGENT divergent, $COVERED covered-elsewhere)

## Ledger

| verdict | tests |
|---|---:|
| CLOUD | $CLOUD |
| DECLINED | $DECLINED |
| MISSING-SUBSYSTEM | $MISSING |
| DIVERGENT | $DIVERGENT |
| COVERED-ELSEWHERE | $COVERED |
| UNPARSED | $UNPARSED |

Per \`TODO.md\`'s definition of done, a test is resolved when it is ported,
declined, covered elsewhere, or divergent *because* this fork is BYOP.
**MISSING-SUBSYSTEM is the open bucket.**

## Open work

**Read this section, not a percentage.** The parity figures above measure the
part that is FINISHED, which is the wrong thing to lead a status with. These two
counts are the work that is LEFT, and they come from different sources on
purpose — if they disagree, the tracker is lying, not the ledger.

| source | open work | authority |
|---|---:|---|
| \`docs/sweep-verdict-ledger.tsv\` — \`MISSING-SUBSYSTEM\` | **$MISSING tests** | primary; a test is open until ported/declined/covered/divergent |
| \`TODO.md\` checkboxes | **$OPEN_TODO open**, $INFLIGHT in flight | secondary; counts formatting, so it under-reports silently |

$( if (( MISSING > 0 && OPEN_TODO + INFLIGHT == 0 )); then
     echo "> **MISMATCH: the ledger has $MISSING open tests and \`TODO.md\` tracks none.**"
   elif (( MISSING > OPEN_TODO + INFLIGHT )); then
     echo "> **Check the gap:** the ledger has $MISSING open tests; \`TODO.md\` tracks $((OPEN_TODO + INFLIGHT)) items total. On 2026-08-11 this file reported \`MISSING-SUBSYSTEM 50\` and \`37 open\` at the same time, and the status given to the maintainer quoted a stale \`195\` from \`TODO.md\` instead of either. The generated number was correct and went unread. **Quote this section; never narrate a percentage.**"
   else
     echo "> Ledger open bucket is represented in \`TODO.md\`'s tracked items."
   fi )
EOF
} > "$TMP"

# Strip the lines that are a function of HEAD rather than of tree content, so `--check`
# compares only what a commit can actually fix.
#
# `Generated` is a timestamp. The verified line embeds `git rev-list --count $VSHA..HEAD`,
# which EVERY commit increments -- including the commit that updates this file. Comparing
# it made the gate unpassable: regenerate at commit N and it writes "N - verified"; commit
# that and HEAD becomes N+1; the next --check computes N+1 - verified and reports stale.
# There is no sequence of commits that leaves it green, so `script/precheck` reported red
# on every push regardless of the change being pushed -- which is how a gate teaches people
# to ignore it. See #612.
#
# Both lines still render in the document; they just cannot be equality-checked.
strip_head_derived() { grep -v -e '^Generated ' -e '^Last fully green '; }

if (( CHECK )); then
    if [[ -f "$OUT" ]] && diff -q <(strip_head_derived < "$TMP") <(strip_head_derived < "$OUT") >/dev/null 2>&1; then
        echo "state: ok (docs/STATE.md is current)"
        exit 0
    fi
    echo "state: FAIL -- docs/STATE.md is out of date. Run: script/state" >&2
    exit 1
fi

mv "$TMP" "$OUT"
echo "state: wrote $OUT"
