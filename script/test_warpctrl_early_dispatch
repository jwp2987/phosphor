#!/usr/bin/env bash
#
# Proves the SHARED APP BINARY still honours the hidden `--warpctrl` flag, and
# that it does so EARLY -- before the normal Oz argument parser or GUI startup.
#
# WHY THIS EXISTS (the other half of the warpctrl gate)
# ----------------------------------------------------
# Warp Control is reachable through two cooperating pieces, and each one can
# break without the other noticing:
#
#   1. The bundled wrapper script, generated by
#      `script/macos/create_warpctrl_wrapper`, which execs the app executable
#      with `--warpctrl` prepended.  `script/macos/test_create_warpctrl_wrapper`
#      covers that half.  It proves the wrapper FORWARDS the flag -- and
#      nothing more, because it runs against a fake two-line binary.
#
#   2. The binary's own early dispatch, in `app/src/lib.rs::run()`:
#          if let Some(control_args) =
#              warp_cli::local_control::ControlArgs::from_control_mode_env()
#          { ... run_and_exit(control_args) }
#      This runs before `warp_cli::Args::from_env()`, so the Warp Control
#      subcommands (`instance`, `tab`, `capability`, ...) never reach the Oz
#      parser, which does not know them.  Delete or reorder that block and the
#      wrapper keeps forwarding a flag nobody reads: every `warpctrl` command
#      starts failing with "unrecognized subcommand", and the wrapper test
#      stays green throughout.
#
# Ported from the pin (02b53fcd8) `script/test_warpctrl_early_dispatch`.
#
# DIFFERENCES FROM THE PIN -- read before "restoring" any of them
# --------------------------------------------------------------
#   * The pin shells out to `cargo run -p warp --bin warp --features
#     warp_control_cli`.  This fork has no `warp_control_cli` CARGO feature --
#     local control is gated at RUNTIME by `FeatureFlag::WarpControlCli`, and
#     the CLI dispatch path itself is unconditional -- and it has no `warp`
#     bin: `app/Cargo.toml` declares exactly two bins, `zap-oss` (default-run)
#     and `generate_settings_schema`.  Keeping the pin's cargo-feature guard is
#     the mistake that already made the bundle script never write the wrapper.
#   * The pin BUILDS.  This test does not: it locates an already-built binary
#     and SKIPS with a diagnostic when there is none (see "SKIP BEHAVIOUR").
#     A build here would take tens of minutes and cannot run in the cheap-gate
#     job this test is wired into.
#   * The pin asserts stdout is exactly `[]`.  That expectation is stale even
#     at the pin: `render_instance_list` serialises `InstanceListOutput`, a
#     struct with one `instances` field, through `serde_json::to_writer_pretty`
#     -- so the real output is `{"instances": []}` (pretty-printed).  The pin's
#     own `crates/warp_cli/src/local_control/commands.rs` is byte-identical to
#     this fork's for that function.  We assert the shape the code actually
#     produces, whitespace-insensitively.
#   * The discovery-directory override is `ZAP_LOCAL_CONTROL_DISCOVERY_DIR`
#     here (`crates/local_control/src/discovery.rs`), not
#     `WARP_LOCAL_CONTROL_DISCOVERY_DIR`.
#
# SKIP BEHAVIOUR
# --------------
# With a binary:     runs the four assertions below and exits 0 or 1.
# Without a binary:  prints where it looked and exits 0 (SKIPPED).
# With a broken
# `ZAP_CONTROL_TEST_BINARY` override: exits 1.  An explicit override that
#                    points at nothing is a mistake, not an absent build.
#
# Usage:
#   script/test_warpctrl_early_dispatch
#   ZAP_CONTROL_TEST_BINARY=/path/to/zap-oss script/test_warpctrl_early_dispatch

set -uo pipefail

workspace_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin_name="zap-oss"

status=0
fail() {
  printf 'warpctrl early dispatch: FAIL %s\n' "$1" >&2
  status=1
}
pass() { printf '  ok   %s\n' "$1"; }

# ----------------------------------------------------------- binary discovery
#
# Search order, most specific first.  `script/agent-cargo` redirects
# CARGO_TARGET_DIR to a per-agent directory under PHOSPHOR_TARGET_ROOT, so a
# binary built through the governor is NOT under `<repo>/target`; look in both.
find_binary() {
  local root profile candidate
  local -a roots=()

  [[ -n "${CARGO_TARGET_DIR:-}" ]] && roots+=("$CARGO_TARGET_DIR")
  roots+=("$workspace_root/target")

  local target_root="${PHOSPHOR_TARGET_ROOT:-/cache/git/.phosphor-build/targets}"
  if [[ -d "$target_root" ]]; then
    while IFS= read -r root; do
      roots+=("$root")
    done < <(find "$target_root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
  fi

  for root in "${roots[@]}"; do
    # Profile directory names come from app/Cargo.toml's profiles and from
    # script/macos/bundle's CARGO_PROFILE values.
    for profile in debug release release-lto release-cli; do
      candidate="$root/$profile/$bin_name"
      if [[ -f "$candidate" && -x "$candidate" ]]; then
        printf '%s' "$candidate"
        return 0
      fi
    done
  done
  return 1
}

searched_note() {
  printf '  Looked for an executable named %s under:\n' "$bin_name"
  [[ -n "${CARGO_TARGET_DIR:-}" ]] && printf '    $CARGO_TARGET_DIR (%s)\n' "$CARGO_TARGET_DIR"
  printf '    %s\n' "$workspace_root/target"
  printf '    %s/*/\n' "${PHOSPHOR_TARGET_ROOT:-/cache/git/.phosphor-build/targets}"
  printf '  in profiles: debug release release-lto release-cli\n'
}

if [[ -n "${ZAP_CONTROL_TEST_BINARY:-}" ]]; then
  if [[ -f "$ZAP_CONTROL_TEST_BINARY" && -x "$ZAP_CONTROL_TEST_BINARY" ]]; then
    binary="$ZAP_CONTROL_TEST_BINARY"
  else
    printf 'warpctrl early dispatch: FAIL ZAP_CONTROL_TEST_BINARY is set to "%s", which is not an executable file.\n' \
      "$ZAP_CONTROL_TEST_BINARY" >&2
    printf '  An explicit override that points at nothing is a mistake, not an absent build -- so this is a failure, not a skip.\n' >&2
    exit 1
  fi
elif ! binary="$(find_binary)"; then
  printf 'warpctrl early dispatch: SKIPPED -- no built app binary found.\n'
  searched_note
  printf '  This test needs a real binary; it deliberately does not build one\n'
  printf '  (a cold build is tens of minutes and this runs in the cheap-gate job).\n'
  printf '  To run it:  cargo build --bin %s --features gui\n' "$bin_name"
  printf '          or: ZAP_CONTROL_TEST_BINARY=/path/to/%s script/test_warpctrl_early_dispatch\n' "$bin_name"
  exit 0
fi

printf 'warpctrl early dispatch: using %s\n' "$binary"

temp_dir="$(mktemp -d)"
trap 'rm -rf "$temp_dir"' EXIT

discovery_dir="$temp_dir/discovery"
fake_home="$temp_dir/home"
mkdir -p "$discovery_dir" "$fake_home"

# A bounded run, so a binary that falls through to GUI startup fails the gate
# instead of hanging it.  `timeout` is GNU coreutils; on a bare macOS host it
# may be absent (it is `gtimeout` there), in which case we run unbounded rather
# than skip -- the assertions still hold, only the hang protection is lost.
#
# Expanded below as `${timeout_cmd[@]+"${timeout_cmd[@]}"}`, not plain
# `"${timeout_cmd[@]}"`: under `set -u`, bash before 4.4 -- which is what a
# stock macOS host has -- treats an empty array expansion as an unbound
# variable and aborts.
timeout_cmd=()
if command -v timeout >/dev/null 2>&1; then
  timeout_cmd=(timeout "${ZAP_CONTROL_TEST_TIMEOUT:-120}")
fi

# An empty, private discovery directory means "no running instances", which is
# a SUCCESSFUL empty list, never an error (see the doc comment on
# `render_instance_list`).  HOME and XDG_RUNTIME_DIR are redirected too because
# `discovery_dir()` falls back to them; pinning all three keeps the result
# independent of whether a real Zap happens to be running on this host.
#
# `-u` MUST precede the NAME=VALUE assignments: env stops parsing options at
# the first non-option argument, so a trailing `-u` is taken as the command name
# and the run dies with "env: '-u': No such file or directory".
run_app() {
  env \
    -u WARP_OUTPUT_FORMAT \
    HOME="$fake_home" \
    XDG_RUNTIME_DIR="$temp_dir/xdg" \
    ZAP_LOCAL_CONTROL_DISCOVERY_DIR="$discovery_dir" \
    ${timeout_cmd[@]+"${timeout_cmd[@]}"} "$@"
}

report_timeout() {
  if [[ "$1" == 124 ]]; then
    printf '  The command did not exit within the timeout. That is the signature of\n' >&2
    printf '  dispatch happening LATE (or not at all): the binary fell through to app\n' >&2
    printf '  startup instead of running the control CLI and exiting.\n' >&2
  fi
}

# --------------------------------------------------- 1. the flag is honoured
rc=0
run_app "$binary" --warpctrl --output-format json instance list \
  >"$temp_dir/list.out" 2>"$temp_dir/list.err" || rc=$?

if ((rc != 0)); then
  fail "\`--warpctrl --output-format json instance list\` exited $rc, expected 0"
  report_timeout "$rc"
  sed 's/^/      stderr: /' "$temp_dir/list.err" >&2
  sed 's/^/      stdout: /' "$temp_dir/list.out" >&2
else
  # Whitespace-insensitive: the writer is `to_writer_pretty`, and its exact
  # indentation is not the thing under test.
  normalized="$(tr -d ' \t\r\n' <"$temp_dir/list.out")"
  if [[ "$normalized" == '{"instances":[]}' ]]; then
    pass "--warpctrl reaches the control CLI and lists zero instances"
  else
    fail "unexpected \`instance list\` output: $normalized"
    printf '      expected (ignoring whitespace): {"instances":[]}\n' >&2
  fi
fi

# ------------------------------------ 2. it is the SEPARATE parser, not Oz's
rc=0
run_app "$binary" --warpctrl --help >"$temp_dir/help.out" 2>&1 || rc=$?
if ((rc != 0)); then
  fail "\`--warpctrl --help\` exited $rc, expected 0"
  report_timeout "$rc"
  sed 's/^/      /' "$temp_dir/help.out" >&2
elif grep -q 'instance' "$temp_dir/help.out" && grep -q 'capability' "$temp_dir/help.out"; then
  pass "--warpctrl --help lists the Warp Control subcommands"
else
  fail "\`--warpctrl --help\` does not look like the Warp Control help"
  printf '      expected the subcommand list to mention "instance" and "capability"\n' >&2
  sed 's/^/      /' "$temp_dir/help.out" >&2
fi

# ------------------------------- 3. negative control: the flag is what selects
# Without `--warpctrl` the same arguments must reach the normal Oz parser,
# which has no `instance` subcommand.  If this ever starts passing, the two
# parsers have been merged and assertion 1 no longer proves anything about
# early dispatch.
rc=0
run_app "$binary" --output-format json instance list \
  >"$temp_dir/neg.out" 2>"$temp_dir/neg.err" || rc=$?
if ((rc == 0)); then
  fail "\`instance list\` WITHOUT --warpctrl succeeded; the control subcommands must not be reachable from the normal parser"
elif ((rc == 124)); then
  fail "\`instance list\` WITHOUT --warpctrl hung; it should be rejected by the Oz parser immediately"
else
  pass "without --warpctrl the same arguments are rejected (exit $rc)"
fi

# ------------------------------------- 4. end to end, through the real wrapper
# This is the join the two halves were split across: the generated wrapper
# injecting the flag AND the binary honouring it, in one process tree.
if ((status == 0)); then
  wrapper_bundle="$temp_dir/Phosphor.app/Contents"
  wrapper_path="$wrapper_bundle/Resources/bin/warpctrl-oss"
  mkdir -p "$wrapper_bundle/MacOS"
  # A symlink rather than a copy: the wrapper resolves symlinks of ITSELF, not
  # of its target, and exec follows the link. This keeps the real bundle layout
  # (`../../MacOS/<bin>`) without copying a large binary.
  ln -s "$binary" "$wrapper_bundle/MacOS/$bin_name"

  "$workspace_root/script/macos/create_warpctrl_wrapper" \
    "$wrapper_path" "../../MacOS/$bin_name"

  rc=0
  run_app "$wrapper_path" --output-format json instance list \
    >"$temp_dir/wrapped.out" 2>"$temp_dir/wrapped.err" || rc=$?
  if ((rc != 0)); then
    fail "the generated wrapper exited $rc, expected 0"
    report_timeout "$rc"
    sed 's/^/      stderr: /' "$temp_dir/wrapped.err" >&2
  elif cmp -s "$temp_dir/list.out" "$temp_dir/wrapped.out"; then
    pass "the generated wrapper produces the same output as the explicit flag"
  else
    fail "wrapper output differs from the explicit \`--warpctrl\` invocation"
    diff "$temp_dir/list.out" "$temp_dir/wrapped.out" | sed 's/^/      /' >&2
  fi
fi

if ((status == 0)); then
  echo "warpctrl early dispatch: ok"
else
  echo "warpctrl early dispatch: FAILED" >&2
fi
exit $status
