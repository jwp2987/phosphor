#!/usr/bin/env bash
# Run the suite and compare failures against script/known_test_failures.txt.
#
# WHY THIS EXISTS
# ---------------
# `main` carries known red tests. A CI job that simply fails while they exist is
# red on every PR forever, and a job that is always red teaches everyone to
# ignore it -- which is exactly how a merge past a red `fork boundary guards`
# job cascaded into fourteen broken PRs on 2026-08-07.
#
# So this fails on CHANGE, not on redness:
#
#   - a test fails that is not on the list  -> regression, exit 1
#   - a test on the list passes             -> stale entry, exit 1 (delete it)
#   - the listed failures and only those    -> exit 0
#
# The second rule matters as much as the first. Without it the list is a place
# failures go to be forgotten; with it, fixing a test FORCES the debt to be
# retired in the same PR. Same contract as script/cloud_boundary_allowlist.txt.
#
# This is NOT a way to make a red test acceptable. AGENTS.md 5.6 still applies:
# a red test gets fixed, and adding a line here needs a tracking issue and
# maintainer sign-off.

set -uo pipefail
cd "$(dirname "$0")/.."

KNOWN="script/known_test_failures.txt"
[[ -f "$KNOWN" ]] || { echo "error: $KNOWN is missing" >&2; exit 2; }

out="$(mktemp)"; expected="$(mktemp)"; actual="$(mktemp)"
trap 'rm -f "$out" "$expected" "$actual"' EXIT

# Route through the build governor when it exists. Bare `cargo` here builds into
# the default ./target, and a git worktree under /tmp puts that on a tmpfs --
# which is RAM. On 2026-08-08 that filled the 23G tmpfs mid-run and every crate
# died with "Disk quota exceeded"; the real disk was 47% free the whole time.
# agent-cargo pins CARGO_TARGET_DIR onto real storage and caps slots and jobs.
if [[ -x ./script/agent-cargo ]]; then
    CARGO_RUN=(./script/agent-cargo "${PHOSPHOR_CARGO_LABEL:-check-test-failures}")
else
    CARGO_RUN=(cargo)
fi
# rustc scribbles temporaries into TMPDIR too, so keep those off the tmpfs.
if [[ -z "${TMPDIR:-}" || "$TMPDIR" == /tmp* ]]; then
    _tmp_root="${PHOSPHOR_TARGET_ROOT:-/cache/git/.phosphor-build}/tmp"
    mkdir -p "$_tmp_root" 2>/dev/null && export TMPDIR="$_tmp_root"
fi

echo "running: ${CARGO_RUN[*]} nextest run ${*}" >&2
"${CARGO_RUN[@]}" nextest run "$@" --no-fail-fast 2>&1 | tee "$out"
nextest_status="${PIPESTATUS[0]}"

# This bit ALSO bit for real, and worse than the retry bug below.
#
# The pipe to `tee` discards nextest's exit status, and the only signal this
# script reads afterwards is the set of `FAIL` lines. A build failure prints no
# FAIL lines at all -- so "the test binary did not compile" and "every test
# passed" produced byte-identical input to the comparison, and the gate reported
# `ok  no change against known_test_failures.txt`.
#
# On 2026-08-09 `warp_tui`'s lib test failed to compile with 9 errors, the
# warp + warp_tui suite (~5,686 tests) never ran, precheck exited 0, and the
# result was pushed as green. The tell was in the output the whole time: the
# summary counts covered only the other two steps. Nobody reads counts.
#
# nextest exit codes: 0 = all passed, 100 = tests failed (expected here -- the
# known-failures comparison below is what judges those), anything else is the
# run itself failing (101 = build error). Treat that as fatal, and separately
# require evidence that a suite actually ran, so a future silent-skip mode
# cannot slip through either.
if [[ "$nextest_status" -ne 0 && "$nextest_status" -ne 100 ]]; then
    echo "" >&2
    echo "=============================================================" >&2
    echo "THE TEST RUN ITSELF FAILED -- no tests were judged." >&2
    echo "=============================================================" >&2
    echo "error: nextest exited $nextest_status (not 0=passed / 100=test failures)." >&2
    echo "This is almost always a COMPILE error in the test build. Scroll up." >&2
    echo "" >&2
    echo "This is NOT 'no regressions'. Nothing ran, so nothing was checked." >&2
    exit 2
fi

if ! grep -qE '^\s+Summary \[' "$out"; then
    echo "" >&2
    echo "=============================================================" >&2
    echo "NO TEST SUMMARY -- the suite did not run." >&2
    echo "=============================================================" >&2
    echo "error: nextest printed no 'Summary [...]' line, so no tests were" >&2
    echo "executed even though it exited $nextest_status." >&2
    echo "" >&2
    echo "An empty failure set here means 'nothing ran', not 'nothing broke'." >&2
    exit 2
fi

# nextest prints a summary line per failure:  "        FAIL [   0.1s] (n/m) warp  path::to::test"
# ...and for a test it RETRIED, it prints:     "  TRY 3 FAIL [   0.1s] (n/m) warp  path::to::test"
#
# This bit for real, and badly. The pattern here used to be `^\s+FAIL `, which
# matches the first form and NOT the second -- so every failure nextest retried
# was invisible to this gate. A local full-suite run on 2026-08-08 reported 4
# regressions while 24 further `warp_tui` failures went unreported, none of them
# in known_test_failures.txt. CI runs this same script, so every green nextest
# job in this repo has been blind to retried failures.
#
# Retries are configured precisely for tests suspected of flaking, which is to
# say: the gate was blind exactly where it most needed to see.
#
# Match both forms. Take the last whitespace-delimited field, ANSI stripped.
sed -E 's/\x1b\[[0-9;]*m//g' "$out" \
    | grep -E '^\s+(TRY [0-9]+ )?FAIL ' \
    | awk '{print $NF}' \
    | sort -u > "$actual"

grep -vE '^\s*(#|$)' "$KNOWN" | tr -d ' \r' | sort -u > "$expected"

new="$(comm -23 "$actual" "$expected")"
fixed="$(comm -13 "$actual" "$expected")"

status=0

if [[ -n "$new" ]]; then
    status=1
    echo "" >&2
    echo "=============================================================" >&2
    echo "REGRESSION -- this change broke test(s). Fix the code." >&2
    echo "=============================================================" >&2
    echo "error: test(s) failed that are not in $KNOWN:" >&2
    echo "$new" | sed 's/^/  + /' >&2
    cat >&2 <<'EOF'

This is a regression introduced by this change. Fix the CODE, not the test
(AGENTS.md 5.6/5.11): do not weaken the assertion, do not #[ignore] it, and do
not add it to the known-failures list to get green. Adding a line there needs a
tracking issue and maintainer sign-off.
EOF
fi

if [[ -n "$fixed" ]]; then
    status=1
    echo "" >&2
    echo "=============================================================" >&2
    echo "BOOKKEEPING -- nothing is broken. Your change FIXED test(s)." >&2
    echo "To go green: delete the line(s) below from" >&2
    echo "  $KNOWN" >&2
    echo "and commit that deletion in this same PR. Nothing else needed." >&2
    echo "=============================================================" >&2
    echo "test(s) listed in $KNOWN now PASS:" >&2
    echo "$fixed" | sed 's/^/  - /' >&2
    cat >&2 <<'EOF'

Why this is enforced rather than ignored: if the list never shrinks, it stops
describing reality within a few weeks -- and at that point a REAL regression in
a listed test is invisible, because the list already excuses it.

Also close the issue each deleted line cites.
EOF
fi

if [[ $status -eq 0 ]]; then
    echo ""
    echo "tests: ok ($(wc -l < "$expected" | tr -d ' ') known failure(s), no regressions)"
fi

exit $status
