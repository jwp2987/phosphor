#!/usr/bin/env python3
"""Regression test (#1255): the bash Preexec hook must escape a huge command in linear time.

`__warp_ej_var` used parameter substitutions that are quadratic on a big value (1 MB of multi-line
text: 5.4 s in a UTF-8 locale, 10 MB: minutes), and `__warp_preexec_impl` ran it on the whole
$BASH_COMMAND, freezing the shell before a big paste ran. A value over 8 KiB now takes the sed
pipeline. This extracts the real functions from bash_body.sh and runs them from a DEBUG trap (where
the hook runs and bash holds $BASH_COMMAND at the trapped command) on

  * a 1.4 MB and a 2.8 MB multi-line command with quotes, backslashes, tabs, CRs and non-ASCII: the
    escaped text must decode, as JSON, to exactly the command (nothing truncated or altered), and
    doubling the size must not more than triple the time (linear ~2x, quadratic ~4x; the control is
    measured in the same run), with the 2.8 MB case under 10 s;
  * a 20 KB and a short command, covering the path on each side of the threshold.

On the pre-fix code the 3 MB case takes minutes (the test times out and fails).
Needs only python3 and bash; exit 0 when everything passes.

USAGE
    script/test_bash_preexec_large_command [path/to/bash]
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
BODY = os.path.join(ROOT, "app", "assets", "bundled", "bootstrap", "bash_body.sh")
BASH = sys.argv[1] if len(sys.argv) > 1 else (shutil.which("bash") or "/bin/bash")
text = open(BODY).read()


def func(name):
    m = re.search(r"^ {4}%s \(\) \{\n.*?^ {4}\}\n" % re.escape(name), text, re.S | re.M)
    if not m:
        sys.exit(f"FAIL: {name} not found in bash_body.sh")
    return m.group(0)


prelude = "\n".join(
    func(n)
    for n in ("warp_escape_json", "__warp_ej_var", "warp_hex_encode_string", "__warp_hex_encode_to")
)
failures = []


def run(command, limit):
    """The Preexec hook's escaping of `: <command>`; returns (decoded JSON string, seconds)."""
    script = f"""{prelude}
trap '__warp_ej_var escaped "$BASH_COMMAND"; __warp_hex_encode_to "$escaped"; trap - DEBUG' DEBUG
: {command}
printf '%s' "$__warp_hex"
"""
    env = dict(os.environ, LC_ALL="C.UTF-8")
    start = time.time()
    try:
        r = subprocess.run(
            [BASH], input=script, capture_output=True, text=True, env=env, timeout=limit * 5
        )
    except subprocess.TimeoutExpired:
        return None, time.time() - start
    elapsed = time.time() - start
    if r.returncode != 0:
        failures.append(f"bash failed: {r.stderr[:200]!r}")
        return None, elapsed
    escaped = bytes.fromhex(r.stdout).decode("utf-8")
    return json.loads('"' + escaped + '"'), elapsed


def check(label, literal, limit):
    expected = ": " + literal
    got, elapsed = run(literal, limit)
    if got is None:
        failures.append(f"{label}: no result after {elapsed:.1f}s")
        return
    if got != expected:
        failures.append(f"{label}: escaped command does not round-trip")
    if elapsed > limit:
        # One re-measure, as the latency gates do (lat.py): a CI runner shared with other jobs can
        # miss by a few percent once (r14a guards: 3MB took 3.06s against 3s while sshlab-image ran).
        # The limit is unchanged and both runs must miss for a FAIL.
        got2, elapsed2 = run(literal, limit)
        if got2 is None or elapsed2 > limit:
            failures.append(f"{label}: took {elapsed:.2f}s then {elapsed2:.2f}s on a re-measure (limit {limit}s)")
        else:
            print(f"note {label}: {elapsed:.2f}s over the {limit}s limit once, {elapsed2:.2f}s on the re-measure")


def lines(n):
    return "\n".join(
        'echo "line %d" \\ \t caf\u00e9 \r $x %s' % (i, "ab cd" * 8) for i in range(n)
    )


check("short", "'short'", 2)
check("20KB", "'" + lines(300) + "'", 2)


def linear_in_size():
    """What #1255 is about is the GROWTH: the pre-fix code is quadratic (1 MB 5.4 s, 3 MB minutes).
    A fixed wall-clock line alone judged the CI box's speed and load instead (r14a and r15a guards:
    3 MB took 3.06 s and 3.25 s next to an app-test job; the laptop takes 1.94 s, and 0.7/1.4/2.8/5.7 MB
    take 0.48/0.95/1.94/3.83 s, i.e. linear). So the control is in the same run on the same machine:
    the 1.4 MB command, then the 2.8 MB one. Linear doubles the time (ratio ~2), quadratic quadruples it
    (~4): a ratio over 3.0 is a FAIL. The 2.8 MB time is also capped at 10 s (the pre-fix code takes
    minutes) and printed every run, so a slower machine is visible without being judged as the app."""
    half, full = "'" + lines(20000) + "'", "'" + lines(40000) + "'"
    t_half, t_full = [], []
    for _ in range(2):  # median of two each: one slow sample from a neighbouring job cannot decide
        for lit, acc in ((half, t_half), (full, t_full)):
            got, s = run(lit, 10)
            if got is None:
                failures.append(f"{len(lit) // 1024} KB: no result after {s:.1f}s (cap 10s)")
                return
            if got != ": " + lit:
                failures.append(f"{len(lit) // 1024} KB: escaped command does not round-trip")
            acc.append(s)
    a, b = min(t_half), min(t_full)
    ratio = b / a if a > 0 else float("inf")
    print(f"3MB: {b:.2f}s, 1.4MB: {a:.2f}s, ratio {ratio:.2f} (linear ~2, quadratic ~4; FAIL over 3.0 or over 10s)")
    if ratio > 3.0:
        failures.append(f"3MB: escaping grows faster than linear: {a:.2f}s at 1.4 MB, {b:.2f}s at 2.8 MB (ratio {ratio:.2f} > 3.0)")
    if b > 10:
        failures.append(f"3MB: took {b:.2f}s (cap 10s)")


linear_in_size()

if failures:
    print("\n".join("FAIL: " + f for f in failures))
    sys.exit(1)
print("ok")
