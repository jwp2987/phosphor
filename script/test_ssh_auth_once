#!/usr/bin/env python3
"""#1626: a failed ssh login asks for credentials ONCE, like plain ssh.

The wrapper's ControlMaster step (`ssh ... -N -f`) is where the user authenticates. When it
failed, the #1551 fallback ran `command ssh "$@"` again, so a failed login showed a SECOND
password / passphrase prompt and the user's next local command was typed into it.

This cuts the real `warp_ssh_helper` out of bash_body.sh, zsh_body.sh and fish.sh, puts a fake
`ssh` on PATH that counts every connecting invocation, and checks:

  * auth failure (255, no control socket created)   -> ssh runs ONCE, status 255, its own
    "Permission denied" message reaches stderr unchanged, nothing extra is printed;
  * Ctrl-C at the prompt (130)                     -> ssh runs ONCE, status 130;
  * mux failure (255 AFTER authenticating: the master created its ControlPath socket, as Git
    for Windows' ssh.exe does before "Failed to connect to new control master") -> the #1551
    fallback still runs the user's plain ssh, exactly once more, with exactly their arguments.

r18u13: the same where $HOME is NOT the passwd home (an isolated CI home deep in a build dir).
The app used to export the literal `~/.ssh` there ($HOME too long for a socket path); ssh expands
that `~` from the passwd entry (the fake ssh does the same from $PWHOME) while the wrapper's socket
test expanded it from $HOME, so the wrapper never saw its own master: a successful login was
followed by a SECOND login ("ControlSocket ... already exists"; a second passphrase prompt in
ssh_password_prompt), and a mux failure no longer reached the #1551 fallback. The app now exports
the passwd home's absolute `.ssh` instead (shell_tests.rs,
ssh_socket_dir_falls_back_to_the_passwd_home); these cases run the wrapper with that export:

  * login succeeds (`ok`)       -> the wrapper owns its master: ONE `ControlMaster=yes` login,
    and the session multiplexes over it (`ControlMaster=no ... -t`), no second login;
  * auth failure / mux failure  -> as above.

#1641: the wrapper tells the app which ssh follows its master login, so the app can hold the keys
typed meanwhile instead of releasing them while the master logs in (they reached the managed
session's bootstrap payload and were eaten). Every hook the wrapper prints and every connecting
ssh call are recorded in one ordered log:

  * login succeeds                 -> `ManagedSSHSessionStarting` exactly once, after the master
    and immediately before the managed session (`ControlMaster=no ... -t`), no fallback;
  * mux failure                    -> `PlainSSHFallback` exactly once, immediately before the
    plain ssh;
  * a RemoteCommand in the config, a non-POSIX remote (cmd.exe answers the probe), MSYS2 (bash)
    -> `PlainSSHFallback` immediately before each plain ssh, never `ManagedSSHSessionStarting`;
  * auth failure / Ctrl-C          -> no hook at all (the block's end hands the keys back).

#1641 host-key retry (owner: "master in strict host-key mode, retry"): when `ssh -G` reports the
default `stricthostkeychecking ask`, the master runs with StrictHostKeyChecking=yes, so a host-key
yes/no never happens while the app holds the keys:

  * unknown host (not in the known_hosts files `ssh -G` names)  -> the master fails, then ONE
    plain ssh with exactly the user's arguments, `PlainSSHFallback` right before it;
  * known host + auth failure                                   -> exactly one ssh call, no hook;
  * the user's config says accept-new                           -> no strict override, one call;
  * login succeeds under `ask`                                  -> the master carries the override.

Needs python3 and at least one of bash/zsh/fish (missing shells are SKIPPED). No cargo.
Usage: script/test_ssh_auth_once
"""
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BOOT = os.path.join(ROOT, "app/assets/bundled/bootstrap")

# Records each non -G call as one line of its arguments. -N (the master) behaves per $MASTER.
# Like ssh, a leading `~` in ControlPath is the PASSWD home ($PWHOME here), never $HOME.
FAKE_SSH = r"""#!/bin/sh
p=
for a in "$@"; do case "$a" in ControlPath=*) p="${a#ControlPath=}";; esac; done
case "$p" in "~"*) p="${PWHOME:-$HOME}${p#\~}";; esac
case " $* " in
  *" -G "*) printf 'user u\nhostname h\nport 22\n'
            [ -n "$p" ] && printf 'controlpath %s\n' "$p"
            [ "$MASTER" = remotecommand ] && printf 'remotecommand uptime\n'
            [ -n "$STRICT" ] && printf 'stricthostkeychecking %s\n' "$STRICT"
            [ -n "$KH" ] && printf 'userknownhostsfile %s\nglobalknownhostsfile /nonexistent/known_hosts\n' "$KH"
            exit 0;;
esac
printf '%s\n' "$*" >> "$CALLS"
printf 'ssh %s\n' "$*" >> "$EVENTS"
case " $* " in
  *" -T "*) [ "$MASTER" = nonposix ] && printf '%s\n' 'warp-probe-C:\WINDOWS\system32\cmd.exe-$PSVersionTable'
            exit 0;;
  *" -O "*) exit 255;;
  *" -N "*)
    case "$MASTER" in
      authfail) echo "user@host: Permission denied (publickey,password)." >&2; exit 255;;
      hostunknown) echo "Host key verification failed." >&2; exit 255;;
      interrupt) exit 130;;
      muxfail) python3 -c 'import socket,sys; socket.socket(socket.AF_UNIX).bind(sys.argv[1])' "$p"
               echo "Failed to connect to new control master" >&2; exit 255;;
      ok|nonposix) python3 -c 'import socket,sys; socket.socket(socket.AF_UNIX).bind(sys.argv[1])' "$p"; exit 0;;
    esac;;
esac
exit 0
"""

# (shell, file, function start marker, end marker)
SHELLS = [
    ("bash", "bash_body.sh", "        function warp_ssh_helper() {", "\n        function __warp_ssh_impl"),
    ("zsh", "zsh_body.sh", "      function warp_ssh_helper() {", "\n      function ssh() {"),
    ("fish", "fish.sh", "    function warp_ssh_helper", "\n    function ssh\n"),
]

# (master behaviour, $HOME is not the passwd home, expected status, expected connecting ssh calls
# (None: checked by `owns_master`), expected stderr, #1641 verdict hook expected: None, "managed"
# or "fallback")
CASES = [
    ("authfail", False, 255, 1, "user@host: Permission denied (publickey,password).\n", None),
    ("interrupt", False, 130, 1, "", None),
    ("muxfail", False, 0, 2, "Failed to connect to new control master\n", "fallback"),
    ("authfail", True, 255, 1, "user@host: Permission denied (publickey,password).\n", None),
    ("muxfail", True, 0, 2, "Failed to connect to new control master\n", "fallback"),
    ("ok", True, 0, None, "", "managed"),
    ("ok", False, 0, None, "", "managed"),
    # #1641: the other plain-ssh paths. The first call is the plain ssh itself (no master).
    ("remotecommand", False, 0, 1, "", "fallback"),
    ("nonposix", False, 0, None, "", "fallback"),
    ("msys2", False, 0, 1, "", "fallback"),
]

# #1641 host-key retry: (master behaviour, ssh -G stricthostkeychecking, host in known_hosts,
# expected status, expected connecting ssh calls (None: `owns_master`), expected stderr, verdict,
# whether the master must carry StrictHostKeyChecking=yes)
HOSTKEY_CASES = [
    ("hostunknown", "ask", False, 0, 2, "Host key verification failed.\n", "fallback", True),
    ("authfail", "ask", True, 255, 1, "user@host: Permission denied (publickey,password).\n", None, True),
    ("authfail", "accept-new", False, 255, 1, "user@host: Permission denied (publickey,password).\n", None, False),
    ("ok", "ask", True, 0, None, "", "managed", True),
]

MANAGED = "ManagedSSHSessionStarting"
FALLBACK = "PlainSSHFallback"


def verdict_problems(master, verdict, events):
    """#1641: the hooks the wrapper printed, in order with the connecting ssh calls."""
    problems = []
    hooks = [e[5:] for e in events if e.startswith("hook ")]
    names = []
    for h in hooks:
        try:
            msg = json.loads(h)
        except ValueError:
            problems.append("unparseable hook %r" % h)
            continue
        names.append(msg.get("hook"))
        if msg.get("value", {}).get("session_id") != 77:
            problems.append("hook without the shell's session id: %r" % h)
    if verdict is None:
        if names:
            problems.append("no verdict hook may be printed (the block's end hands the keys back): %r" % names)
        return problems
    want = MANAGED if verdict == "managed" else FALLBACK
    if names != [want]:
        problems.append("hooks %r, want exactly [%r]" % (names, want))
        return problems
    at = next(i for i, e in enumerate(events) if e.startswith("hook "))
    after = events[at + 1] if at + 1 < len(events) else ""
    if verdict == "managed":
        # After the master login, immediately before the managed session over it.
        if not any(" -N " in " %s " % e for e in events[:at]):
            problems.append("%s before the master login: %r" % (want, events))
        if not (after.startswith("ssh ") and "ControlMaster=no" in after and " -t " in " %s " % after):
            problems.append("%s is not immediately followed by the managed session: %r" % (want, after[:120]))
    else:
        # Immediately before the plain ssh: the user's arguments, or the plain session over the
        # master to a non-POSIX remote.
        plain = after == "ssh -p 22 user@host" or (
            master == "nonposix" and "ControlMaster=no" in after and " -t " in " %s " % after and "WarpTerminal" not in after)
        if not plain:
            problems.append("%s is not immediately followed by the plain ssh: %r" % (want, after[:120]))
    return problems


def owns_master(made):
    """The wrapper used the master it started: one login (ControlMaster=yes), and a session over
    it (ControlMaster=no ... -t) -- not a second `ControlMaster=yes` login."""
    problems = []
    logins = [c for c in made if "ControlMaster=yes" in c]
    if len(logins) != 1:
        problems.append("%d ControlMaster=yes logins, want 1: %r" % (len(logins), logins))
    if not any("ControlMaster=no" in c and " -t " in " %s " % c for c in made):
        problems.append("no session over the master (ControlMaster=no ... -t): %r" % [c[:100] for c in made if "ControlMaster" in c])
    return problems


def run(shell, function, master, isolated, strict="", known_line=None):
    d = tempfile.mkdtemp(prefix="ssh_auth_once_")
    try:
        ssh = os.path.join(d, "ssh")
        open(ssh, "w").write(FAKE_SSH)
        os.chmod(ssh, os.stat(ssh).st_mode | stat.S_IXUSR)
        os.mkdir(os.path.join(d, "socks"))
        # isolated: $HOME is another directory than the passwd home (d); SSH_SOCKET_DIR is the
        # passwd home's absolute directory, as the app exports it (r18u13).
        home = os.path.join(d, "home") if isolated else d
        if isolated:
            os.mkdir(home)
        socks = os.path.join(d, "socks")
        calls = os.path.join(d, "calls")
        events = os.path.join(d, "events")
        if shell == "fish":
            prelude = (
                "function warp_init_shell; end; "
                "function warp_send_json_message; printf 'hook %%s\\n' $argv[1] >> $EVENTS; end; "
                "set -g SSH_SOCKET_DIR '%s'; set -g WARP_SESSION_ID 77;" % socks
            )
            status = "$status"
            argv = [shell, "--no-config", "-c"]
        else:
            prelude = (
                "init_shell_hook(){ :; }; warp_send_json_message(){ printf 'hook %%s\\n' \"$1\" >> \"$EVENTS\"; }; "
                "__warp_hex_encode_to(){ __warp_hex=; }; "
                "SSH_SOCKET_DIR='%s'; WARP_SESSION_ID=77;%s" % (socks, " WARP_IN_MSYS2=true;" if master == "msys2" else "")
            )
            status = "$?"
            argv = [shell, "-c"]
        script = "%s\n%s\nwarp_ssh_helper -p 22 user@host\nexit %s" % (prelude, function, status)
        env = dict(os.environ)
        env["PATH"] = d + ":" + env["PATH"]
        env["HOME"] = home
        env["PWHOME"] = d
        env["CALLS"] = calls
        env["EVENTS"] = events
        env["MASTER"] = master
        env["STRICT"] = strict
        env["KH"] = ""
        if known_line is not None:
            kh = os.path.join(d, "known_hosts")
            open(kh, "w").write(known_line)
            env["KH"] = kh
        r = subprocess.run(argv + [script], env=env, capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=60)
        made = open(calls).read().splitlines() if os.path.exists(calls) else []
        logged = open(events).read().splitlines() if os.path.exists(events) else []
        return r.returncode, made, logged, r.stdout, r.stderr
    finally:
        shutil.rmtree(d)


def main():
    failures = 0
    ran = 0
    for shell, fname, start, end in SHELLS:
        if not shutil.which(shell):
            print("SKIPPED %s (not installed)" % shell)
            continue
        text = open(os.path.join(BOOT, fname)).read()
        a = text.index(start)
        function = text[a : a + text[a:].index(end)]
        for master, isolated, want_rc, want_calls, want_err, verdict in CASES:
            if master == "msys2" and shell != "bash":
                continue  # only bash_body.sh has the Git Bash / MSYS2 branch (#1551)
            ran += 1
            rc, made, logged, out, err = run(shell, function, master, isolated)
            problems = []
            if rc != want_rc:
                problems.append("status %d, want %d" % (rc, want_rc))
            if want_calls is None:
                problems += owns_master(made)
            elif len(made) != want_calls:
                problems.append("%d connecting ssh calls, want %d" % (len(made), want_calls))
            elif want_calls == 2 and made[1] != "-p 22 user@host":
                problems.append("fallback ssh must carry exactly the user's arguments: %r" % made[1])
            plain_first = master in ("remotecommand", "msys2")
            if not plain_first and (not made or " -N " not in " %s " % made[0]):
                problems.append("first call is not the master: %r" % made[:1])
            if plain_first and made != ["-p 22 user@host"]:
                problems.append("only the user's plain ssh may run: %r" % made)
            if master == "nonposix" and not any("ControlMaster=no" in c and " -t " in " %s " % c and "WarpTerminal" not in c for c in made):
                problems.append("no plain session over the master to the non-POSIX remote: %r" % [c[:100] for c in made])
            problems += verdict_problems(master, verdict, logged)
            if err != want_err or out:
                problems.append("output changed: stdout %r stderr %r" % (out, err))
            label = master + (" ($HOME is not the passwd home)" if isolated else "")
            print("%s %s: %s" % ("FAIL" if problems else "ok  ", shell, label))
            for p in problems:
                print("     " + p)
            failures += bool(problems)
        # #1641 host-key retry. A real known_hosts line needs ssh-keygen (the wrapper's own lookup).
        if not shutil.which("ssh-keygen"):
            print("SKIPPED %s host-key cases (ssh-keygen not installed)" % shell)
            continue
        k = tempfile.mkdtemp(prefix="ssh_auth_once_key_")
        try:
            subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", os.path.join(k, "id")],
                           check=True, capture_output=True, timeout=60)
            pub = open(os.path.join(k, "id.pub")).read().split()
        finally:
            shutil.rmtree(k)
        for master, strict, known, want_rc, want_calls, want_err, verdict, overridden in HOSTKEY_CASES:
            ran += 1
            line = "%s %s %s\n" % ("h" if known else "other-host", pub[0], pub[1])
            rc, made, logged, out, err = run(shell, function, master, False, strict, line)
            problems = []
            if rc != want_rc:
                problems.append("status %d, want %d" % (rc, want_rc))
            if want_calls is None:
                problems += owns_master(made)
            elif len(made) != want_calls:
                problems.append("%d connecting ssh calls, want %d: %r" % (len(made), want_calls, [c[:90] for c in made]))
            elif want_calls == 2 and made[1] != "-p 22 user@host":
                problems.append("the retry must be the user's plain ssh, exactly their arguments: %r" % made[1])
            if not made or " -N " not in " %s " % made[0]:
                problems.append("first call is not the master: %r" % made[:1])
            elif ("StrictHostKeyChecking=yes" in made[0]) != overridden:
                problems.append("master %s carry StrictHostKeyChecking=yes: %r" % ("must" if overridden else "must NOT", made[0][:120]))
            if any("StrictHostKeyChecking" in c for c in made[1:]):
                problems.append("only the master may carry the strict override: %r" % made[1:])
            if err != want_err or out:
                problems.append("output changed: stdout %r stderr %r" % (out, err))
            problems += verdict_problems(master, verdict, logged)
            label = "host key: %s, %s, %s" % (master, strict, "known" if known else "unknown")
            print("%s %s: %s" % ("FAIL" if problems else "ok  ", shell, label))
            for p in problems:
                print("     " + p)
            failures += bool(problems)
    if ran == 0:
        print("SKIPPED: no shell available")
    sys.exit(1 if failures else 0)


main()
