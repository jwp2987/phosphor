#!/usr/bin/env python3
"""#1171: the ssh wrapper adds ServerAliveInterval=30 / ServerAliveCountMax=6
ONLY when `ssh -G` reports `serveraliveinterval 0`, and only while
WARP_SSH_KEEPALIVE is not "0".

It extracts the real probe block (from `warp_ssh_g` up to the keepalive `fi`)
out of bash_body.sh, zsh_body.sh and fish.sh, runs it with a fake `ssh -G` on
PATH, and checks the resulting option array. Shells that are not installed are
skipped. Also checks the single-`ssh -G` rule: the block must fork `ssh` once.

Usage: script/test_ssh_keepalive
"""
import os
import shutil
import stat
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BOOT = os.path.join(ROOT, "app/assets/bundled/bootstrap")

FAKE_SSH = """#!/bin/sh
echo x >> "$FAKE_SSH_COUNT"
[ "$1" = "-G" ] || exit 0
printf '%s\\n' "$FAKE_G"
"""

KEEPALIVE = ["-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=6"]
IPQOS = ["-o", "IPQoS=af21 af21"]


def extract(path, start_marker, end_marker):
    lines = open(path).read().split("\n")
    start = next(i for i, l in enumerate(lines) if start_marker in l)
    end = next(
        i for i, l in enumerate(lines) if i > start and end_marker in l
    )
    # include the closing `fi` / `end` line after the marker line
    return "\n".join(lines[start : end + 3])


def run(shell, snippet_kind, snippet, g, env_extra):
    d = tempfile.mkdtemp(prefix="ssh_keepalive_")
    try:
        ssh = os.path.join(d, "ssh")
        open(ssh, "w").write(FAKE_SSH)
        os.chmod(ssh, os.stat(ssh).st_mode | stat.S_IXUSR)
        count = os.path.join(d, "count")
        open(count, "w").close()
        if snippet_kind == "fish":
            prog = "function t\n%s\nfor a in $warp_ipqos_args; echo $a; end\nend\nt dest\n" % snippet
        else:
            prog = "t() {\n%s\nprintf '%%s\\n' \"${warp_ipqos_args[@]}\"\n}\nt dest\n" % snippet
        env = dict(os.environ)
        env.pop("WARP_SSH_KEEPALIVE", None)
        env.update(env_extra)
        env["PATH"] = d + ":" + env["PATH"]
        env["FAKE_G"] = g
        env["FAKE_SSH_COUNT"] = count
        r = subprocess.run([shell, "-c", prog], env=env, capture_output=True, text=True)
        if r.returncode != 0:
            raise SystemExit("%s failed: %s\n%s" % (shell, r.stderr, prog))
        calls = len(open(count).read().split())
        return [l for l in r.stdout.split("\n") if l], calls
    finally:
        shutil.rmtree(d)


CASES = [
    # (name, ssh -G output, env, expected args)
    ("default interval 0 -> keepalive", "host dest\nserveraliveinterval 0\nipqos af21 cs1", {}, IPQOS + KEEPALIVE),
    ("interval 0, ipqos user-set", "serveraliveinterval 0\nipqos lowdelay", {}, KEEPALIVE),
    ("user interval wins", "serveraliveinterval 60\nipqos lowdelay", {}, []),
    ("user interval 5 wins", "serveraliveinterval 5\nipqos af21 cs1", {}, IPQOS),
    ("not a prefix match", "serveraliveinterval 0x\nserveraliveintervalx 0", {}, []),
    ("opt out", "serveraliveinterval 0\nipqos lowdelay", {"WARP_SSH_KEEPALIVE": "0"}, []),
    ("explicit on", "serveraliveinterval 0\nipqos lowdelay", {"WARP_SSH_KEEPALIVE": "1"}, KEEPALIVE),
    ("ssh -G printed nothing", "", {}, []),
]

SHELLS = [
    ("bash", "bash_body.sh", "bash"),
    ("zsh", "zsh_body.sh", "bash"),
    ("fish", "fish.sh", "fish"),
]


def main():
    failures = 0
    ran = 0
    for shell, fname, kind in SHELLS:
        if not shutil.which(shell):
            print("SKIP %s (not installed)" % shell)
            continue
        path = os.path.join(BOOT, fname)
        # Fish gets its own `end` terminator; the others close with `fi`.
        snippet = extract(path, "warp_ssh_g", "-o ServerAliveInterval=30")
        for name, g, env, want in CASES:
            got, calls = run(shell, kind, snippet, g, env)
            ran += 1
            ok = got == want and calls == 1
            print("%s %s: %s" % ("ok  " if ok else "FAIL", shell, name))
            if not ok:
                failures += 1
                print("     want %r, got %r, ssh calls %d" % (want, got, calls))
    if ran == 0:
        raise SystemExit("no shell available")
    sys.exit(1 if failures else 0)


main()
