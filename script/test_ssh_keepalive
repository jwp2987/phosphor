#!/usr/bin/env python3
"""#1171: the ssh wrapper adds ServerAliveInterval=30 / ServerAliveCountMax=6
ONLY when `ssh -G` reports `serveraliveinterval 0`, and only while
WARP_SSH_KEEPALIVE is not "0". #1243: it adds ObscureKeystrokeTiming=no ONLY
when WARP_SSH_OBSCURE_KEYSTROKE_TIMING is "0" AND `ssh -G` reports
`obscurekeystroketiming yes`.

It extracts the real `ssh -G` capture and the probe block (from the
`warp_ipqos_args` declaration up to the obscure-timing `fi`) out of bash_body.sh,
zsh_body.sh and fish.sh, runs them with a fake `ssh -G` on PATH, and checks the
resulting option array. Shells that are not installed are skipped. Also checks
the single-`ssh -G` rule (#1172): the extracted code forks `ssh` once, and the
whole wrapper function body contains exactly one `ssh -G` capture.

Usage: script/test_ssh_keepalive
"""
import os
import shutil
import stat
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BOOT = os.path.join(ROOT, "app/assets/bundled/bootstrap")

FAKE_SSH = """#!/bin/sh
echo x >> "$FAKE_SSH_COUNT"
[ "$1" = "-G" ] || exit 0
printf '%s\\n' "$FAKE_G"
"""

KEEPALIVE = ["-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=6"]
IPQOS = ["-o", "IPQoS=af21 af21"]
NO_OBSCURE = ["-o", "ObscureKeystrokeTiming=no"]
OBSCURE_OFF = {"WARP_SSH_OBSCURE_KEYSTROKE_TIMING": "0"}


def extract(path, start_marker, end_marker):
    lines = open(path).read().split("\n")
    start = next(i for i, l in enumerate(lines) if start_marker in l)
    end = next(
        i for i, l in enumerate(lines) if i > start and end_marker in l
    )
    # include the closing `fi` / `end` line after the marker line
    return "\n".join(lines[start : end + 3])


def run(shell, snippet_kind, snippet, g, env_extra):
    d = tempfile.mkdtemp(prefix="ssh_keepalive_")
    try:
        ssh = os.path.join(d, "ssh")
        open(ssh, "w").write(FAKE_SSH)
        os.chmod(ssh, os.stat(ssh).st_mode | stat.S_IXUSR)
        count = os.path.join(d, "count")
        open(count, "w").close()
        if snippet_kind == "fish":
            prog = "function t\n%s\nfor a in $warp_ipqos_args; echo $a; end\nend\nt dest\n" % snippet
        else:
            prog = "t() {\n%s\nprintf '%%s\\n' \"${warp_ipqos_args[@]}\"\n}\nt dest\n" % snippet
        env = dict(os.environ)
        env.pop("WARP_SSH_KEEPALIVE", None)
        env.pop("WARP_SSH_OBSCURE_KEYSTROKE_TIMING", None)
        env.update(env_extra)
        env["PATH"] = d + ":" + env["PATH"]
        env["FAKE_G"] = g
        env["FAKE_SSH_COUNT"] = count
        r = subprocess.run([shell, "-c", prog], env=env, capture_output=True, text=True)
        if r.returncode != 0:
            raise SystemExit("%s failed: %s\n%s" % (shell, r.stderr, prog))
        calls = len(open(count).read().split())
        return [l for l in r.stdout.split("\n") if l], calls
    finally:
        shutil.rmtree(d)


CASES = [
    # (name, ssh -G output, env, expected args)
    ("default interval 0 -> keepalive", "host dest\nserveraliveinterval 0\nipqos af21 cs1", {}, IPQOS + KEEPALIVE),
    ("interval 0, ipqos user-set", "serveraliveinterval 0\nipqos lowdelay", {}, KEEPALIVE),
    ("user interval wins", "serveraliveinterval 60\nipqos lowdelay", {}, []),
    ("user interval 5 wins", "serveraliveinterval 5\nipqos af21 cs1", {}, IPQOS),
    ("not a prefix match", "serveraliveinterval 0x\nserveraliveintervalx 0", {}, []),
    ("opt out", "serveraliveinterval 0\nipqos lowdelay", {"WARP_SSH_KEEPALIVE": "0"}, []),
    ("explicit on", "serveraliveinterval 0\nipqos lowdelay", {"WARP_SSH_KEEPALIVE": "1"}, KEEPALIVE),
    ("ssh -G printed nothing", "", {}, []),
    # #1243
    ("obscure default kept", "serveraliveinterval 60\nobscurekeystroketiming yes", {}, []),
    ("obscure off by setting", "serveraliveinterval 60\nobscurekeystroketiming yes", OBSCURE_OFF, NO_OBSCURE),
    ("obscure user-set wins", "serveraliveinterval 60\nobscurekeystroketiming no", OBSCURE_OFF, []),
    ("obscure unknown to this ssh", "serveraliveinterval 60", OBSCURE_OFF, []),
    ("obscure off with keepalive", "serveraliveinterval 0\nobscurekeystroketiming yes", OBSCURE_OFF, KEEPALIVE + NO_OBSCURE),
    ("obscure explicit on", "serveraliveinterval 60\nobscurekeystroketiming yes", {"WARP_SSH_OBSCURE_KEYSTROKE_TIMING": "1"}, []),
]

# (shell, file, kind, capture line marker, probe block start marker)
SHELLS = [
    ("bash", "bash_body.sh", "bash", "warp_ssh_g=\"$(command ssh -G", "local warp_ipqos_args"),
    ("zsh", "zsh_body.sh", "bash", "warp_ssh_g=\"$(command ssh -G", "local -a warp_ipqos_args"),
    ("fish", "fish.sh", "fish", "set -l warp_ssh_g (command ssh -G", "set -l warp_ipqos_args"),
]


def helper_body(path):
    """The text of warp_ssh_helper (bash/zsh) / warp_ssh_helper (fish) up to the next function."""
    text = open(path).read()
    start = text.index("function warp_ssh_helper")
    end = text.index("function warp_ssh_remote_is_non_posix", start)
    return text[start:end]


def main():
    failures = 0
    ran = 0
    for shell, fname, kind, cap_marker, block_marker in SHELLS:
        path = os.path.join(BOOT, fname)
        # Comments mention `ssh -G` too, so count only executed captures.
        n_exec = sum(
            1
            for l in helper_body(path).split("\n")
            if "ssh -G" in l and not l.lstrip().startswith("#")
        )
        ran += 1
        if n_exec != 1:
            failures += 1
            print("FAIL %s: warp_ssh_helper runs `ssh -G` %d times, want 1" % (shell, n_exec))
        else:
            print("ok   %s: warp_ssh_helper runs `ssh -G` once" % shell)
        if not shutil.which(shell):
            print("SKIP %s (not installed)" % shell)
            continue
        # Fish gets its own `end` terminator; the others close with `fi`.
        cap_line = next(
            l.strip() for l in open(path).read().split("\n") if cap_marker in l
        )
        snippet = cap_line + "\n" + extract(path, block_marker, "-o ObscureKeystrokeTiming=no")
        for name, g, env, want in CASES:
            got, calls = run(shell, kind, snippet, g, env)
            ran += 1
            ok = got == want and calls == 1
            print("%s %s: %s" % ("ok  " if ok else "FAIL", shell, name))
            if not ok:
                failures += 1
                print("     want %r, got %r, ssh calls %d" % (want, got, calls))
    if ran == 0:
        raise SystemExit("no shell available")
    sys.exit(1 if failures else 0)


main()
