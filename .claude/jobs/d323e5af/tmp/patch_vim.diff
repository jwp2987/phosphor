+                    let end_point = end.to_buffer_point(buffer);
+                    if end_point.column != 0 {
+                        end = Point::new(end_point.row, buffer.line_len(end_point.row))
+                            .to_buffer_char_offset(buffer);
+                    }
+                }
+
+                start..end
+            })
+            .collect()
