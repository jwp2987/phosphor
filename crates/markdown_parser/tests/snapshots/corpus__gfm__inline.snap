---
source: crates/markdown_parser/tests/corpus.rs
expression: render(parse_markdown_with_gfm_tables(&text))
---
FormattedText {
    lines: [
        Line(
            [
                FormattedTextFragment {
                    text: "Plain with ",
                    styles: PlainText,
                },
                FormattedTextFragment {
