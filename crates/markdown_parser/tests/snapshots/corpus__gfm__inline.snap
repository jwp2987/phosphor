                    styles: PlainText,
                },
                FormattedTextFragment {
                    text: "double `tick` code",
                    styles: InlineCode,
                },
                FormattedTextFragment {
                    text: " here.",
                    styles: PlainText,
                },
            ],
        ),
        LineBreak,
        Line(
            [
                FormattedTextFragment {
                    text: "bold",
