###############################################################################
# Package Spec
###############################################################################

Summary:     Phosphor, a community fork of the Rust-based Warp terminal
Name:        @@PACKAGE_NAME@@
Version:     @@VERSION@@
Release:     @@RELEASE@@
Vendor:      Phosphor Maintainers
Url:         https://github.com/jwp2987/phosphor
Packager:    Phosphor Maintainers <phosphor-maintainers@localhost>
License:     AGPL-3.0-only AND MIT
Obsoletes:   zap < %{version}
Provides:    zap = %{version}

Requires: 	 xdg-utils, (libvulkan.so.1()(64bit) or libEGL.so.1()(64bit)), (libwayland-egl.so.1()(64bit) if (libwayland-client.so.0()(64bit) and libEGL.so.1()(64bit))), libxcb.so.1()(64bit), libxkbcommon-x11.so.0()(64bit), libX11.so.6()(64bit), libX11-xcb.so.1()(64bit), libXcursor.so.1()(64bit), libXi.so.6()(64bit)
Recommends:  libgallium_dri.so()(64bit), adwaita-icon-theme


# The prefix specifies where the majority of the application files are,
# allowing the package to be relocatable.
prefix:      /opt

# We're not including debug info, so don't register the build ID with the
# machine's registry of build IDs.
%define _build_id_links none

###############################################################################
# Description
###############################################################################

%description
Phosphor is a community fork of the Rust-based Warp terminal that strips the
mandatory cloud dependency, opens up the AI provider layer, ships a built-in
SSH host manager, and lets you plug in any third-party CLI agent. All
credentials, conversations and agent history stay on your machine.

###############################################################################
# Build rule - how does the package get built?
###############################################################################
%build

# Nothing to do here - the application should have already been built before we
# attempt to package it.

###############################################################################
# Install rule - where should the files live, post-install?
###############################################################################
%install

# Populate the buildroot directory with the package contents, in the
# appropriate locations.
mkdir -p %{buildroot}
OPT_DIR="@@OPT_DIR@@" @@WORKSPACEROOT@@/script/linux/bundle_install %{buildroot}

# The user-facing launch command is `phosphor` — a symlink to the installed
# @@BINARY_NAME@@ binary, never the binary itself. %{name} is the package
# name (also `phosphor` after the zap->phosphor rename; see the
# Obsoletes/Provides above), which is a distinct concept from the symlink
# target even though the strings now coincide.
mkdir -p %{buildroot}%{_bindir}
ln -s @@OPT_DIR@@/@@BINARY_NAME@@ %{buildroot}%{_bindir}/phosphor

###############################################################################
# Files listing - what files will end up in the package?
###############################################################################
%files

# Most things go into this directory.
@@OPT_DIR@@

# We also install a few things elsewhere in the system.
%{_bindir}/phosphor
%{_datadir}/applications/@@BUNDLEID@@.desktop
%{_datadir}/icons/hicolor

###############################################################################
# Post-install rule - what do we need to do on the user's machine to complete
#                     installation?
###############################################################################
%post

# Phosphor does not configure the upstream Warp RPM repo, nor does it install the upstream signing key.
# Make sure the system incorporates the newly-installed desktop file.
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Phosphor does no post-install repo configuration; deb/rpm packages are distributed via GitHub Release.
exit 0
