[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Phosphor
GenericName=TerminalEmulator

# `zap` is a symlink to /opt/zap/zap-oss in deb/rpm packages, and a
# /usr/bin/zap wrapper script in arch packages — all three are directly
# callable from PATH.
# When packaged as an AppImage, bundle_appimage uses sed to replace this line
# with `Exec=zap-oss %U`, pointing directly at the binary inside the AppImage.
Exec=zap %U
StartupWMClass=dev.zap.Zap

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.zap.Zap

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for zap:// URLs.
MimeType=x-scheme-handler/zap;
